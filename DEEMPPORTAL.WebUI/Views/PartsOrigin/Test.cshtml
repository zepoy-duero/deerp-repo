@model DEEMPPORTAL.Domain.PartsOrigin.PartsOrgViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Update Part Number Origin";
}

<style>
    .panel-card {
        background: #ffffff;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 0 15px rgba(0,0,0,0.05);
        height: 100%;
    }

    .section-title {
        font-size: .8rem;
        text-transform: uppercase;
        letter-spacing: .5px;
        font-weight: 600;
        color: #6c757d;
        margin-bottom: 15px;
    }

    .sortable {
        cursor: pointer;
    }

        .sortable:after {
            content: " ⇅";
            font-size: 12px;
            color: #999;
        }

    #loadingSpinner {
        display: none;
    }
</style>

<div class="container">
    <div class="page-inner">
        <!-- PAGE TITLE -->
        <div class="page-title d-flex justify-content-between align-items-center mb-3">

            <h5 class="fw-bold mb-0">
                Products - Part Origin / HS Code
            </h5>

            <a class="small text-decoration-underline"
               asp-controller="SingleRecordUpdate"
               asp-action="Index">

                Switch to single part update
                <i class="bi bi-code-compare"></i>
            </a>

        </div>

        <div class="row g-4">

            <!-- LEFT PANEL -->
            <div class="col-12 col-lg-4">

                <div class="panel-card">

                    <div class="section-title">Upload Excel</div>

                    <div class="row g-3">

                        <div class="col-12">
                            <label class="form-label fw-semibold">Organization</label>
                            <select id="ddlOrg"
                                    class="form-select form-select-sm"
                                    asp-for="SelectedOrganization"
                                    asp-items="Model.Organizations">
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Supplier</label>
                            <select id="ddlSupplier"
                                    class="form-select form-select-sm"
                                    @(Model.Suppliers.Count == 0 ? "disabled" : "")>

                                @foreach (var s in Model.Suppliers)
                                {
                                    <option value="@s.Value">@s.Text</option>
                                }

                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Excel File (.xlsx)</label>
                            <input id="fileUpload"
                                   type="file"
                                   class="form-control form-control-sm">
                        </div>

                        <div class="col-12 d-flex gap-2">
                            <button id="btnProcess"
                                    class="btn btn-danger btn-sm">

                                <span id="loadingSpinner"
                                      class="spinner-border spinner-border-sm me-2"></span>

                                Process File
                            </button>

                            <button id="btnClear"
                                    class="btn btn-outline-secondary btn-sm">

                                Clear
                            </button>
                        </div>

                        <!-- PROGRESS BAR -->
                        <div class="col-12">

                            <div class="progress d-none"
                                 style="height:18px"
                                 id="uploadProgressWrapper">

                                <div id="uploadProgressBar"
                                     class="progress-bar progress-bar-striped progress-bar-animated"
                                     style="width:0%">

                                    0%

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- RIGHT PANEL -->
            <div class="col-12 col-lg-8">

                <div class="panel-card p-0">

                    <div class="table-responsive"
                         style="max-height:500px">

                        <table class="table table-sm table-hover mb-0">

                            <thead class="table-light sticky-top">

                                <tr>
                                    <th class="sortable text-nowrap">Supplier</th>
                                    <th class="sortable text-nowrap">Invoice No</th>
                                    <th class="sortable text-nowrap">Part No</th>
                                    <th class="sortable text-nowrap">Description</th>
                                    <th class="sortable text-nowrap">Origin</th>
                                    <th class="sortable text-nowrap">HS Code</th>
                                </tr>

                            </thead>

                            <tbody id="tblBody">

                                @{
                                    await Html.RenderPartialAsync("~/Views/PartsOrigin/_EmptyTable.cshtml");
                                }

                            </tbody>

                        </table>

                    </div>

                    <div class="border-top p-3 text-center">

                        <button id="btnUpdate"
                                class="btn btn-danger px-5">

                            Update Origin / HS Code

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>
</div>

@section Scripts {
    <script src="/js/parts-origin/parts-origin.js" asp-append-version="true"></script>
}