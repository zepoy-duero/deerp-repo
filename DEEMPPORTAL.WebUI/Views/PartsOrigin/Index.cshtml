@model DEEMPPORTAL.Domain.PartsOrigin.PartsOrgViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Update Part Number Origin";
}
<style>
    .form-label {
        margin-bottom: 0px !important;
    }

    /* adjust 0px–6px */
</style>
<div class="container">
    <div class="page-inner" id="pageInner" style="height: 100% !important; overflow:auto">
        <div class="flex-column">
            <!-- Title -->
            @* <h5 class="page-title mb-3 fs-5 fw-bolder text-main">
                Products Origin / HS Code
            </h5> *@
            <div class="page-title d-flex justify-content-between align-items-center mb-3">

                <h5 class="fw-bold mb-0">
                    Products - Part Origin / HS Code
                </h5>

                <a class="small text-decoration-underline"
                   asp-controller="SingleRecordUpdate"
                   asp-action="Index">

                    Switch to single part update
                    <i class="bi bi-code-compare"></i>
                </a>

            </div>
            <div class="card shadow-sm">
                <div class="card-header text-white  bg-main-gradient rounded-top-1">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="text-center w-100">
                            Update Multi-Part Number Origin/HS Code
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-3 align-items-end">
                        <div class="row g-2">
                            <!--LABEL ROW (all labels aligned in one row) -->
                            @* <div class="col-md-4">
                            </div>

                            <div class="col-md-4">
                               
                            </div>

                            <div class="col-md-4">
                            </div> *@

                            <!-- INPUT ROW (all inputs aligned in one row) -->
                            <div class="col-md-4">
                                <label for="ddOrg" class="form-label">Select Organization</label>

                                <select id="ddlOrg" class="form-select"
                                        asp-for="SelectedOrganization"
                                        asp-items="Model.Organizations">
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label for="ddlSupplier" class="form-label">Select Supplier</label>
                                <select id="ddlSupplier" class="form-select" @(Model.Suppliers.Count == 0 ? "disabled" : "")>
                                    @foreach (var s in Model.Suppliers)
                                    {
                                        <option value="@s.Value">@s.Text</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label for="fileUpload" class="form-label mb-1">Upload File</label>

                                <input id="fileUpload"
                                       type="file"
                                       class="form-control" />

                                <small class="text-small text-muted">
                                    Your file format should be <b>.xlsx</b>
                                </small>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4">

                        <div class="d-flex justify-content-center align-items-center">
                            @* <a class="btn btn-danger" asp-controller="SingleRecordUpdate" asp-action="Index"> Single Update Parts </a> *@
                            <button id="btnProcess" class="btn rounded-2 btn-danger px-4 me-2">Process</button>
                            <button id="btnClear" type="button" class="btn rounded-2 btn-outline-secondary px-4 me-2">Clear</button>
                      
                           
                        </div>
                        <div class="d-flex justify-content-center align-items-center">
                            <!-- Progress Bar -->
                            <div id="processInfo" style="display:none; margin-top:10px; font-size:13px; color:#555;">
                                Records: <b id="processCount">Processing...</b>
                                &nbsp; | &nbsp;
                                Time: <b id="processTime">00:00</b>
                            </div>
                        </div>
                    </div>
                    <div id="msgSuccess" class="alert alert-success fw-bold mt-3 d-none"></div>
                    <div id="msgError" class="alert alert-danger fw-bold mt-3 d-none"></div>
                    <div class="mt-4">
                        <div class="fw-bold">
                            Total No of Records: <span id="lblTotal">0</span>
                        </div>
                    </div>

                    <div class="overflow-auto" style="max-height: 300px">

                        <table class="table table-sm table-striped table-hover align-middle">

                            <thead class="sticky-top bg-dard table-white">
                                <tr class="text-muted">
                                    <th>Supplier</th>
                                    <th>Invoice No</th>
                                    <th>Part No</th>
                                    <th>Description</th>
                                    <th>Weight</th>
                                    <th>Origin</th>
                                    <th>HS Code</th>
                                </tr>
                            </thead>
                            <tbody id="tblBody">
                                <tr>
                                    <td colspan="12" class="text-center text-muted">No data</td>
                                </tr>
                            </tbody>
                        </table>

                    </div>
                    <div class="text-center mt-3">
                        <button id="btnUpdate" type="button" class="btn btn-danger rounded-2" disabled>
                            Update Origin / HS Code
                        </button>
                    </div>

                    <div id="msg" class="text-danger fw-semibold"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script>
        let defaultOrg = $("#ddlOrg").val();
        $(function () {


            let processedRows = []; // IMPORTANT

        let processTimer;
        let processStart;

        function startProcessInfo() {
            clearInterval(processTimer);

            processStart = new Date();

            $("#processInfo").show();
            $("#processCount").text("Processing...");
            $("#processTime").text("00:00");

            processTimer = setInterval(function () {
                const seconds = Math.floor((new Date() - processStart) / 1000);
                const mm = String(Math.floor(seconds / 60)).padStart(2, "0");
                const ss = String(seconds % 60).padStart(2, "0");

                $("#processTime").text(mm + ":" + ss);
            }, 1000);
        }

        function stopProcessInfo(countText) {
            clearInterval(processTimer);
            $("#processCount").text(countText);
        }

        function clearProcessInfo() {
            clearInterval(processTimer);
            $("#processInfo").hide();
            $("#processCount").text("Processing...");
            $("#processTime").text("00:00");
        }

            function setUpdateButtonState() {
            const hasData = processedRows && processedRows.length > 0;
            $("#btnUpdate").prop("disabled", !hasData);
        }
            function clearGrid() {
                $("#lblTotal").text("0");
                $("#tblBody").html('<tr><td colspan="12" class="text-center text-muted">No data</td></tr>');
                processedRows = []; //  clear stored rows too
                setUpdateButtonState();
            }

            function showError(text) {
                $("#msgError").removeClass("d-none").text(text || "");
                $("#msgSuccess").addClass("d-none").text("");
            }

            function showSuccess(text) {
                $("#msgSuccess").removeClass("d-none").text(text || "");
                $("#msgError").addClass("d-none").text("");
            }

            function clearFile() {
                $("#fileUpload").val("");
            }

            // On org change -> load suppliers + clear file + clear grid
            $("#ddlOrg").on("change", function () {
                clearGrid();
                $("#msgError").addClass("d-none").text("");
                $("#msgSuccess").addClass("d-none").text("");
                clearFile();

                const orgCode = $(this).val();

                // if (!orgCode) {
                //     $("#ddlSupplier").prop("disabled", true).html('<option value="">-- Select --</option>');
                //     return;
                // }

                $.get(`parts-origin/get-supplier-by-org`, { orgCode: orgCode })
                    .done(function (data) {
                        let html = "";
                        data.forEach(function (x) {
                            html += `<option value="${x.value}">${x.text}</option>`;
                        });

                        $("#ddlSupplier").html(html).prop("disabled", false);

                        if (data.length > 0) {
                            $("#ddlSupplier").val(data[0].value);
                        }

                        clearFile();
                    })
                    .fail(function () {
                        showError("Failed to load suppliers.");
                    });
            });

            // Supplier change -> clear file + grid
            $("#ddlSupplier").on("change", function () {
                clearGrid();
                $("#msgError").addClass("d-none").text("");
                $("#msgSuccess").addClass("d-none").text("");
                clearFile();
            });

                   // When choosing file -> clear grid + validate extension
        $("#fileUpload").on("change", function () {

            clearGrid();
            $("#msgError").addClass("d-none").text("");
            $("#msgSuccess").addClass("d-none").text("");

            $("#fileError").addClass("d-none").text("");

            const file = this.files && this.files[0];
            if (!file) return;

            const fileName = (file.name || "").toLowerCase();
            const isXlsx = fileName.endsWith(".xlsx") || fileName.endsWith(".xls");

            if (!isXlsx) {
            $("#msgError")
                .removeClass("d-none")
                .text("File must be an Excel (.xlsx) file.");


            return;
        }
          clearGrid();
        });

            // Process click -> AJAX upload
            $("#btnProcess").on("click", function (e) {
                e.preventDefault();

                $("#msgError").addClass("d-none").text("");
                $("#msgSuccess").addClass("d-none").text("");

                const orgCode = $("#ddlOrg").val();
                const supCode = $("#ddlSupplier").val();
                const supName = $("#ddlSupplier option:selected").text();
                const file = $("#fileUpload")[0].files[0];

                if (!orgCode) return showError("Please select Organization.");
                if (!supCode) return showError("Please select Supplier.");
                if (!file) return showError("Please choose a file.");

                const fd = new FormData();
                fd.append("orgCode", orgCode);
                fd.append("supCode", supCode);
                fd.append("supName", supName);
                fd.append("uploadFile", file);

                $("#btnProcess").prop("disabled", true).text("Processing...");
                startProcessInfo();

                $.ajax({
                    url: "parts-origin/process-file",
                    type: "POST",
                    data: fd,
                    processData: false,
                    contentType: false
                })
                .done(function (res) {

                    processedRows = res.data || []; //FIXED (correct name)

                    $("#lblTotal").text(res.total || 0);
                    setUpdateButtonState();
                    stopProcessInfo(res.total || processedRows.length || 0);
                    if (!processedRows.length) {
                        clearGrid();
                        return;
                    }

                    let rowsHtml = "";

                    processedRows.forEach(function (r) {
                        rowsHtml += `
                            <tr>
                                <td>${r.Supplier ?? ""}</td>
                                <td>${r.InvoiceNo ?? ""}</td>
                                <td>${r.PartNo ?? ""}</td>
                                <td>${r.Description ?? ""}</td>
                                <td>${r.Weight ?? ""}</td>
                                <td>${r.Origin ?? ""}</td>
                                <td>${r.HSCode ?? ""}</td>
                            </tr>
                        `;
                    });

                    $("#tblBody").html(rowsHtml);
                    setUpdateButtonState();
                })
                .fail(function (xhr) {
                    stopProcessInfo("Failed");
                    showError(xhr.responseText || "Error while processing file.");
                    clearGrid();
                })
                .always(function () {
                    $("#btnProcess").prop("disabled", false).text("Process");
                });
            });

                  // UPDATE button
        $("#btnUpdate").on("click", function () {

            $("#msgError").addClass("d-none").text("");
            $("#msgSuccess").addClass("d-none").text("");

            const orgCode = parseInt($("#ddlOrg").val() || "0");
            const supCode = $("#ddlSupplier").val();

            if (!orgCode) return showError("Please select Organization.");
            if (!supCode) return showError("Please select Supplier.");
            if (!processedRows || processedRows.length === 0) return showError("No records to insert. Please click Process first.");

            //block insert if ANY row has empty required fields
            const hasInvalid = processedRows.some(r =>
                !r.PartNo || r.PartNo.toString().trim() === "" ||
                !r.Origin || r.Origin.toString().trim() === "" ||
                !r.HSCode || r.HSCode.toString().trim() === ""
            );

            if (hasInvalid) {
                return showError("No data to be inserted because Part No / Origin / HS Code has empty value.");
            }

            $("#btnUpdate").prop("disabled", true).text("Updating...");

            $.ajax({
                url: "parts-origin/update-hscode",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify({ OrgCode: orgCode,SupCode: supCode, Rows: processedRows }) //send all rows
            })
            .done(function (res) {
                showSuccess(`Successfully inserted ${res.inserted} records.`);
            })
            .fail(function (xhr) {
                showError(xhr.responseText || "Insert failed.");
            })
            .always(function () {
                $("#btnUpdate").text("Update Origin / HS Code");
                setUpdateButtonState();
            });
        });


            // trigger after handlers are attached

            $("#ddlOrg").trigger("change");
        });
            $("#btnClear").on("click", function () {

                // clear process info
               if (typeof processTimer !== "undefined") {
                   clearInterval(processTimer);
               }
               $("#processInfo").hide();
               $("#processCount").text("Processing...");
               $("#processTime").text("00:00");
            // hide messages
            $("#msgError").addClass("d-none").text("");
            $("#msgSuccess").addClass("d-none").text("");

            // clear file + grid + stored rows
            $("#fileUpload").val("");
            $("#lblTotal").text("0");
            $("#tblBody").html('<tr><td colspan="6" class="text-center text-muted">No data</td></tr>');
            processedRows = [];
             if (typeof setUpdateButtonState === "function") {
            setUpdateButtonState();
            }
            // set org back to default and reload suppliers
            $("#ddlOrg").val(defaultOrg).trigger("change");
        });

    </script>
}
