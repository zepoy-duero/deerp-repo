     window.statusFormatter = (value, row) => {
         if(value != null){
    return `<div class='${statusColor(value)} text-nowrap'>${value}</div>`
         }

     }
     window.subjectFormatter = (value, row) => {

         let el = `<div class="d-inline-block text-truncate" style="max-width: 150px !important;" title="${value}">
          ${value}
        </div>`

         return el;
     }
     window.requestedByFormatter = (value, row) => {

         let el = `<div class="d-inline-block text-truncate" style="max-width: 100px !important;" title="${value}">
          ${value}
        </div>`

         return el;
     }
     window.dateFormatter = (value, row) => {
         if(value !== undefined && value !== null){
             var d = moment(value).format("DD-MM-YYYY hh:mm")
             return d;
         }
         
     }
       window.ticketCorrBtn = (value, row) => {
         if(value !== undefined && value !== null){
               var d = `<button data-ticket-id='${value}' id='openTicketCorrBtn' type='button' class="btn btn-danger btn-md rounded-circle shadow-lg d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; pointer-events: auto;" data-bs-toggle="modal" data-bs-target="#correspondenceListModal" aria-label="Open ticket correspondence">
              <i class="bi bi-chat-dots-fill fs-6"></i>
          </button>`;
             return d;
         }
         
     }
     window.IdFormatter = (value,row) =>{
                 return `<div class='text-main fw-bold text-decoration-underline text-nowrap text-start'><a href="#">${value}</a></div>`
         }
       window.detailFormatter = (index, row) => {
      const html = []

      for (const [key, value] of Object.entries(row)) {
        html.push(`<p><b>${key}:</b> ${value}</p>`)
      }
      return html.join('')
    }
      function customDateCollector(value) {
       
      if (!value) return [];
      // console.log(value)
      // Split by comma, then trim whitespace from each generated tag item
      return value.split(',').map(function(item) {
          // console.log(item)
          
         return Number(new Date(value).getFullYear());
        
      });
    }
    function customSearchRow(text, value, field, data) {
              // If the filter input is empty, show all rows
                console.log(data)
                console.log(value)
                console.log(field)
                 
              if (!text) return true;

              // Convert both values to lowercase strings and trim spaces
              const searchString = text.toString().toLowerCase().trim();
              

              // Returns true only if the cell value starts with the typed text
              return data.TicketId.startsWith(searchString);
            }
     function statusColor(status) {
          switch (status) {
          case 'New': return 'text-dark';
              break;
          case null: return 'd-none';
              break;
            case 'Assigned': return 'text-danger';
              break;
            case 'In Progress': return 'text-primary';
              break;
            case 'Testing': return 'text-secondary';
              break;
            case 'Pending User': return 'text-warning ';
              break;
            case 'Pending Third Party': return 'text-warning ';
              break;
            case 'On Hold': return 'text-warning ';
              break;
            case 'Resolved': return 'text-success';
              break;
            case 'Closed': return 'text-dark';
              break;
          case 'Cancelled': return 'text-muted';
              break;
          default: return '';
              break;
      }
     }

