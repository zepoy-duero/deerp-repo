                </th> *@
                <th data-checkbox="true"
                    data-halign="center"
                    data-formatter="ticketCorrBtn">
                </th>
                <th data-field="TicketId"
                    data-halign="left"
                    data-sortable="true"
                    data-filter-control="input"
                    data-visible="false"
                    data-filter-control-placeholder="Type here . . ."
                    class="text-nowrap">
                    
                </th>
                <th data-field="StringTicketId"
                    data-halign="start"
                    data-align="left"
                    data-searchable="true"
                    data-sortable="true"
                    data-width="30"
                    data-formatter="IdFormatter"
                    data-filter-control="input"
                    data-filter-control-placeholder="Search . ."
                    class="ps-4">
                    Ticket ID
                </th>
                <th data-field="RequestedDate"
                    data-halign="start"
                    data-align="left"
                    data-sortable="true"
                    data-width="50"
                    data-unit="px"
                    data-formatter="dateFormatter"
                    class="ps-4">
                    Requested Date
                </th>
                <th data-field="TicketYear"
                    data-filter-control="select"                   
                    data-filter-default="'2026'"
                    data-filter-control-placeholder="All"
                    class="text-nowrap d-none">
                    Year
                </th>
                <th data-field="RequestedByName"
                    data-halign="start"
                    data-align="left"
                    data-sortable="true"
                    data-formatter="requestedByFormatter"
                    data-filter-control="select"
                    data-filter-control-placeholder="All"
                    data-width="150"
                    data-unit="px"
                    class="ps-4"
                   >
                    Requested By
                </th>

                <th data-field="TicketSubject"
                    data-halign="start"
                    data-align="left"
          
                    
                    data-formatter="subjectFormatter"                   
                    class="ps-4">
                    Subject
                </th>
                <th data-field="StatusName"
                    data-halign="start"
                    data-align="left"
                    data-sortable="true"
                    data-width="50"
                    data-formatter="statusFormatter"
                    data-filter-control="select"
                    data-filter-control-placeholder="All"
                    class="ps-4">
                    Status
                </th>
                <th data-field="TicketPriority"
                    data-halign="start"
                    data-align="left"
                    data-width="20"
                    data-sortable="true"
                    data-filter-control="select"
                    data-filter-control-placeholder="All"
                    class="ps-4">
                    Priority
                </th>
                <th data-field="TaskTypeName"
                    data-halign="start"
                    data-align="left"
                    data-sortable="true"
                    data-filter-control="select"
                    data-filter-control-placeholder="All"
                    class="ps-4">
                    Request Type
                </th>
                <th data-field="AssignedToName"
                    data-halign="start"
                    data-align="left"
                    data-sortable="true"
                    data-filter-control="select"
                    data-filter-control-placeholder="All"
                 
                    class="ps-4">
                    Assigned To
                </th>
                <th data-field="DeptName"
                    data-halign="start"
                    data-align="left"
                    data-sortable="true"
                    data-visible="false"
                    data-filter-control="select"
                    data-filter-control-placeholder="All"
                    class="ps-4">
                    Department
                </th>
                
                @* <th data-field="RequestedDate"
                    data-halign="center"
                    data-sortable="true"
                    data-formatter="dateFormatter"
                    data-filter-control="select"
                    data-filter-data-collector="customDateCollector"
                    data-filter-control-placeholder="2026"
                    class="text-nowrap p-0 m-0">
                    Requested Date
                </th> *@
                
                

               
            </tr>
        </thead>
        
    </table>
</div>
