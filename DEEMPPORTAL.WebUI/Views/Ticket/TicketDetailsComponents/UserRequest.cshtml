<div id="ticketUserRequest" class="card  section-card">
    <div class="card-header section-title border-2">
        User Request
    </div>
    <div class="card-body">
        <div class="container-fluid">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Ticket Subject</label>
                    <div class="input-group">
                        <span class="input-group-text " id="basic-addon1">
                            <i class="fas fa-ticket"></i>
                        </span>
                        <input  id="editTicketSubject" type="text" class="form-control" />


                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Requested By</label>
                    <!-- Hidden real select (for form submission) -->
                    <select id="editSelectUser" class="form-select d-none">
                    </select>
                    <!-- Custom dropdown -->
                    <div class="dropdown rounded-1">
                        <button class="form-select  text-start text-muted" type="button" id="editUserDropdownSelect" data-bs-toggle="dropdown">
                            Landrex Rebruera
                        </button>
                        <div class="dropdown-menu w-100 p-2" style="max-height: 200px !important; overflow-y: scroll;">

                            <!-- Search input -->
                            <input type="text" id="userSearchInput" class="form-control" placeholder="Search...">
                            <!-- Options -->
                            <ul class="list-unstyled mb-0 p-2" id="userList">
                            </ul>

                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label d-flex justify-content-between align-items-center">
                        <span>Requested Date</span>
                        <span id="editRequestDate" class="ms-2"><i class="fas fa-pen text-main" onclick="editDateRequested()"></i></span>
                        <span id="saveRequestDate" class="ms-2  d-none"><i class="fas fa-floppy-disk text-main" onclick="saveDateRequested()"></i></span>
                    </label>

                    <div class="input-group ">
                        <span class="text-center input-group-text">
                            <i class="fas fa-calendar" id="basic-addon1"></i>
                        </span>
                        <span id="dateRequested" class="form-control">Mar 31, 2026</span>
                        <input id="editRequestedDate" type="date" class="form-control d-none">

                    </div>

                    @*     <input type="date" class="form-control d-none" />

                                                        <span class="form-control">
                                                            <i class="fas fa-calendar" id="basic-addon1"></i>
                                                            Mar 31, 2026</span> *@
                    @* <div class="calendar-card">
                                                            <div class="calendar-header">
                                                                April
                                                            </div>
                                                            <div class="calendar-body">
                                                                <div class="calendar-day">18</div>
                                                            </div>
                                                        </div> *@

                </div>
                <div class="col-md-6">
                    <label for="editTicketDescription" class="form-label">Description</label>
                    <textarea id="editTicketDescription" class="form-control" style="height: 200px" placeholder="Detailed description"></textarea>
                </div>
                <div class="col-md-6">
                    @* <div class="row text-center">
                                                            <div class="col-md-4 mb-4">
                                                                <img src="https://via.placeholder.com/300x200" alt="Image 1" class="img-fluid rounded placeholder-glow">
                                                            </div>
                                                            <div class="col-md-4 mb-4">
                                                                <img src="https://via.placeholder.com/300x200" alt="Image 2" class="img-fluid rounded">
                                                            </div>
                                                            <div class="col-md-4 mb-4">
                                                                <img src="https://via.placeholder.com/300x200" alt="Image 3" class="img-fluid rounded">
                                                            </div>/
                                                            <div class="col-md-4 mb-4">
                                                                <img src="https://via.placeholder.com/300x200" alt="Image 4" class="img-fluid rounded">
                                                            </div>
                                                            <div class="col-md-4 mb-4">
                                                                <img src="https://via.placeholder.com/300x200" alt="Image 5" class="img-fluid rounded">
                                                            </div>
                                                            <div class="col-md-4 mb-4">
                                                                <img src="https://via.placeholder.com/300x200" alt="Image 6" class="img-fluid rounded">
                                                            </div>
                                                        </div> *@
                    <label class="form-label">Attachments</label>
                    <div class="attachment-box d-none">
                        <div class="text-muted">Upload files</div>
                        <input type="file" class="form-control mt-2" multiple>
                    </div>
                    <div id="attachmentsPreviewContainer" class="" style="max-height: 200px; overflow-y:scroll"></div>
                </div>
            </div>
        </div>
    </div>
</div>
