<div id="ticketUserRequest" class="card  section-card">
    <div class="card-header section-title border-2">
        <div class="d-flex justify-content-between align-items-center">
            <div class="">
                User Request
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="toggleEditUserRequest">
                <label class="form-check-label" for="toggleEditUserRequest">Edit Mode</label>
            </div>
            <div class="d-none">
                <button id="userRequestEditBtn" class="btn btn-sm btn-danger rounded-pill">
                    EDIT
                    <i class="bi bi-pencil-square ms-2"></i>
                </button>
                <button id="userRequestUpdateBtn" class="btn btn-sm btn-main  rounded-pill d-none">
                    SAVE
                    <i class="bi bi-floppy-fill ms-2"></i>
                </button>
                
            </div>
        </div>
       
    </div>
    <div class="card-body">
        <div class="container-fluid">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Ticket Subject</label>
                    
                        <input id="ticketSubject"  class="form-control-plaintext text-muted fw-bold " disabled />

                    <hr />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Requested By</label>


                    <input id="editRequestedByCode" class="form-control d-none" />
                 
                    <input id="editRequestedByName" class="form-control d-none" />
                        <!-- Custom dropdown -->
                        <div class="dropdown rounded-1">
                        <button disabled class="form-control-plaintext text-truncate text-start text-muted" type="button" id="displayRequestedByName" data-bs-toggle="dropdown">
                                Landrex Rebruera
                            </button>
                            <div class="dropdown-menu w-100 p-2" >

                                <!-- Search input -->
                                <input type="text" id="userSearchInput" class="form-control" placeholder="Search...">
                                <!-- Options -->
                            <ul class="list-unstyled mb-0 p-2" id="userList" style="max-height: 200px !important; overflow-y: scroll;">
                                </ul>

                            </div>
                     
                    </div>
                    <hr />
                </div>
                <div class="col-md-3">
                    <label for="editRequestedDate" class="form-label">
                        Requested Date
                         </label>
                    <input id="displayRequestedDate" class="form-control-plaintext text-muted fw-bold" disabled />
                    <input id="editRequestedDate" type="date" class="form-control d-none"/>
                        <hr />
                </div>
                <div class="col-md-6">
                    <label for="ticketDescription" class="form-label">Description</label>
                    <textarea id="ticketDescription" class="form-control text-muted" style="height: 200px !important" placeholder="Detailed description"></textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Attachments</label>
                    <div class="attachment-box d-none">
                        <div class="text-muted">Upload files</div>
                        <input type="file" class="form-control mt-2" multiple>
                        <div class="d-none" id="ticketAttachments">

                        </div>
                    </div>
                    <div id="attachmentsPreviewContainer" class="" style="max-height: 200px; overflow-y:scroll"></div>
                </div>
            </div>
        </div>
    </div>
</div>
