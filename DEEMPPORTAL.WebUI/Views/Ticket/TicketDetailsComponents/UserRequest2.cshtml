<div id="ticketUserRequest" class="card  section-card">
    <div class="card-header section-title border-2">
        <div class="d-flex justify-content-between align-items-center">
            <div class="">
                User Request
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="toggleEditUserRequest">
                <label class="form-check-label" for="toggleEditUserRequest">Edit Mode</label>
            </div>
           
        </div>

    </div>
    <div class="card-body">
        <div class="container-fluid">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Ticket Subject</label>

                    <input id="ticketSubject" class="form-control fw-bold " readonly />

                    <hr />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Requested By</label>


                    <select id="requestedByCode" class="form-select" readonly>
                    </select>
                    
                    <hr />
                </div>
                <div class="col-md-3">
                    <label class="form-label">
                        Requested Date
                    </label>
                    <input id="requestedDate" type="date" class="form-control fw-bold" readonly />
                    <hr />
                </div>
                <div class="col-md-6">
                    <label for="editTicketDescription" class="form-label">Description</label>
                    <textarea id="ticketDescription" class="form-control" style="height: 200px !important" placeholder="Detailed description"></textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Attachments</label>
                    <div class="attachment-box d-none">
                        <div class="text-muted">Upload files</div>
                        <input type="file" class="form-control mt-2" multiple>
                        <div class="d-none" id="ticketAttachments">
                        </div>
                    </div>
                    <div id="attachmentsPreviewContainer" class="" style="max-height: 200px; overflow-y:scroll"></div>
                </div>
            </div>
        </div>
    </div>
</div>
