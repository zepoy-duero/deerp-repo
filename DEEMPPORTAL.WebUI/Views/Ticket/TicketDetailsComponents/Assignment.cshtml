<div id="ticketAssignedTo" class="card  section-card">
    <div class="card-header section-title border-2">
        Assignment

    </div>
    <div class="card-body">

        <div class="container-fluid">
            <!-- Row 1 -->
            <div class="row g-0 pe-0 mb-3">
                <div class="col-md-3">
                    <label class="form-label">Assigned To</label>

                    <!-- Hidden real select (for form submission) -->
                    <select id="selectAssignee" class="form-select d-none">
                    </select>

                    <!-- Custom dropdown -->
                    <div class="dropdown rounded-1">
                        <button class="form-select text-start text-muted" type="button" id="assigneeDropdownSelect" data-bs-toggle="dropdown">
                            Jeffvil Duero
                        </button>

                        <div class="dropdown-menu w-100 p-2" style="max-height: 200px !important; overflow-y: scroll;">

                            <!-- Search input -->
                            <input type="text" id="assigneeSearchInput" class="form-control mb-2" placeholder="Search...">

                            <!-- Options -->
                            <ul class="list-unstyled mb-0" id="assigneeList">
                            </ul>

                        </div>
                    </div>
                </div>
                <div class="col-md-3 px-0">
                    <label class="form-label">Priority</label>
                    <select id="selectPriority" class="form-select"></select>
                </div>
                @* <div class="col-md-6 ">
                                                        <label class="form-label">Module</label>
                                                        <select id="selectModule" class="form-select">
                                               
                                                        </select>
                                                    </div> *@
                <div class="col-md-6">
                    <label class="form-label">Module</label>

                    <!-- Hidden real select (for form submission) -->
                    <select id="selectModule" class="form-select d-none">
                    </select>

                    <!-- Custom dropdown -->
                    <div class="dropdown rounded-1">
                        <button class="form-select text-start text-muted" type="button" id="moduleDropdownSelect" data-bs-toggle="dropdown">
                            Employee Portal
                        </button>

                        <div class="dropdown-menu w-100 p-2" style="max-height: 200px !important; overflow-y: scroll;">

                            <!-- Search input -->
                            <input type="text" id="moduleSearchInput" class="form-control mb-2" placeholder="Search...">

                            <!-- Options -->
                            <ul class="list-unstyled mb-0" id="moduleList">
                            </ul>

                        </div>
                    </div>
                </div>
            </div>

            <!-- Row 2 -->
            <div class="row g-0 mb-2 pe-0">

                <div class="col-md-3">
                    <label class="form-label">Type</label>
                    <select id="selectType" class="form-select">
                    </select>
                </div>

                <div class="col-md-3 px-0">
                    <label class="form-label">Duration</label>
                    <div class="d-flex gap-2">
                        <input type="number" value="0" class="form-control w-25">
                        <select id="selectDurationUnit" class="form-select w-75">
                        </select>
                    </div>
                </div>

                <div class="col-md-2 pe-0">
                    <label class="form-label">Start</label>
                    <input type="date" class="form-control">
                </div>

                <div class="col-md-2">
                    <label class="form-label">End</label>
                    <input type="date" class="form-control">
                </div>
            </div>

            <!-- Row 3 -->
            <div class="row">
                <div class="col-md-3">
                    <label class="form-label">Status</label>
                    <select id="selectStatus" class="form-select"></select>
                </div>
            </div>
        </div>
    </div>
</div>