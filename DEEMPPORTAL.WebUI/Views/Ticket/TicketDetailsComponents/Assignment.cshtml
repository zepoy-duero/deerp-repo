<section id="assignedTo" class="card p-4">
    <h5 class="section-title">Assigned To</h5>

    <div class="row g-3">
        <div class="col-md-6">
            <label>Resource Name</label>
            <input type="text" id="resourceName" class="form-control">
        </div>

        <div class="col-md-6">
            <label>Priority</label>
            <select id="priority" class="form-select">
                <option>Low</option>
                <option>Medium</option>
                <option>High</option>
            </select>
        </div>

        <div class="col-12">
            <label>Task Description</label>
            <textarea id="mgrTaskDescription" class="form-control"></textarea>
        </div>

        <div class="col-md-4">
            <label>Start Date</label>
            <input type="date" id="startDate" class="form-control">
        </div>

        <div class="col-md-4">
            <label>Finish Date</label>
            <input type="date" id="finishDate" class="form-control">
        </div>

        <div class="col-md-4">
            <label>Duration</label>
            <input type="text" id="duration" class="form-control">
        </div>
    </div>
</section>