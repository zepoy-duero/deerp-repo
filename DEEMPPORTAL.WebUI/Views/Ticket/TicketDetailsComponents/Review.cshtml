<div id="ticketReview" class="card  section-card">
    <div class="card-header section-title border-2">
       
        <div class="d-flex justify-content-between align-items-center">
            <div>
                Review/Release
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="toggleEditReview">
                <label class="form-check-label" for="toggleEditReview">Edit Mode</label>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        @* <div class="section-title text-main">Review</div> *@
        <div class="container-fluid">
            <div class="row g-0 mb-4">
                <div class="col-md-3 d-flex flex-column">
                    <div class="form-group">
                        <label>Reviewed By</label>
                        <input id="reviewedByName" class="form-control" placeholder="Jeffvil Duero" disabled />
                    </div>
                    <div class="form-group mt-0">
                        <label>Reviewed Date</label>
                        <input id="reviewedDate" type="date" class="form-control" value="2026-06-17" disabled />
                    </div>
                    <div class="form-group">
                        <label>Version Number</label>
                        <input id="versionNo" class="form-control" value="v2.0.0.1" disabled />
                    </div>
                    <div class="form-group">
                        <label for="remarks">Reviewed Remarks</label>
                        <textarea id="remarks" class="form-control" disabled></textarea>

                    </div>
                    <div class="form-group">
                        <label for="fileInput" class="form-label">
                            <i class="bi bi-images"></i>
                            Upload attachment:
                        </label>
                        <div class="card shadow-sm pb-0">
                            <div class="card-body">
                                <!-- Drop Zone -->
                                <div id="dropZone" class="drop-zone">
                                    <i class="bi bi-cloud-upload"></i>
                                    @* <p class="mb-1"><strong>DRAG & DROP or PASTE Screenshots here</strong></p>
                                    <p class="text-muted mb-2">or click to browse</p> *@
                                    <input type="file" id="TicketAttachments" hidden multiple
                                           accept=".png,.pdf,.xls,.xlsx">
                                </div>
                                <!-- Preview List -->
                                <div id="previewContainer" class="mt-2"></div>
                            </div>
                        </div>
                    </div>
                    <div class="form-group d-none">
                        <input id="updatedBy" class="form-control d-none"/>
                        <input type="date" id="updatedDate" class="form-control d-none" />
                    </div>
                </div>
              
                <div class="col-md-9">
                    <!-- Nav tabs -->
                    <ul class="nav nav-tabs">
                        <li class="nav-item">
                            <a class="nav-link active" data-bs-toggle="tab" href="#Correspondence">Correspondence</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="tab" href="#History">History</a>
                        </li>
                    
                    </ul>

                    <!-- Tab panes -->
                    <div class="tab-content">
                       
                        <div class="tab-pane container active " id="Correspondence">
                            @{
                                await Html.RenderPartialAsync("~/Views/Ticket/TicketDetailsComponents/TicketCorrespondence.cshtml");
                            }
                        </div>
                        <div class="tab-pane container fade" id="History">
                            @{
                                await Html.RenderPartialAsync("~/Views/Ticket/TicketDetailsComponents/TicketHistory.cshtml");
                            }
                        </div>
                    </div>
                   
                </div>
            </div>
        </div>
    </div>
</div>