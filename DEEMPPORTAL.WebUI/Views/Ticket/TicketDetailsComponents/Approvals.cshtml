<div id="ticketApproval" class="card  section-card">
    <div class="card-header section-title border-2">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                Approvals
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="toggleEditApprovals">
                <label class="form-check-label" for="toggleEditApprovals">Edit Mode</label>
            </div>
        </div>
    </div>
    <div class="card-body">
        @* <div class="section-title text-main">Approval</div> *@
        <div class="container-fluid">
            <div class="row g-3">
                <!-- LEFT SIDE -->
                <div class="col-md-4">
                    <label id="displayDeptMgnrName" for="approveByManager" class="form-label">Department Manager - (Riyaz Ahmed)</label>

                    <select  id="approveByManager" class="form-control text-muted fw-bold" disabled>
                        <option selected value="0">Pending</option>
                        <option value="1">
                            <i class="bi bi-check text-success me-2" ></i>
                            Approved</option>
                    </select>
                  
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" id="isManagementApproval">
                        <label class="form-check-label">Management Approval Required?</label>
                    </div>
                   
                </div>
            </div>
            <div id="managementApprovalRequired" class="row mt-3 d-none">

                <!-- Management -->
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Management</label>
                        <div class="input-group">
                            <span class="text-center input-group-text">
                                <i class="bi bi-user"></i>
                            </span>
                            <select class="form-select">
                                <option>Saleem Ahmed</option>
                            </select>
                        </div>
                    </div>



                    <!-- Send Email -->
                    <div class="form-group">
                        <label class="form-label">Send Email</label>
                        <button class="btn btn-primary w-100" onclick="openSendEmailModal()">
                            <i class="bi bi-envelope me-2"></i>
                            Send Email
                        </button>
                    </div>



                    <!-- Status -->
                    <div class="form-group">
                        <label class="form-label">STATUS</label>
                        <div class="form-control btn btn-dark fw-bold">PENDING</div>
                    </div>



                    <!-- Date -->
                    <div class="form-group">
                        <label class="form-label">DATE OF APPROVAL</label>
                        <div class="form-control-plaintext">?</div>
                    </div>


                </div>

            </div>
          </div>
    </div>
</div>