<section id="actionTaken" class="card p-4">
    <h5 class="section-title">Action Taken</h5>

    <div class="row g-3">

        <div class="col-md-6">
            <label>Task ID</label>
            <input type="text" id="taskId" class="form-control">
        </div>

        <div class="col-12">
            <label>Task Description</label>
            <textarea id="devTaskDescription" class="form-control"></textarea>
        </div>

        <div class="col-md-4">
            <label>Start Date</label>
            <input type="date" id="devStartDate" class="form-control">
        </div>

        <div class="col-md-4">
            <label>Finish Date</label>
            <input type="date" id="devFinishDate" class="form-control">
        </div>

        <div class="col-md-4">
            <label>Status</label>
            <select id="devStatus" class="form-select">
                <option>In Progress</option>
                <option>Completed</option>
                <option>Blocked</option>
            </select>
        </div>

    </div>

    @* <div class="mt-3 text-end">
        <button class="btn btn-warning" id="btnSaveDeveloper">Update Task</button>
    </div> *@
</section>