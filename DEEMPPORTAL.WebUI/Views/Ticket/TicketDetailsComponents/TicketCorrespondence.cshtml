<style>
    /* Correspondence container */
    .correspondence-list {
        height: 400px;
        overflow-y: auto;
    }

    /* Correspondence item */
    .correspondence-item {
        cursor: pointer;
        border-left: 3px solid transparent !important;
        transition: all 0.2s ease-in-out;
    }

        /* Hover */
        .correspondence-item:hover {
            background-color: #f8f9fa;
        }

        /* Selected item */
        .correspondence-item.active {
          
            color: #212529;
            border-left: 3px solid #0d6efd !important;
        }

            /* Keep muted text readable when selected */
            .correspondence-item.active .text-muted {
                color: #6c757d !important;
            }

    /* Message editor */
    #txtCorrespondence {
        resize: vertical;
        min-height: 150px;
    }
</style>
<div class="card shadow-sm" >
    <!-- Header -->
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0">
