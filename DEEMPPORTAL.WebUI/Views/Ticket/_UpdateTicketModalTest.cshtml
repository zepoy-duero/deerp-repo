@using System.Security.Claims

<style>
    /* =========================================================
               TICKET MODAL - PROFESSIONAL ENTERPRISE UI
               Bootstrap 5.1 compatible
            ========================================================= */

    :root {
        --ticket-primary: #173f5f;
        --ticket-primary-light: #eef5fa;
        --ticket-border: #e5e9ef;
        --ticket-bg: #f6f8fb;
        --ticket-text: #263238;
        --ticket-muted: #718096;
        --ticket-danger: #dc3545;
    }

    /* ---------- MODAL ---------- */

    #editTicketModal .modal-content {
        border: 0;
        border-radius: 0;
        background: var(--ticket-bg);
        overflow: hidden;
    }

    /* #editTicketModal .modal-header {
            min-height: 64px;
            padding: 0 24px;
            border: 0;
            background: var(--ticket-primary) !important;
            box-shadow: 0 2px 8px rgba(0,0,0,.12);
            z-index: 20;
        } */

    #editTicketModal .modal-title {
        font-size: 15px;
        letter-spacing: .1px;
        max-width: calc(100vw - 100px);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }



    #editTicketModal .modal-body {
        padding: 22px 24px 90px;
        overflow-y: auto;
        background: var(--ticket-bg);
    }

    /* ---------- FORM ---------- */

    #editTicketForm {
        width: 100%;
    }

    #editTicketModal .form-label {
        color: #52606d;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 7px;
        text-transform: uppercase;
        letter-spacing: .35px;
    }

    #editTicketModal .form-control,
    #editTicketModal .form-select {
        min-height: 40px;
        border: 1px solid var(--ticket-border);
        border-radius: 7px;
        background: #fff;
        color: var(--ticket-text);
        font-size: 13px;
        box-shadow: none;
        transition: .15s ease;
    }

        #editTicketModal .form-control:focus,
        #editTicketModal .form-select:focus {
            border-color: #7ca8c7;
            box-shadow: 0 0 0 3px rgba(23,63,95,.08);
        }

    /* ---------- READ-ONLY FIELDS ---------- */

    #editTicketModal .form-control-plaintext {
        min-height: 40px;
        padding: 9px 12px;
        border: 1px solid var(--ticket-border);
        border-radius: 7px;
        background: #f8fafc;
        color: #263238 !important;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none !important;
    }

        #editTicketModal .form-control-plaintext:disabled {
            opacity: 1;
        }

    /* ---------- CARDS ---------- */

    #editTicketModal .card {
        border: 1px solid var(--ticket-border) !important;
        border-radius: 10px;
        background: #fff;
        box-shadow: 0 2px 8px rgba(15, 23, 42, .04) !important;
        overflow: hidden;
    }

    #editTicketModal .card-header {
        min-height: 48px;
        max-height: 64px !important;
        padding: 13px 17px;
        border-bottom: 1px solid var(--ticket-border) !important;
    }

    #editTicketModal .card-body {
        padding: 18px;
    }

    /* ---------- SECTION HEADER ---------- */

    #editTicketModal .section-title {
        color: var(--ticket-primary) !important;
        font-size: 12px;
        font-weight: bold;
        border-left: 4px solid var(--ticket-primary) !important;
        padding-left: 14px;
    }



    /* ---------- EDIT SWITCH ---------- */

    #toggleEditUserRequest {
        cursor: pointer;
    }

        #toggleEditUserRequest:checked {
            background-color: var(--ticket-primary);
            border-color: var(--ticket-primary);
        }

    #editTicketModal .form-check-label {
        color: #68737d;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
    }

    /* ---------- REMOVE OLD HR LOOK ---------- */

    #editTicketModal hr {
        display: none;
    }

    /* ---------- SUBJECT ---------- */

    #ticketSubject {
        font-size: 14px;
        font-weight: 600;
        color: #1f2933 !important;
    }

    /* ---------- REQUESTED BY DROPDOWN ---------- */

    #displayRequestedByName {
        width: 100%;
        min-height: 40px;
        padding: 9px 12px !important;
        background: #f8fafc !important;
    }

        #displayRequestedByName:not(:disabled) {
            cursor: pointer;
            background: #fff !important;
        }

    #editTicketModal .dropdown-menu {
        border: 1px solid var(--ticket-border);
        border-radius: 8px;
        box-shadow: 0 10px 30px rgba(15,23,42,.12);
    }

    #userSearchInput {
        min-height: 38px;
        margin-bottom: 5px;
    }

    #userList {
        scrollbar-width: thin;
    }

        #userList .dropdown-item {
            padding: 8px 10px;
            border-radius: 5px;
            font-size: 12px;
            color: #374151;
        }

            #userList .dropdown-item:hover {
                background: var(--ticket-primary-light);
                color: var(--ticket-primary);
            }

    /* ---------- SUMMERNOTE ---------- */

    #editTicketModal .note-editor {
        border: 1px solid var(--ticket-border) !important;
        border-radius: 8px !important;
        overflow: hidden;
        box-shadow: none !important;
    }

    #editTicketModal .note-toolbar {
        border-bottom: 1px solid var(--ticket-border) !important;
        background: #f8fafc !important;
    }

    #editTicketModal .note-editable {
        min-height: 170px;
        font-size: 13px;
        line-height: 1.65;
        padding: 14px;
    }

    /* ---------- ATTACHMENTS ---------- */

    #attachmentsPreviewContainer {
        height: auto !important;
        max-height: 210px !important;
        min-height: 70px;
        padding: 4px;
        border: 1px dashed #d7dde5;
        border-radius: 8px;
        background: #fafbfc;
    }

    .file-preview-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 12px !important;
        max-height: 50px !important;
        margin-bottom: 6px;
        border: 1px solid var(--ticket-border);
        border-radius: 7px;
        background: #fff;
        transition: .15s ease;
    }

        .file-preview-item:hover {
            border-color: #b9c9d8;
            background: #f8fafc;
        }

        .file-preview-item .file-info {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
        }

        .file-preview-item .file-icon {
            width: 32px;
            height: 32px;
            object-fit: contain;
            flex-shrink: 0;
        }

        .file-preview-item strong {
            display: block;
            max-width: 500px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-size: 12px;
        }

    /* ---------- SIDEBAR ---------- */

    #editTicketModal .ticket-sidebar {
        position: sticky;
        top: 0;
    }

        #editTicketModal .ticket-sidebar .card {
            margin-bottom: 12px;
        }

    .ticket-property {
        padding: 13px 15px;
    }

    .ticket-property-label {
        display: block;
        margin-bottom: 6px;
        color: #8a96a3;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .ticket-property-value {
        color: #273444;
        font-size: 13px;
        font-weight: 600;
    }

    /* ---------- STATUS ---------- */

    /* #EditTicketStatusBadge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 110px;
            min-height: 34px;
            padding: 7px 13px !important;
            border-radius: 20px !important;
            font-size: 12px !important;
            font-weight: 700;
        } */

    /* ---------- SMALL BADGES ---------- */

    /* #EditPriorityBadge,
        #EditAssignedToNameBadge {
            font-size: 11px !important;
            padding: 6px 10px !important;
            border-radius: 6px !important;
            font-weight: 600;
        }

        #EditAssignedToNameBadge {
            color: #52606d;
            background: #f1f4f7 !important;
        } */

    /* ---------- ACTIVITY TIMELINE ---------- */

    #ticketActivityTimeline {
        position: relative;
        padding: 5px 5px 5px 28px;
    }

        #ticketActivityTimeline::before {
            content: "";
            position: absolute;
            top: 8px;
            bottom: 8px;
            left: 10px;
            width: 1px;
            background: #dce2e8;
        }

    .ticket-activity-item {
        position: relative;
        padding: 0 0 18px 18px;
    }

        .ticket-activity-item::before {
            content: "";
            position: absolute;
            left: -23px;
            top: 4px;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: #fff;
            border: 2px solid var(--ticket-primary);
        }

    /* ---------- CORRESPONDENCE ---------- */

    /* #showTicketCorrBtn {
            width: 100%;
            min-height: 40px;
            border: 1px solid var(--ticket-primary);
            background: var(--ticket-primary);
            font-size: 12px;
            font-weight: 600;
            border-radius: 7px !important;
            box-shadow: none !important;
        } */

    #ticketCorrespondenceOffcanvas {
        width: min(650px, 100vw) !important;
        border-left: 1px solid var(--ticket-border);
        box-shadow: -10px 0 30px rgba(15,23,42,.12);
    }

        #ticketCorrespondenceOffcanvas .offcanvas-header {
            min-height: 60px;
            padding: 0 20px;
            background: var(--ticket-primary) !important;
        }

        #ticketCorrespondenceOffcanvas .offcanvas-title {
            font-size: 14px !important;
        }

        #ticketCorrespondenceOffcanvas .offcanvas-body {
            padding: 0;
            background: #f7f9fb;
        }

    #userCorrespondenceContainer {
        height: calc(100vh - 210px);
        max-height: none !important;
        padding: 20px;
        overflow-y: auto;
    }

    .corr-msg {
        border-radius: 10px !important;
        max-width: 80%;
        line-height: 1.55;
    }

    .msg-agent .corr-msg {
        background: var(--ticket-primary) !important;
    }

    /* ---------- CORRESPONDENCE COMPOSER ---------- */

    #ticketCorrespondenceOffcanvas .border-top {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        margin: 0 !important;
        padding: 14px 18px !important;
        background: #fff;
        border-top: 1px solid var(--ticket-border) !important;
    }

    #TicketCorrespondence {
        resize: none;
        min-height: 80px;
        border-radius: 8px;
    }

    #btnSendCorrespondence {
        min-width: 90px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 600;
    }

    /* ---------- FOOTER ---------- */

    #editTicketModal .modal-footer {
        min-height: 64px;
        margin: 0 !important;
        padding: 10px 24px;
        background: #fff;
        border-top: 1px solid var(--ticket-border) !important;
        box-shadow: 0 -3px 12px rgba(15,23,42,.05);
        z-index: 20;
    }

    #btnUpdateTicket {
        min-width: 120px;
        min-height: 40px;
        border: 0;
        border-radius: 7px !important;
        /* background: var(--ticket-primary) !important; */
        font-size: 12px;
        font-weight: 700;
        box-shadow: none !important;
    }

        #btnUpdateTicket:hover {
            background: #0f3049 !important;
        }

    /* ---------- RESPONSIVE ---------- */

    @@media (max-width: 991.98px) {
        #editTicketModal .modal-body {
            padding: 15px 12px 85px;
        }

        #editTicketModal .ticket-sidebar {
            position: static;
        }

        #editTicketModal .modal-title {
            font-size: 13px;
        }
    }

    @@media (max-width: 575.98px) {
        #editTicketModal .modal-header {
            padding: 0 15px;
        }

        #editTicketModal .modal-footer {
            padding: 10px 15px;
        }

        #editTicketModal .modal-body {
            padding: 12px 10px 85px;
        }

        .corr-msg {
            max-width: 90%;
        }
    }
</style>


<div class="modal fade" id="editTicketModal" tabindex="-1" aria-labelledby="editTicketModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen">
        @* <div class="modal-dialog modal-dialog-centered @(User.HasClaim("HasFullAccess", "true")
         || User.HasClaim("DeptManagerAccess", "true")
         ? "modal-fullscreen" : "modal-xl")"> *@
        <div class="modal-content">

            <!-- HEADER -->
            @* <div class="modal-header bg-main text-white">
                <h6 class="modal-title fw-bold" id="editTicketModalTitle"></h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div> *@

            <div class="modal-header bg-main text-white">

                <div class="d-flex align-items-center min-width-0">

                    <div class="me-3">

                        <div class="rounded-circle
                        bg-white bg-opacity-10
                        d-flex align-items-center
                        justify-content-center"
                             style="width:38px;height:38px;">

                            <i class="bi bi-ticket-detailed-fill"></i>

                        </div>

                    </div>

                    <div class="min-width-0">

                        <div class="small text-white-50 mb-1">
                            TICKET
                        </div>

                        <h6 class="modal-title fw-bold mb-0"
                            id="editTicketModalTitle">

                            MIS-230

                        </h6>

                    </div>

                </div>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <!-- BODY -->
            @if (User.HasClaim("HasFullAccess", "true")
                        || User.HasClaim("DeptManagerAccess", "true"))
            {
                <!-- MIS/MANAGEMENT VIEW-->
                <div class="modal-body  position-relative" data-bs-spy="scroll">
                    <div class="container-fluid">
                        <div class="row g-0">
                            <!-- SIDEBAR -->
                            <div class=" @(User.HasClaim("HasFullAccess", "true")
                                                                                                || User.HasClaim("DeptManagerAccess", "true")
                                                                                                ? "col-2 ps-0" : "col-2 ps-0 d-none")">
                            <div class="card position-sticky top-0 w-100">
                                <div class="card-header bg-danger rounded-top text-white fs-6">
                                    <i class="fa fa-ticket me-2"></i>
                                    Ticket Details
                                </div>

                                    <div id="ticketNav" class="list-group list-group-flush justify-content-center">
                                        <a class="list-group-item list-group-item-action d-flex align-items-center" href="#ticketUserRequest">
                                            <i class="bi bi-person-circle me-2"></i>
                                            User Request
                                        </a>
                                        <a class="list-group-item list-group-item-action d-flex align-items-center" href="#ticketAssignedTo">
                                            <i class="bi bi-person-down me-2"></i>
                                            <span> Assigned To</span>

                                        </a>
                                        <a class="list-group-item list-group-item-action d-flex align-items-center" href="#ticketApproval">
                                            <i class="bi bi-hand-thumbs-up me-2"></i>
                                            Approvals
                                        </a>
                                        <a id="reviewSection" class="list-group-item list-group-item-action d-flex align-items-center" href="#ticketReview">

                                            <i class="bi bi-list-stars me-2"></i>
                                            Review
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <!-- CONTENT -->

                            <div class="@(User.HasClaim("HasFullAccess", "true")
                                                                                              || User.HasClaim("DeptManagerAccess", "true")
                                                                                                                          ? "col-10 ps-0" : "col-12 ps-0")">

                            <div class="container-fluid">
                                <div class="row g-2">
                                    <!--CENTER-->
                                    <div class="@(User.HasClaim("HasFullAccess", "true")
                                                                                                                                       || User.HasClaim("DeptManagerAccess", "true")
                                                                                                                                       ? "col-12 ps-0" : "col-9 ps-0")">
                                        <div data-bs-spy="scroll"
                                             data-bs-target="#ticketNav"
                                             data-bs-offset="50"
                                             tabindex="0">
                                            <form id="editTicketForm" class="form" novalidate>

                                                @{
                                                        await Html.RenderPartialAsync("~/Views/Ticket/UpdateTicketComponents/UserRequest.cshtml");
                                                    }

                                                    <div class="@(User.HasClaim("HasFullAccess", "true")
                                                                                                                                                                           || User.HasClaim("DeptManagerAccess", "true")
                                                                                                                                                                           ? "" : "d-none")">
                                                    @{
                                                            await Html.RenderPartialAsync("~/Views/Ticket/UpdateTicketComponents/Assignment.cshtml");
                                                            await Html.RenderPartialAsync("~/Views/Ticket/UpdateTicketComponents/Approvals.cshtml");
                                                            await Html.RenderPartialAsync("~/Views/Ticket/UpdateTicketComponents/Review.cshtml");
                                                        }
                                                    </div>


                                                </form>
                                            </div>
                                        </div>
                                        <!--USER/EMPLOYEE VIEW-->
                                        <div class="@(User.HasClaim("HasFullAccess", "true")
                                                                                                                                              || User.HasClaim("DeptManagerAccess", "true")
                                                                                                                                              ? "d-none" : "col-3 ps-0" )">
                                        <!-- =================================
                                             STATUS
                                        ================================== -->

                                            <div class="card border-0 shadow-sm mb-3">

                                                <div class="card-header bg-white d-flex justify-content-between align-items-center">

                                                    <h6 class="mb-0 fw-bold small text-main">
                                                        <i class="bi bi-activity me-2"></i>
                                                        Status
                                                    </h6>
                                                    <div class="text-center ms-auto">

                                                        <span id="EditTicketStatusBadge"
                                                              class="badge badge-success rounded-pill bg-secondary fs-4 fw-bold px-3 py-2">

                                                            Completed

                                                        </span>

                                                    </div>

                                                </div>
                                            </div>
                                            <!-- =================================
                                                 ASSIGNMENT
                                            ================================== -->

                                            <div class="card border-0 shadow-sm mb-3">

                                                <div class="card-header bg-white d-flex justify-content-between align-items-center">

                                                    <h6 class="small fw-bold text-main me-auto">

                                                        <i class="bi bi-person-check-fill"></i>

                                                        Assigned To

                                                    </h6>
                                                    <div class="text-center">
                                                        <span id="EditAssignedToNameBadgeManagement"
                                                              class="badge badge-main rounded-pill bg-secondary fs-6 fw-bold  text-muted px-3 py-2">

                                                            Completed

                                                        </span>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- =================================
                                                  PRIORITY
                                            ================================== -->
                                            <div class="card border-0 shadow-sm mb-3">
                                                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                                                    <h6 class="mb-0 small fw-bold text-main">
                                                        <i class="bi bi-flag-fill me-2"></i>
                                                        Priority
                                                    </h6>
                                                    <div class="text-center ms-auto">
                                                        <span id="EditPriorityBadge"
                                                              class="badge badge-main rounded-pill bg-secondary fs-5 fw-bold text-muted px-3 py-2">

                                                            Low

                                                        </span>
                                                    </div>
                                                </div>
                                            </div>


                                            <!-- =================================
                                                 TASK TYPE
                                            ================================== -->

                                            <div class="card border-0 shadow-sm mb-3">

                                                <div class="card-header bg-white d-flex justify-content-between align-items-center">

                                                    <h6 class="mb-0 small fw-bold text-main">

                                                        <i class="bi bi-list-task me-2"></i>

                                                        Task Type

                                                    </h6>
                                                    <div class="text-center ms-auto">
                                                        <span id="EditPriorityBadgeManagement"
                                                              class="badge badge-main rounded-pill bg-secondary fs-5 fw-bold  text-muted px-3 py-2">

                                                            Low

                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col">
                                            <!-- =================================
                                                 TICKET TIMELINE
                                            ================================== -->

                                            <div class="card border-0 shadow-sm">

                                                <div class="card-header bg-white">

                                                    <h6 class="mb-0 small fw-bold text-main">

                                                        <i class="bi bi-clock-history me-2"></i>

                                                        Activity

                                                    </h6>

                                                </div>


                                                <div class="card-body">

                                                    <div id="ticketActivityTimeline">

                                                        <div class="text-center text-muted">

                                                            No activity available.

                                                        </div>

                                                    </div>

                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>

                </div>

                        }
            else
            {
                <!-- USER VIEW -->
                <div class="modal-body position-relative" data-bs-spy="scroll">
                    <div class="container-fluid px-0">

                        <div class="row g-3">

                            <!-- =========================================
                                 MAIN CONTENT
                            ========================================== -->
                            <div class="col-12 col-xl-8">

                                <form id="editTicketForm" novalidate>

                                    <!-- USER REQUEST -->
                                    <div class="card mb-3">

                                        <div class="card-header section-title
                                        d-flex align-items-center
                                        justify-content-between">

                                            <span>
                                                User Request
                                            </span>

                                            <div class="form-check form-switch mb-0">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       role="switch"
                                                       id="toggleEditUserRequest">

                                                <label class="form-check-label"
                                                       for="toggleEditUserRequest">
                                                    Edit mode
                                                </label>
                                            </div>

                                        </div>

                                        <div class="card-body">

                                            <div class="row g-3">

                                                <!-- SUBJECT -->
                                                <div class="col-12">

                                                    <label class="form-label">
                                                        Ticket Subject
                                                        <span class="text-danger">*</span>
                                                    </label>

                                                    <input id="ticketSubject"
                                                           class="form-control-plaintext"
                                                           disabled>

                                                </div>


                                                <!-- REQUESTED BY -->
                                                <div class="col-lg-6 col-md-6">

                                                    <label class="form-label">
                                                        Requested By
                                                    </label>

                                                    <input id="editRequestedByCode"
                                                           class="d-none">

                                                    <input id="editRequestedByName"
                                                           class="d-none">

                                                    <div class="dropdown">

                                                        <button type="button"
                                                                id="displayRequestedByName"
                                                                class="form-control text-start text-truncate"
                                                                data-bs-toggle="dropdown"
                                                                disabled>

                                                            Jeffvil Duero

                                                        </button>

                                                        <div class="dropdown-menu w-100 p-2">

                                                            <input type="text"
                                                                   id="userSearchInput"
                                                                   class="form-control mb-2"
                                                                   placeholder="Search employee...">

                                                            <ul id="userList"
                                                                class="list-unstyled mb-0 p-1"
                                                                style="max-height:220px;overflow-y:auto;">
                                                                <!-- Existing generated users -->
                                                            </ul>

                                                        </div>

                                                    </div>

                                                </div>


                                                <!-- REQUESTED DATE -->
                                                <div class="col-lg-6 col-md-6">

                                                    <label class="form-label">
                                                        Requested Date
                                                    </label>

                                                    <input id="displayRequestedDate"
                                                           class="form-control-plaintext text-muted"
                                                           disabled>

                                                    <input id="editRequestedDate"
                                                           name="editRequestedDate"
                                                           type="date"
                                                           class="form-control d-none">

                                                </div>


                                                <!-- DESCRIPTION -->
                                                <div class="col-12 col-lg-7">

                                                    <label for="editTicketDescription"
                                                           class="form-label">

                                                        Description

                                                    </label>

                                                    <textarea id="editTicketDescription"
                                                          class="form-control"
                                                          placeholder="Detailed description">
                                </textarea>

                                                </div>




                                                <!-- ATTACHMENTS -->
