            </div> *@
      

        <!-- Action Buttons Row -->
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <!-- Attachment button moved next to actions or bottom-left depending on your design logic -->
                <button type="button" id="addUserCorrespondenceAttachmentBtn" class="btn btn-sm btn-link p-0 text-decoration-underline text-main fw-bold">
                    <i class="bi bi-paperclip me-1"></i>ADD ATTACHMENT
                </button>
            </div>
            <div class="ms-auto">
                <button type="button" id="clearUserCorrespondenceBtn" class="btn btn-danger btn-sm me-2">
                    <i class="bi bi-arrow-clockwise me-1"></i> Clear
                </button>
                <button id="postUserCorrespondenceBtn" type="button" class="btn btn-main btn-sm">
                    <i class="bi bi-send me-2"></i>Post
                </button>
            </div>
        </div>
    </div>


</div>