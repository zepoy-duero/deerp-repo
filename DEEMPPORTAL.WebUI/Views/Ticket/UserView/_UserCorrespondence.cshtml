<div class="card">
    <div class="card-header section-title">
        <i class="bi bi-chat-left-text-fill ms-2"></i>
        Correspondence
    </div>
    <div class="card-body bg-light bg-opacity-50 p-4">
        <div id="userCorrespondenceAlert" class="d-none">
        </div>
        <div id="userCorrespondenceContainer" style="max-height: 450px !important; overflow-y: scroll">
        </div>
    </div>
    <div class="card-footer p-4 bottom-0 position-sticky bg-white border-top">
        <!-- Main wrapper containing both the textarea and the attached files -->
       
            <!-- Textarea input field -->
            <textarea id="userCorrespondenceField" style="height: 150px !important;" type="text" class="form-control form-control-sm p-3 w-100 mb-2" placeholder="Correspondence here..."></textarea>
            <br />
            <!-- File input element (Hidden) -->
            @* <input id="correspondenceAttachmentInput" type="file" class="d-none" multiple accept=".png,.jpeg,.jpg,.gif,.pdf,.xls,.xlsx" />
            <div class="mt-2 py-3" style="max-height: 180px !important;overflow-y: scroll !important;" id="userCorrespondenceAttachmentSelectedFileContainer"></div>
      *@

        @{
            await Html.RenderPartialAsync("~/Views/Ticket/UserView/_CorrespondenceAttachment.cshtml");
        }
     
