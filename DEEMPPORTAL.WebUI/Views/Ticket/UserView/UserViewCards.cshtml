<div id="userCards" class="d-flex flex-row pb-0">
    <!-- STATUS -->
    <div class="w-25 h-75">
        <div class="card">
            <div class="card-header section-title d-flex align-items-center justify-content-left">
                <i class="bi bi-activity me-2"></i> <span> Status </span>
            </div>
            <div class="card-body text-end p-3 h-100">
                <span id="StatusBadge" class="badge text-wrap d-block rounded-pill p-3"></span>
            </div>
        </div>
    </div>

    <!-- ASSIGNED TO -->
    <div class="w-25 mx-2 h-75">
        <div class="card">
            <div class="card-header section-title d-flex align-items-center justify-content-left">
                <i class="bi bi-person-check me-2"></i> <span> Assigned To </span>
            </div>
            <div class="card-body text-end p-3 h-100">
                <span id="AssignedToNameBadge" class="badge text-wrap d-block rounded-pill p-3"></span>
            </div>
        </div>
    </div>

    <!-- PRIORITY LEVEL -->
    <div class="w-25 me-2 h-75">
        <div class="card">
            <div class="card-header section-title d-flex align-items-center justify-content-left">
                <i class="bi bi-flag me-2"></i> <span> Priority Level </span>
            </div>
            <div class="card-body text-end p-3 h-100">
                <span id="PriorityBadge" class="badge text-wrap d-block rounded-pill p-3">Low</span>
            </div>
        </div>
    </div>

    <!-- TASK TYPE -->
    <div class="w-25 h-75">
        <div class="card">
            <div class="card-header section-title d-flex align-items-center justify-content-left">
                <i class="bi bi-list-task me-2"></i> <span> Task Type </span>
            </div>
            <div class="card-body text-end p-3 h-100">
                <span id="TaskTypeBadge" class="badge text-wrap bg-main d-block rounded-pill p-3">Software Bug</span>
            </div>
        </div>
    </div>
</div>
