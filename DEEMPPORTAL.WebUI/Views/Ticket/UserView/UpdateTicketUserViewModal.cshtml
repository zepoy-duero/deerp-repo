@using DEEMPPORTAL.Domain.Ticket

@model TicketResponse

<!-- =========================================================
     EDIT / VIEW TICKET MODAL
========================================================= -->

<div class="modal fade"
     id="editTicketModal"
     tabindex="-1"
     aria-labelledby="editTicketModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">

        <div class="modal-content">

            <!-- =================================================
                 MODAL HEADER
            ================================================== -->

            <div class="modal-header bg-main">

                <div>

                    <h5 class="modal-title fw-bold"
                        id="editTicketModalLabel">

                        <i class="bi bi-ticket-detailed-fill me-2"></i>

                        Ticket Details

                    </h5>

                    <small id="editTicketModalSubtitle"
                           class="text-white-50">

                        View and manage your ticket

                    </small>

                </div>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <!-- =================================================
                 MODAL BODY
            ================================================== -->

            <div class="modal-body bg-light">

                <div class="container-fluid">

                    <div class="row g-3">

                        <!-- =====================================
                             LEFT SIDE
                        ====================================== -->

                        <div class="col-lg-8">


                            <!-- =================================
                                 TICKET INFORMATION
                            ================================== -->

                            <div class="card border-0 shadow-sm mb-3">

                                <div class="card-header bg-white">

                                    <h6 class="mb-0 fw-bold text-main">

                                        <i class="bi bi-info-circle-fill me-2"></i>

                                        Ticket Information

                                    </h6>

                                </div>


                                <div class="card-body">

                                    <div class="row g-3">


                                        


                                        <!-- Requested Date -->
                                        <div class="col-md-4">

                                            <label class="form-label small fw-bold">
                                                Requested Date
                                            </label>

                                            <input type="text"
                                                   id="EditRequestedDate"
                                                   class="form-control form-control-sm bg-light"
                                                   value="@Model?.RequestedDate?.ToString("dd-MMM-yyyy hh:mm tt")"
                                                   readonly />

                                        </div>


                                        <!-- Requested By -->
                                        <div class="col-md-4">

                                            <label class="form-label small fw-bold">
                                                Requested By
                                            </label>

                                            <input type="text"
                                                   id="EditRequestedByName"
                                                   class="form-control form-control-sm bg-light"
                                                   value="@Model?.RequestedByName"
                                                   readonly />

                                            <input type="hidden"
                                                   id="EditRequestedByCode"
                                                   value="@Model?.RequestedByCode" />

                                        </div>


                                        <!-- Ticket Subject -->
                                        <div class="col-12">

                                            <label class="form-label small fw-bold">

                                                Ticket Subject

                                                <span class="text-danger">
                                                    *
                                                </span>

                                            </label>

                                            <input type="text"
                                                   id="EditTicketSubject"
                                                   name="TicketSubject"
                                                   class="form-control form-control-sm"
                                                   value="@Model?.TicketSubject"
                                                   maxlength="250"
                                                   readonly />

                                        </div>


                                        <!-- Description -->
                                        <div class="col-12">

                                            <label class="form-label small fw-bold">

                                                Ticket Description

                                                <span class="text-danger">
                                                    *
                                                </span>

                                            </label>

                                            <textarea id="EditTicketDescription"
                                                      name="TicketDescription"
                                                      class="form-control"
                                                      rows="8"
                                                      readonly>@Model?.TicketDescription</textarea>

                                        </div>

                                    </div>

                                </div>

                            </div>


                            <!-- =================================
                                 ATTACHMENTS
                            ================================== -->

                            <div class="card border-0 shadow-sm mb-3">

                                <div class="card-header bg-white">

                                    <div class="d-flex justify-content-between align-items-center">

                                        <h6 class="mb-0 fw-bold text-main">

                                            <i class="bi bi-paperclip me-2"></i>

                                            Attachments

                                        </h6>


                                        <button type="button"
                                                id="btnAddTicketAttachment"
                                                class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-plus-lg me-1"></i>

                                            Add Attachment

                                        </button>

                                    </div>

                                </div>


                                <div class="card-body">


                                    <!-- Existing attachments -->

                                    <div id="ticketAttachmentsContainer">

                                        <div id="ticketAttachmentsEmpty"
                                             class="text-center text-muted py-4">

                                            <i class="bi bi-paperclip fs-3 d-block mb-2"></i>

                                            No attachments

                                        </div>

                                    </div>


                                    <!-- New attachments -->

                                    <div id="newTicketAttachments"
                                         class="mt-3 d-none">

                                        <label class="form-label small fw-bold">

                                            Select Files

                                        </label>

                                        <input type="file"
                                               id="EditTicketAttachments"
                                               name="TicketAttachments"
                                               class="form-control form-control-sm"
                                               multiple
                                               accept=".jpg,.jpeg,.png,.pdf,.txt,.doc,.docx,.xls,.xlsx,.csv" />

                                        <small class="text-muted">

                                            Allowed:
                                            JPG, JPEG, PNG, PDF, TXT, DOC,
                                            DOCX, XLS, XLSX, CSV

                                        </small>

                                    </div>

                                </div>

                            </div>


                            <!-- =================================
                                 CORRESPONDENCE
                            ================================== -->

                            <div class="card border-0 shadow-sm">

                                <div class="card-header bg-white">

                                    <div class="d-flex justify-content-between align-items-center">

                                        <h6 class="mb-0 fw-bold text-main">

                                            <i class="bi bi-chat-left-text-fill me-2"></i>

                                            Correspondence

                                        </h6>

                                    </div>

                                </div>


                                <div class="card-body">


                                    <!-- Conversation Timeline -->

                                    <div id="ticketCorrespondenceContainer"
                                         class="mb-3">

                                        <div class="text-center text-muted py-4">

                                            <div class="spinner-border spinner-border-sm"
                                                 role="status">

                                                <span class="visually-hidden">
                                                    Loading...
                                                </span>

                                            </div>

                                            <div class="mt-2">

                                                Loading correspondence...

                                            </div>

                                        </div>

                                    </div>


                                    <!-- New Correspondence -->

                                    <div class="border-top pt-3">

                                        <label class="form-label small fw-bold">

                                            Add Correspondence

                                        </label>

                                        <textarea id="TicketCorrespondenceMessage"
                                                  class="form-control"
                                                  rows="4"
                                                  placeholder="Enter your message..."></textarea>


                                        <!-- Correspondence Attachments -->

                                        <div class="mt-2">

                                            <input type="file"
                                                   id="CorrespondenceAttachments"
                                                   class="form-control form-control-sm"
                                                   multiple
                                                   accept=".jpg,.jpeg,.png,.pdf,.txt,.doc,.docx,.xls,.xlsx,.csv" />

                                        </div>


                                        <!-- Send -->

                                        <div class="text-end mt-2">

                                            <button type="button"
                                                    id="btnSendCorrespondence"
                                                    class="btn btn-sm btn-main text-white">

                                                <i class="bi bi-send-fill me-1"></i>

                                                Send

                                            </button>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- =====================================
                             RIGHT SIDE
                        ====================================== -->

                        <div class="col-lg-4">


                            <!-- =================================
                                 STATUS
                            ================================== -->

                            <div class="card border-0 shadow-sm mb-3">

                                <div class="card-header bg-white">

                                    <h6 class="mb-0 fw-bold text-main">

                                        <i class="bi bi-activity me-2"></i>

                                        Ticket Status

                                    </h6>

                                </div>


                                <div class="card-body">

                                    <div class="text-center mb-3">

                                        <span id="EditTicketStatusBadge"
                                              class="badge rounded-pill bg-secondary fs-6 px-3 py-2">

                                            Loading...

                                        </span>

                                    </div>


                                    <input type="hidden"
                                           id="EditStatusCode"
                                           value="@Model?.StatusCode" />

                                </div>

                            </div>


                            <!-- =================================
                                 ASSIGNMENT
                            ================================== -->

                            <div class="card border-0 shadow-sm mb-3">

                                <div class="card-header bg-white">

                                    <h6 class="mb-0 fw-bold text-main">

                                        <i class="bi bi-person-check-fill me-2"></i>

                                        Assignment

                                    </h6>

                                </div>


                                <div class="card-body">


                                    <label class="form-label small fw-bold">
                                        Assigned To
                                    </label>

                                    <input type="hidden"
                                           id="EditAssignedToCode"
                                           value="@Model?.AssignedToCode" />

                                    <input type="text"
                                           id="EditAssignedToName"
                                           class="form-control form-control-sm bg-light"
                                           value="@Model?.AssignedToName"
                                           readonly />


                                </div>

                            </div>


                            <!-- =================================
                                 PRIORITY
                            ================================== -->

                            <div class="card border-0 shadow-sm mb-3">

                                <div class="card-header bg-white">

                                    <h6 class="mb-0 fw-bold text-main">

                                        <i class="bi bi-flag-fill me-2"></i>

                                        Priority

                                    </h6>

                                </div>


                                <div class="card-body">

                                    <input type="hidden"
                                           id="EditPriorityCode"
                                           value="@Model?.PriorityCode" />

                                    <span id="EditPriorityBadge"
                                          class="badge bg-secondary">

                                        Loading...

                                    </span>

                                </div>

                            </div>


                            <!-- =================================
                                 TASK TYPE
                            ================================== -->

                            <div class="card border-0 shadow-sm mb-3">

                                <div class="card-header bg-white">

                                    <h6 class="mb-0 fw-bold text-main">

                                        <i class="bi bi-list-task me-2"></i>

                                        Task Type

                                    </h6>

                                </div>


                                <div class="card-body">

                                    <input type="hidden"
                                           id="EditTaskTypeCode"
                                           value="@Model?.TaskTypeCode" />

                                    <span id="EditTaskTypeName"
                                          class="text-muted">

                                        Loading...

                                    </span>

                                </div>

                            </div>


                            <!-- =================================
                                 TICKET TIMELINE
                            ================================== -->

                            <div class="card border-0 shadow-sm">

                                <div class="card-header bg-white">

                                    <h6 class="mb-0 fw-bold text-main">

                                        <i class="bi bi-clock-history me-2"></i>

                                        Activity

                                    </h6>

                                </div>


                                <div class="card-body">

                                    <div id="ticketActivityTimeline">

                                        <div class="text-center text-muted">

                                            No activity available.

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 MODAL FOOTER
            ================================================== -->

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        data-bs-dismiss="modal">

                    <i class="bi bi-x-lg me-1"></i>

                    Close

                </button>

                <button type="button"
                        id="btnSaveTicketChanges"
                        class="btn btn-sm btn-main text-white d-none">

                    <i class="bi bi-check-lg me-1"></i>

                    Save Changes

                </button>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     ATTACHMENT PREVIEW MODAL
========================================================= -->

<div class="modal fade"
     id="ticketAttachmentPreviewModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-fullscreen">

        <div class="modal-content">

            <div class="modal-header bg-main">

                <h5 id="ticketAttachmentPreviewTitle"
                    class="modal-title text-white">

                    Attachment Preview

                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body p-0">

                <div id="ticketAttachmentPreviewContent"
                     class="w-100 h-100 d-flex justify-content-center align-items-center">
                </div>

            </div>

        </div>

    </div>

</div>