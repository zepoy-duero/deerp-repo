<style scoped>
    #userCorrespondenceContainer {
        height: calc(100vh - 210px);
        max-height: none !important;
        padding: 20px;
        overflow-y: auto;
    }

    
    .corr-msg {
        border-radius: 10px !important;
        max-width: 80%;
        line-height: 1.55;
    }
    .msg-agent .corr-msg {
        background: var(--ticket-primary) !important;
    }
</style>
<div class="modal-body position-relative" data-bs-spy="scroll">
    <div class="row g-0">
        <!-- =========================================
        MAIN CONTENT
        ========================================== -->
        <div class="col-7">
            <div class="h-100">
                <form id="editTicketForm" novalidate>
                    <!-- USER REQUEST -->
                    <div class="card h-100">
                        <div class="card-header section-title d-flex align-items-center justify-content-between">
                            <span>
                                Details
                            </span>
                            <div class="form-check form-switch mb-0 d-none">
                                <input class="form-check-input"
                                       type="checkbox"
                                       role="switch"
                                       id="toggleEditUserRequest" />
                                <label class="form-check-label"
                                       for="toggleEditUserRequest">
                                    Edit mode
                                </label>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <!-- SUBJECT -->
                                <div class="col-12">
                                    <label class="form-label">
                                        Ticket Subject
                                        <span class="text-danger">*</span>
                                    </label>
                                    <input id="ticketSubject"
                                           class="form-control-plaintext"
                                           disabled>
                                </div>
                                <!-- REQUESTED BY -->
                                <div class="col-lg-6 col-md-6">
                                    <label class="form-label">
                                        Requested By
                                    </label>
                                    <input id="editRequestedByCode"
                                           class="d-none">
                                    <input id="editRequestedByName"
                                           class="d-none">
                                    <div class="dropdown">
                                        <button type="button"
                                                id="displayRequestedByName"
                                                class="form-control text-truncate"
                                                data-bs-toggle="dropdown"
                                                disabled>
                                            text-start
                                            Jeffvil Duero
                                        </button>
                                        <div class="dropdown-menu w-100 p-2">
                                            <input type="text"
                                                   id="userSearchInput"
                                                   class="form-control mb-2"
                                                   placeholder="Search employee...">
                                            <ul id="userList"
                                                class="list-unstyled mb-0 p-1"
                                                style="max-height:220px;overflow-y:auto;">
                                                <!-- Existing generated users -->
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                                <!-- REQUESTED DATE -->
                                <div class="col-lg-6 col-md-6">
                                    <label class="form-label">
                                        Requested Date
                                    </label>
                                    <input id="displayRequestedDate"
                                           class="form-control-plaintext text-muted"
                                           disabled>
                                    <input id="editRequestedDate"
                                           name="editRequestedDate"
                                           type="date"
                                           class="form-control d-none">
                                </div>
                                <!-- DESCRIPTION -->
                                <div class="col-12">
                                    <label for="editTicketDescription"
                                           class="form-label">
                                        Description
                                    </label>
                                    <textarea id="editTicketDescription"
                                              class="form-control"
                                              placeholder="Detailed description">
                                    </textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <!-- =========================================
        RIGHT SIDEBAR
        ========================================== -->
        <div class="col-5">
            <div class="h-100">
                @{
                    await Html.RenderPartialAsync("~/Views/Ticket/UserView/UserViewCards.cshtml");
                }
                <div class="d-flex flex-row">
                    <div class="card w-75">
                        <div class="card-header section-title d-flex align-items-center justify-content-between">
                            <span class="me-2">
                                Attachments
                            </span>
                            <button id="addAttachmentBtn"
                                    type="button"
                                    class="btn py-1 btn-sm btn-outline-main">
                                <i class="bi bi-plus text-small me-1"></i>
                                ADD
                            </button>
                        </div>
                        <div class="card-body">
                            <!-- Hidden file input for edit modal -->
                            <input id="editTicketAttachments" type="file" class="d-none" multiple accept=".png,.jpeg,.jpg,.gif,.pdf,.xls,.xlsx" />
                            <div id="attachmentsPreviewContainer"
                                 class="mt-2" style="height: 180px !important;overflow-y: scroll !important;">
                                <!-- Existing attachment renderer -->
                            </div>
                        </div>
                    </div>
                   
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-7">
          @{
                await Html.RenderPartialAsync("~/Views/Ticket/UserView/_UserCorrespondence.cshtml");
          }
        </div>
    </div>
</div>