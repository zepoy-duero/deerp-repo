```cshtml
@{
    Layout = "_Layout";
    ViewData["Title"] = "My Tickets";
}

<!-- =========================================================
     CREATE TICKET MODAL
========================================================= -->
@{
    await Html.RenderPartialAsync(
        "~/Views/Ticket/_CreateTicketModal.cshtml"
    );
}


<!-- =========================================================
     VIEW TICKET HISTORY MODAL
========================================================= -->
@{
    await Html.RenderPartialAsync(
        "~/Views/Ticket/UserView/UpdateTicketUserViewModal.cshtml"
    );
}


<!-- =========================================================
     SEND EMAIL / CORRESPONDENCE MODAL
========================================================= -->
@{
    await Html.RenderPartialAsync(
        "~/Views/Ticket/UpdateTicketComponents/SendEmailEditorModal.cshtml"
    );
}


<!-- =========================================================
     FILE PREVIEW MODAL
========================================================= -->

<div class="modal fade"
     id="filePreviewModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-fullscreen modal-dialog-scrollable">

        <div class="modal-content">

            <div class="modal-header bg-main">

                <h5 class="modal-title text-white"
                    id="preview-filename">

                    File Preview

                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body p-0"
                 style="height:100vh;">

                <div id="file-preview-zone"
                     class="w-100 h-100 d-flex align-items-center justify-content-center">
                </div>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     MAIN CONTENT
========================================================= -->

<div class="container">

    <div class="page-inner"
         id="pageInner"
         style="height:100% !important; overflow:auto;">

        <!-- =================================================
             PAGE HEADER
        ================================================== -->

        <div class="row align-items-center mb-3">

            <div class="col-md-7">

                <h5 class="page-title mb-1 fs-5 fw-bolder text-main">

                    <i class="bi bi-ticket-detailed-fill me-2"></i>

                    My Tickets

                </h5>

                <small class="text-muted">

                    View and monitor your submitted requests

                </small>

            </div>


            <!-- Total -->
            <div class="col-md-5 text-md-end">

                <div id="TicketsTotal"
                     class="d-inline-block">

                    <div class="btn rounded-pill bg-main text-white">

                        <div class="spinner-border spinner-border-sm"
                             role="status">

                            <span class="visually-hidden">
                                Loading...
                            </span>

                        </div>

                        <span class="blink align-middle ms-2">
                            Loading...
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- =================================================
             SUMMARY
        ================================================== -->

        <div class="row g-3 mb-4">


            <!-- Submitted -->

            <div class="col-xl-3 col-md-6">

                <div class="card border-0 shadow-sm">

                    <div class="card-body">

                        <div class="d-flex justify-content-between">

                            <div>

                                <small class="text-muted">
                                    Submitted
                                </small>

                                <h4 id="TicketsSubmitted"
                                    class="fw-bold mb-0">

                                    0

                                </h4>

                            </div>

                            <div class="rounded-circle
                                        bg-secondary
                                        bg-opacity-10
                                        p-3">

                                <i class="bi bi-send-fill
                                          text-secondary
                                          fs-5">
                                </i>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- In Progress -->

            <div class="col-xl-3 col-md-6">

                <div class="card border-0 shadow-sm">

                    <div class="card-body">

                        <div class="d-flex justify-content-between">

                            <div>

                                <small class="text-muted">
                                    In Progress
                                </small>

                                <h4 id="TicketsInProgress"
                                    class="fw-bold mb-0">

                                    0

                                </h4>

                            </div>

                            <div class="rounded-circle
                                        bg-primary
                                        bg-opacity-10
                                        p-3">

                                <i class="bi bi-arrow-repeat
                                          text-primary
                                          fs-5">
                                </i>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Completed -->

            <div class="col-xl-3 col-md-6">

                <div class="card border-0 shadow-sm">

                    <div class="card-body">

                        <div class="d-flex justify-content-between">

                            <div>

                                <small class="text-muted">
                                    Completed
                                </small>

                                <h4 id="TicketsCompleted"
                                    class="fw-bold mb-0">

                                    0

                                </h4>

                            </div>

                            <div class="rounded-circle
                                        bg-success
                                        bg-opacity-10
                                        p-3">

                                <i class="bi bi-check-circle-fill
                                          text-success
                                          fs-5">
                                </i>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Total -->

            <div class="col-xl-3 col-md-6">

                <div class="card border-0 shadow-sm">

                    <div class="card-body">

                        <div class="d-flex justify-content-between">

                            <div>

                                <small class="text-muted">
                                    Total Tickets
                                </small>

                                <h4 id="TicketsTotalCount"
                                    class="fw-bold mb-0">

                                    0

                                </h4>

                            </div>

                            <div class="rounded-circle
                                        bg-main
                                        bg-opacity-10
                                        p-3">

                                <i class="bi bi-ticket-perforated-fill
                                          text-main
                                          fs-5">
                                </i>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =================================================
             TICKET CARD CONTAINER
        ================================================== -->

        <div class="card border-0 shadow-sm">

            <!-- Card Header -->

            <div class="card-header bg-white">

                <div class="row align-items-center">

                    <div class="col-md-6">

                        <h6 class="fw-bold text-main mb-0">

                            <i class="bi bi-list-ul me-2"></i>

                            Submitted Tickets

                        </h6>

                        <small class="text-muted">

                            Your submitted support requests

                        </small>

                    </div>


                    <!-- New Ticket -->

                    <div class="col-md-6 text-md-end mt-2 mt-md-0">

                        <button type="button"
                                id="openCreateTicketModal"
                                class="btn btn-sm btn-danger text-white"
                                data-bs-toggle="modal"
                                data-bs-target="#createTicketModal">

                            <i class="bi bi-plus-lg me-1"></i>

                            New Ticket

                        </button>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 FILTERS
            ================================================== -->
            @{
                await Html.RenderPartialAsync("~/Views/Ticket/UserView/UpdateTicketUserViewModal.cshtml");
            }
            @{
                await Html.RenderPartialAsync("~/Views/Ticket/UserView/_TicketTableFilters.cshtml");
            }
            @{
                await Html.RenderPartialAsync("~/Views/Ticket/UserView/_TicketTable.cshtml");
            }


            <!-- =================================================
                 TICKET CARDS
            ================================================== -->

            <div class="card-body">
                <div class="row align-items-center mt-3">
                    <div class="col-7">

                        <div class="card h-100 border-0 shadow-sm ticket-card">

                            <div class="card-body">

                                <div class="d-flex justify-content-between align-items-start mb-2">

                                    <div>

                                        <span class="small fw-bold text-main">
                                            MIS-0001
                                        </span>

                                        <div class="small text-muted">
                                            22-Sep-2026 09:30 AM
                                        </div>

                                    </div>

                                    <span class="badge rounded-pill bg-primary">
                                        In Progress
                                    </span>

                                </div>
                                <h6 class="fw-bold mb-2">
                                    Printer cannot print
                                </h6>
                                <div class="d-flex justify-content-between align-items-start mb-2">

                                    <div>

                                        <p class="text-muted small mb-3">

                                            Printer is showing an error when attempting
                                            to print documents...

                                        </p>

                                    </div>

                                    <small class="text-muted">

                                        <i class="bi bi-paperclip me-1"></i>
                                        2 attachments

                                    </small>

                                </div>
                                <div class="row g-2 small mb-3">

                                    <div class="col-6">

                                        <i class="bi bi-grid me-1"></i>

                                        Hardware Maintenance

                                    </div>

                                    <div class="col-6">

                                        <i class="bi bi-flag me-1"></i>

                                        <span class="text-danger fw-semibold">
                                            High
                                        </span>

                                    </div>

                                    <div class="col-12">

                                        <i class="bi bi-person me-1"></i>

                                        Assigned to:
                                        <strong>John Doe</strong>

                                    </div>

                                </div>


                                <div class="border-top pt-2 mb-3">

                                    <div class="d-flex justify-content-between">

                                        <small class="text-muted">

                                            <i class="bi bi-chat-left-text me-1"></i>
                                            3 messages

                                        </small>



                                    </div>

                                </div>


                                <div class="d-flex justify-content-between align-items-center">

                                    <small class="text-muted">

                                        Updated 10 mins ago

                                    </small>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary btn-view-ticket-history"
                                            data-ticket-no="125">

                                        <i class="bi bi-clock-history me-1"></i>

                                        View History

                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>
                </div>
                <!-- =================================================
                     PAGINATION
                ================================================== -->

                <div class="row align-items-center mt-3">

                    <div class="col-md-6">

                        <small id="ticketRecordInfo"
                               class="text-muted">

                            Showing 0 tickets

                        </small>

                    </div>

                    <div class="col-md-6">

                        <nav>

                            <ul id="ticketPagination"
                                class="pagination pagination-sm
                                       justify-content-md-end
                                       mb-0">
                            </ul>

                        </nav>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     SCRIPTS
========================================================= -->
@section Scripts {

    <script src="~/js/ticket/ticket-correspondence.js"
            asp-append-version="true">
    </script>

    <script src="~/js/ticket/ticket-event-handlers.js"
            asp-append-version="true">
    </script>

    <script src="~/js/ticket/ticket.js"
            asp-append-version="true">
    </script>

}


