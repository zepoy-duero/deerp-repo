<!-- Edit Ticket Modal -->

<style>
    .section-title {
        font-weight: 600;
        font-size: 16px;
        margin-bottom: 15px;
    }
</style>
<div class="modal fade" id="ticketDetailsModal" tabindex="-1" aria-labelledby="ticketDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog  modal-fullscreen">
        <div class="modal-content ">
            <div class="modal-header small fw-bold bg-main-gradient text-white rounded-top">
                <span class="modal-title fs-6" id="editTicketModalLabel">
                    Update Ticket - 
                    MIS#0001
                 </span>
                
                <button type="button" class="btn-close rounded-1" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="list-example" class="list-group">
                    <a class="list-group-item list-group-item-action d-flex align-items-center" href="#ticketUserRequest">
                        <i class="bi bi-person-circle me-2"></i>
                        User Request
                    </a>
                    <a class="list-group-item list-group-item-action d-flex align-items-center" href="#ticketAssignedTo">
                        <i class="bi bi-person-down me-2"></i>
                        <span> Assigned To</span>

                    </a>
                    <a class="list-group-item list-group-item-action d-flex align-items-center" href="#ticketApproval">
                        <i class="bi bi-hand-thumbs-up me-2"></i>
                        Approvals
                    </a>
                    <a class="list-group-item list-group-item-action d-flex align-items-center" href="#ticketReview">

                        <i class="bi bi-list-stars me-2"></i>
                        Review
                    </a>
                </div>
                <div data-bs-spy="scroll" data-bs-target="#list-example" data-bs-offset="0" class="scrollspy-example" tabindex="0">
                    @{

                        await Html.RenderPartialAsync("~/Views/Ticket/TicketDetailsComponents/UserRequest.cshtml");
                        await Html.RenderPartialAsync("~/Views/Ticket/TicketDetailsComponents/Approvals.cshtml");

                        await Html.RenderPartialAsync("~/Views/Ticket/TicketDetailsComponents/Assignment.cshtml");

                        await Html.RenderPartialAsync("~/Views/Ticket/TicketDetailsComponents/Review.cshtml");
                    }
                </div>
                        
            </div>

            <!-- FOOTER -->

            @* <div class="modal-footer overflow-x-visible">
          
                <button class="btn btn-secondary" data-bs-dismiss="modal" aria-label="Close">Close</button>
            </div> *@
        </div>
       
    </div>
</div>
@* @section Scripts {
    <script src="~/js/ticket/ticket.js"></script>
} *@
