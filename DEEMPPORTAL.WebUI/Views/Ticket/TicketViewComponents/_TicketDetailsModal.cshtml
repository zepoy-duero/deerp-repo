<!-- Edit Ticket Modal -->
<style>
    .modal-body {
        padding: 0;
    }

    

    .scrollspy-container {
        height: 75vh;
        overflow-y: auto;
        padding: 20px;
    }

    .section-card {
        border-radius: 12px;
    }

    .section-title {
        font-weight: 600;
        border-bottom: 2px solid #dee2e6;
        margin-bottom: 15px;
        padding-bottom: 5px;
    }

    .nav-link.active {
        background-color: #0d6efd;
        color: #fff !important;
    }

    .profile-summary {
        padding: 15px;
        border-bottom: 1px solid #dee2e6;
    }
</style>
<div class="modal modal-xl fade" id="editTicketModal" tabindex="" aria-labelledby="editTicketModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable" style="max-height: 80vh !important;">
        <div class="modal-content">
            <div class="modal-header small fw-bold bg-main-gradient text-white rounded-top">
                <span class="modal-title fs-6 d-flex" id="editTicketModalLabel">
                    Update Ticket - 
                  
                    MIS#0001
                 </span>
                
                <button type="button" class="btn-close rounded-1" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="modal-body">

                <div class="row g-0">

                    <!-- LEFT SIDEBAR -->
                    <div class="col-md-3 bg-light">

                        <!-- PROFILE SUMMARY -->
                        @* <div class="profile-summary">
                            <h6 class="mb-1">Status</h6>
                            <span class="badge fs-6 bg-warning ">In Progress</span>
                            <hr>

                            <small><strong>Requested By:</strong> Juan Dela Cruz</small><br>
                            <small><strong>Date:</strong> March 24, 2026</small><br>
                            <small><strong>Priority:</strong> High</small>
                        </div> *@

                        <!-- NAV -->
                        <nav id="ticketNav" class="nav nav-pills flex-column p-3">
                            <a class="nav-link" href="#userRequest">User Request</a>
                            <a class="nav-link" href="#approvals">Approvals</a>
                            <a class="nav-link" href="#assignedTo">Assigned To</a>
                            <a class="nav-link" href="#ticketStatus">Status</a>
                            <a class="nav-link" href="#actionTaken">Action Taken</a>
                        </nav>
                    </div>

                    <!-- RIGHT CONTENT -->
                    <div class="col-md-9">
                        <div data-bs-spy="scroll"
                             data-bs-target="#ticketNav"
                             class="scrollspy-container">

                            <!-- USER REQUEST -->
                            <section id="userRequest" class="card section-card shadow-sm mb-3">
                                <div class="card-body">
                                    <h6 class="section-title">User Request</h6>
                                    
                                    <p><strong>Description:</strong> System error when submitting form</p>
                                    <p><strong>Type:</strong> Bug</p>

                                </div>
                            </section>

                            <!-- APPROVALS -->
                            <section id="approvals" class="card section-card shadow-sm mb-3">
                                <div class="card-body">
                                    <h6 class="section-title">Approvals</h6>
                                    <p><strong>Status:</strong> Approved</p>
                                    <p><strong>Remarks:</strong> Proceed with fix</p>
                                </div>
                            </section>

                            <!-- ASSIGNED -->
                            <section id="assignedTo" class="card section-card shadow-sm mb-3">
                                <div class="card-body">
                                    <h6 class="section-title">Assigned To</h6>
                                    <p><strong>Developer:</strong> John Developer</p>
                                    <p><strong>Priority:</strong> High</p>
                                    <p><strong>Task:</strong> Fix validation bug</p>
                                </div>
                            </section>

                            <!-- STATUS -->
                            <section id="ticketStatus" class="card section-card shadow-sm mb-3">
                                <div class="card-body">
                                    <h6 class="section-title">Status</h6>
                                    <p><strong>Current:</strong> In Progress</p>
                                </div>
                            </section>

                            <!-- ACTION -->
                            <section id="actionTaken" class="card section-card shadow-sm mb-5">
                                <div class="card-body">
                                    <h6 class="section-title">Action Taken</h6>
                                    <p><strong>Start:</strong> March 24, 2026</p>
                                    <p><strong>Finish:</strong> March 25, 2026</p>
                                    <p><strong>Notes:</strong> Fix applied, testing ongoing</p>
                                </div>
                            </section>

                        </div>
                    </div>

                </div>

            </div>

            <!-- FOOTER -->
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
