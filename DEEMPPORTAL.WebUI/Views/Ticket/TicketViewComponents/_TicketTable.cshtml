        <div class="row g-0">
            <div class="col">
            <div class="card">
            <div id="" class="row d-flex align-items-center buttons-toolbar p-3">
                <!-- Left side: New Ticket -->
                <div class="col-auto">
                    <button type="button" id="openCreateTicketModal" class="btn btn-danger rounded-1" data-bs-toggle="modal" data-bs-target="#createTicketModal">
                        <i class="fas fa-plus"></i> New Ticket
                    </button>
                </div>

                <!-- Right side: Filters + Search -->
                <div id="" class="col-auto ms-auto d-flex gap-2">
                    <div class="input-group ">
                        <input name="search" id="inpSearchParam" type="text" class="form-control" placeholder="Type to search . . ." aria-label="Search">
