<style>
    #statusBadge {
        opacity: 50%;
    }
   

    .ph-item,
    .ph-picture {
        width: 100%;
        height: 100%;
        padding: 0;
        margin: 0;
    }
    .page-item, .active{
        background-color: transparent !important;
    }
        .newly-inserted-row {
        background-color: #fff3cd !important; /* Warning/yellow background */
        transition: background-color 2s ease-out;
    }

</style>
<div class="container-fluid">

    <table id="ticketsTable"
           data-toggle="table"
           data-search-selector="#customSearch"
           data-filter-control="true"
           data-filter-control-container="#filtersContainer"
           data-resizable="true"
           data-toolbar="#toolbar"
           data-height="620"
           data-show-button-text="true"
           data-buttons-class="mx-2"
           data-show-columns="true"
           data-show-columns-toggle-all="true"
           data-show-fullscreen="true"
           data-search="true"
         
           data-pagination="true"
           data-pagination-pre-text="Previous"
           data-pagination-next-text="Next"
           data-page-number="2"
           data-filter-control-search-clear="true"
           data-loading-template="loadingTemplate"

           data-classes="table table-bordered table-striped table-sm pg-primary">
        <thead class="table-light table-sm">
            <tr>
                <th data-checkbox="true"
                    data-halign="center">
                </th>

                <th data-field="StringTicketId"
                    data-halign="center"
                    data-searchable="true"
                    data-sortable="true"
                    data-formatter="IdFormatter"
                   
                    data-filter-control="input"
               
                    data-filter-control-placeholder="Search . ."
                    class="text-nowrap">
                    Ticket ID
                </th>
                <th data-field="RequestedByName"
                    data-halign="center"
                    data-sortable="true"
                    data-filter-control="select"
                    data-filter-control-placeholder="All"
                    class="text-nowrap p-0 m-0">
                    Requested By
                </th>

                <th data-field="TicketSubject"
                    data-halign="center"
                    data-sortable="true"
                    class="text-nowrap p-0 m-0">
                    Subject
                </th>

                <th data-field="AssignedToName"
                    data-halign="center"
                    data-sortable="true"
                    data-filter-control="select"
                    data-filter-control-placeholder="All"
                    class="text-nowrap p-0 m-0">
                    Assigned To
                </th>
                <th data-field="DeptName"
                    data-halign="center"
                    data-sortable="true"
                    data-filter-control="select"
                    data-filter-control-placeholder="All"
                    class="text-nowrap ">
                    Department
                </th>
                <th data-field="RequestedDate"
                    data-halign="center"
                    data-sortable="true"
                    data-formatter="dateFormatter"
                    data-filter-control="select"
                    data-filter-data-collector="customDateCollector"
                    data-filter-control-placeholder="All"
                    class="text-nowrap p-0 m-0">
                    Requested Date
                </th>
                <th data-field="TaskTypeName"
                    data-halign="center"
                    data-sortable="true"
                    data-filter-control="select"
                    data-filter-control-placeholder="All"
                    class="text-nowrap p-0 m-0">
                    Request Type
                </th>
                <th data-field="StatusName"
                    data-halign="center"
                    data-sortable="true"
                    data-formatter="statusFormatter"
                    data-filter-control="select"
                    data-filter-control-placeholder="All"
                    class="text-nowrap p-0 m-0">
                    Status
                </th>

                <th data-field="TicketPriority"
                    data-halign="center"
                    data-sortable="true"
                    data-filter-control="select"
                    data-filter-control-placeholder="All"
                    class="text-nowrap p-0 m-0">
                    Priority
                </th>
            </tr>
        </thead>
    </table>
</div>
<script>

     window.statusFormatter = (value, row) => {
         if(value != null){
    return `<div class='btn ${statusColor(value)} btn-rounded  btn-sm w-100 text-nowrap'>${value}</div>`
         }

     }
     window.dateFormatter = (value, row) => {
         var d = moment(value).format("DD-MM-YYYY")
         return d;
     }
     window.IdFormatter = (value,row) =>{
                 return `<div class='text-main fw-bold text-decoration-underline text-nowrap'>${value}</div>`
         }
     window.loadingTemplate = () => {
      loadingTemplate
         // return '<div class="ph-item"><div class="ph-picture"></div></div>'
             return `<div class="progress">
      <div class="progress-bar" role="progressbar" style="width: 50%" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100"></div>
    </div>`

     }
      function customDateCollector(value) {
      if (!value) return [];

      // Split by comma, then trim whitespace from each generated tag item
      return value.split(',').map(function(item) {
         return moment(value).format("YYYY")
        
      });
    }
    function customSearchRow(text, value, field, data) {
              // If the filter input is empty, show all rows
                console.log(data)
                console.log(value)
                console.log(field)
                 
              if (!text) return true;

              // Convert both values to lowercase strings and trim spaces
              const searchString = text.toString().toLowerCase().trim();
              

              // Returns true only if the cell value starts with the typed text
              return data.TicketId.startsWith(searchString);
            }
     function statusColor(status) {
         switch (status) {
             case 'Not Scheduled': return 'text-dark';
                 break;
            case null: return 'd-none';
                 break;
             case 'In Progress': return 'text-danger';
                 break;
             case 'Testing': return 'text-primary';
                 break;
             case 'Maintenance': return 'text-warning dark';
                 break;
             case 'Complete': return 'text-green';
                 break;
         }
     }

</script>




