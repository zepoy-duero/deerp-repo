                            <i class="fas fa-search"></i>
                        </button> *@
                        <span class="input-group-text small ">
                            <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span
                          <button id="btnSearch" class="btn bg-accent me-0" type="button">
                            <i class="fas fa-search"></i>
                        </button>
                        </span>
                       
                    </div>
                    <div class="input-group input-group-sm">
                        <label for="dateFrom" class="input-group-text small">From</label>
                        <input id="dateFrom" type="date" class="form-control" aria-label="From">
                        <label for="dateTo" class="input-group-text small">To</label>
                        <input id="dateTo" type="date" class="form-control" aria-label="To">
                        <span class="input-group-text btn small">
                            <i class="fas fa-filter"></i>
                        </span>
                    </div>
                    @* <div class="input-group  w-75">
                        <label for="dateTo" class="input-group-text small">To</label>
