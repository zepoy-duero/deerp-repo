<div class="row d-sm-flex">
    <div class="col-sm-12">
        <div class="card text-small">

            <div id="ticketHeader2" class="card-header fw-bold bg-main text-white rounded-top-1">
                <div class="d-flex justify-content-between align-items-center">

                    <div class="d-flex">
                        <div class="small px-2">
                            <span class="btn btn-sm btn-icon btn-round border border-2 text-white"><i class="fas fa-ticket"></i></span>
                            <span id="tblCaption" class="fw-normal mx-2">My Tickets</span>
                        </div>

                    </div>
                    <div class="d-flex">
                        @{
                            await Html.RenderPartialAsync("~/Views/Ticket/TicketViewComponents/_TicketDashBoard.cshtml");
                        }
                    
                    </div>
                    
                </div>


            </div>

            <div id="cardbdy" class="card-body">

                <table id="tblTickets" class="table table-condensed table-responsive table-sm table-striped table-hover align-middle  no-box-shadow w-100">
                    <thead class="table-head  table-primary fw-bold" >
                        <tr>
                           
                            <th class="text-muted">
                                <i class="fas fa-ticket text-main"></i>
                                Ticket ID</th>
                            <th class="text-muted">
                                <i class="fas fa-user text-main"></i>
                                Requested By</th>
                            <th class="text-muted">
                                <i class="fas fa-circle-info text-main"></i>
                                Description</th>
                            <th class="text-muted">
                                <i class="fas fa-calendar-plus text-main"></i>
                                Date Submitted</th>
                            <th class="text-muted">
                                <i class="fas fa-bars-progress text-main"></i>
                                Status</th>


                        </tr>
                    </thead>
                    <tbody id="tblBody" class="table table-body" style="max-height: 400px;overflow-y: scroll">
                      
                    </tbody>
                    
                    
                </table>

            </div>


        </div>
    </div>
</div>