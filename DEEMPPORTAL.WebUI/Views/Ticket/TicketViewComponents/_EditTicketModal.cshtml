<style>
    .modal-body {
        padding: 0;
        height: calc(100vh - 56px);
        overflow: hidden;
    }

    .modal-content {
        height: 100vh;
    }

    /* Sidebar */
    .modalNavSidebar {
        position: relative;
        height: 100vh;
        background: #f8f9fa;
        
        padding: 15px 10px;
    }

    .nav-link {
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 14px;
        transition: 0.2s;
    }

        .nav-link:hover {
            background: #e9ecef;
        }

        .nav-link.active {
            background-color: #0d6efd;
            color: #fff !important;
        }

    /* Content */
    .content-scroll {
        height: 100%;
        overflow-y: auto;
        padding: 10px;
        background: #f4f6f9;
    }

    /* Section Cards */
    .section-card {
        border-radius: 12px;
        border: none;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        margin-bottom: 20px;
    }

    .section-title {
        font-weight: 600;
        font-size: 16px;
        margin-bottom: 15px;
    }

    textarea.form-control {
        height: 120px;
    }

    /* Attachments */
    .attachment-box {
        border: 2px dashed #ced4da;
        border-radius: 10px;
        padding: 20px;
        text-align: center;
        background: #fff;
        transition: 0.2s;
    }

        .attachment-box:hover {
            border-color: #0d6efd;
            background: #f8fbff;
        }

    /* Footer */
    .modal-footer {
        position: sticky;
        bottom: 0;
        background: #fff;
        border-top: 1px solid #dee2e6;
    }
</style>

