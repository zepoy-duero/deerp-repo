        border-color: #002e5a;
        color: white;

    }
    @*DATE CALENDAR*@
   
    .calendar-card {
        width: 52px; /* 260 / 5 */
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
        font-family: 'Segoe UI', sans-serif;
    }

    .calendar-header {
        background: linear-gradient(180deg, #5f8df7, #3d63d2);
        color: white;
        text-align: center;
        padding: 6px 2px;
        font-weight: 600;
        font-size: 10px;
        position: relative;
    }

        /* Rings scaled down */
        .calendar-header::before {
            content: "";
            position: absolute;
            top: -4px;
            left: 4px;
            width: 4px;
            height: 6px;
            background: #e0e0e0;
            border-radius: 3px;
            box-shadow: 10px 0 #e0e0e0, 20px 0 #e0e0e0, 30px 0 #e0e0e0;
        }

    .calendar-body {
        background: #f1f1f1;
        text-align: center;
        padding: 6px 2px;
    }

    .calendar-day {
        font-size: 22px; /* 110 / 5 */
        font-weight: 800;
        color: #1f2a5a;
        line-height: 1;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.2);
    }

