﻿<!-- Button trigger modal -->
<!-- Modal -->
<div class="modal fade" id="createTicketModal" tabindex="-1" aria-labelledby="createTicketModalLabel">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <!--HEADER-->
            <div class="modal-header small fw-bold bg-main text-white rounded-top">
                <span class="modal-title fs-6 mx-4" id="createTicketModalLabel">New Ticket</span>
                <button type="button" class="btn-close btn-close-white rounded-1" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <!--BODY-->
            <div class="modal-body">
                <div class="card no-box-shadow">

                    <div id="successAlert" class="alert alert-success d-none">
                        <div class="row">
                            <div class="col">
                                <i class="bi bi-check"></i>
                                <span class="text-end">
                                    You have successfully created a new ticket!
                                </span>
                            </div>
                            <div id="newTicketId" class="col-2 text-end fw-bold">
                                MIS#0001
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <!-- Ticket Info -->
                        <div class="container-fluid">
                            <!-- Requested By -->
                            <form id="createTicketForm" class="form needs-validation" novalidate>
                           
                                <div class="row gy-4 g-0 mb-2">
                                    <div class="col-md-6">
                                        @{
                                            await Html.RenderPartialAsync("~/Views/Ticket/TicketFormComponents/SelectRequestedBy.cshtml");
                                        }
                                    </div>
                                  

                                    <div class="col-md-6 d-flex justify-content-start align-items-start">
                                        <label class="text-muted pe-2 text-small">
                                            Date:
                                        </label>
                                        <h6 id="RequestedDate" class="fw-bold"></h6>
                                    </div>
                                </div>
                                <hr />
                                <div class="row gy-4 g-0 mb-2">
                                    <div class="col-md-6">
                                        @{
                                            await Html.RenderPartialAsync("~/Views/Ticket/TicketFormComponents/SelectOrganization.cshtml");
                                            // await Html.RenderPartialAsync("~/Views/Ticket/TicketFormComponents/SelectLocation.cshtml");
                                        }
                                    </div>
                                    <div class="col-md-6">
                                        @{
                                            await Html.RenderPartialAsync("~/Views/Ticket/TicketFormComponents/SelectLocation.cshtml");
                                        }
                                    </div>
                                </div>
                                <div class="row gy-4 mb-2">
                                   
                                    <div class="col-md-6">
                                        @{
                                            await Html.RenderPartialAsync("~/Views/Ticket/TicketFormComponents/SelectDepartment.cshtml");
                                       
                                        }
                                    </div>
                                    <div class="col-md-6">
                                        @{
                                         
                                            await Html.RenderPartialAsync("~/Views/Ticket/TicketFormComponents/SelectRequestType.cshtml");
                                        }
                                    </div>
                                </div>
                                <div class="row gy-4 g-0 mb-2">
                                    <div class="col-12">
                                        @{
                                            await Html.RenderPartialAsync("~/Views/Ticket/TicketFormComponents/InputTicketSubject.cshtml");
                                        }
                                    </div>
                                   
                                </div>

                                <div class="row gy-4 g-0 mb-2">
                                    <div class="col-12">
                                        <div>
                                            <label class="form-label">
                                                 <small class="extra-small text-danger">*</small>
                                                                Detailed description
                                                <span id="summernoteInvalidFeedback" class="text-danger text-small d-none">This field is required</span>
                                                </label>
                                          
                                         
                                                <div name="TicketDescription" id="TicketDescription"
                                                          placeholder="Explain the issue in detail..." required></div>
                                          
                                        </div>
                                    </div>
                                </div>
                                <div class="row g-0">
                                    <div class="col h-50">
                                        <div>
                                            <label for="fileInput" class="form-label">
                                                <i class="bi bi-images"></i>
                                                Upload attachment:</label>
                                            <div class="card shadow-sm pb-0 mb-0">
                                                <div class="card-body">
                                                    <!-- Drop Zone -->
                                                    <div id="dropZone" class="drop-zone">
                                                        <i class="bi bi-cloud-upload"></i>
                                                        <p class="mb-1"><strong>DRAG & DROP or PASTE Screenshots here</strong></p>
                                                        <p class="text-muted mb-2">or click to browse</p>
                                                        <input type="file" id="TicketAttachments" hidden multiple
                                                               accept=".png,.pdf,.xls,.xlsx">
                                                    </div>
                                                    <!-- Preview List -->
                                                    <div id="previewContainer" class="mt-2"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                               
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <!-- FOOTER -->
            <div class="modal-footer text-end">
                <a id="cancelBtn" data-bs-dismiss="modal" class="btn btn-outline-secondary">
                    Cancel
                </a>
                <button 
                    id="submitTicket" 
                    type="submit" 
                    class="btn btn-danger px-2" 
                    aria-label="Fill all the required fields"
                    data-bs-toggle="tooltip" 
                    data-bs-placement="top"
                        title="Fill all the required fields">
                    Submit Ticket
                </button>
               
            </div>
        </div>
    </div>
</div>
<style>
    .drop-zone {
        border: 2px dashed #6c757d;
        border-radius: 10px;
        padding: 40px;
        text-align: center;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

        .drop-zone.dragover {
            background-color: #e9ecef;
        }

    .file-preview-item {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 10px;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .file-info {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .file-icon {
        width: 40px;
        height: 40px;
        object-fit: cover;
    }
</style>
