<style >
    .drop-zone {
        border: 2px dashed #6c757d;
        border-radius: 10px;
        padding: 0px;
        text-align: center;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

        .drop-zone.dragover {
            background-color: lightcyan;
        }

    .custom-thumbnail-hover {
        /* Smooth exit transition when the mouse leaves */
        transition: all 0.4s ease-in-out;
    }

        .custom-thumbnail-hover:hover {
            position: fixed;
            top: 50%;
            left: 50%;
            /* Centers the image perfectly in the viewport and enlarges it */
            transform: translate(-50%, -50%) scale(5);
            z-index: 9999; /* Forces it above all other content, navbars, and text */
            box-shadow: 0 2rem 4rem rgba(0, 0, 0, 0.4); /* Deep dramatic shadow */
            /* Optional: Ensures the image fits within the viewport on mobile screens */
            max-width: 100vw;
            max-height: 100vh;

        }
    .file-preview-item {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 10px;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .file-info {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .file-icon {
        width: 40px;
        height: 40px;
        object-fit: cover;
    }
    /* Change the tooltip body background and text color */
    .tooltip .tooltip-inner {
        background-color: black; /* Your custom color (e.g., Bootstrap Primary Blue) */
        color: #ffffff;
    } 
    .custom-tooltip {
        position: relative;
    }

        .custom-tooltip::before {
            content: "";
            position: absolute;
            bottom: 100%; /* Position right above the div */
            right: 20px; /* Adjust horizontal position of the arrow */
            border-width: 6px;
            border-style: solid;
            border-color: transparent transparent #000000 transparent; /* Points up, colored black */
        }
   
</style>


<!-- Modal -->
<div class="modal fade" id="createTicketModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="createTicketModalLabel" aria->
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
          
            <!--HEADER-->
            <div class="modal-header small fw-bold bg-main text-white rounded-top">
                <span class="modal-title fs-6 mx-4" id="createTicketModalLabel">New Ticket</span>
                <button type="button" class="btn-close btn-close-white rounded-1" data-bs-dismiss="modal" aria-label="Close"></button>
                
            </div>
            @* <div class="progress w-100">
                <div class="progress-bar w-75  h-auto" role="progressbar" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
            </div> *@
            <!--BODY-->
            <div class="modal-body">
                    <form id="createTicketForm" class="form needs-validation" novalidate>
                        <div class="card no-box-shadow">                                                
                            <div class="card-body">
                                <!-- Ticket Info -->
                            
                            <!-- Requested By -->
                                  <div class="container-fluid">
                                        <div class="row">
                                            <div class="col-6">
                                                <div class="d-flex flex-row align-items-center">
                                                    <label for="RequestedByName" class="text-nowrap">Requested By:</label>

                                                    <strong id="RequestedByName" class="ms-2">Jeffvil Duero</strong>
                                                    <input class="d-none" id="RequestedByCode" />

                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="d-flex flex-row align-items-center">
                                                    <label for="RequestedDate" class="text-nowrap">Date:</label>
                                                    <strong id="RequestedDate" class="ms-2">Jeffvil Duero</strong>
                                            <i id="changeOrgLoc" class="d-flex bi bi-three-dots-vertical ms-auto float-end" title="Click to edit Organization/Location">
                                            </i>
                                                </div>
                                            </div>
                                        </div>
                                        <hr />
                                        <div class="row gy-2">
                                            <div class="col-md-6 d-none" id="orgComponent">
                                                
                                                    <label for="OrgCode" class="form-label small d-flex align-items-center">
                                                        <span><small id="ticketOrganizationRequired" class="text-danger">*</small> Organization</span>
                                                    </label>
                                        <select value="1" name="select-organization" id="select-organization" class="form-select form-select-sm" required>
                                                        </select>
                                                    <div class="invalid-feedback">This field is required</div>
                                              
                                            </div>
                                            <div class="col-md-6 d-none" id="locComponent">
                                          
                                                    <label for="LocCode" class="form-label small d-flex align-items-center">
                                                        <span><small id="ticketLocationRequired" class="text-danger">*</small> Location</span>
                                                    </label>
                                        <select value="1" name="select-location" id="select-location" class="form-select form-select-sm" required>
                                                    </select>
                                                    <div class="invalid-feedback">This field is required</div>
                                            
                                            </div>
                                            <div class="col-md-6" id="deptComponent">
                                         
                                                    <label for="DeptCode" class="form-label d-flex flex-row">
                                                        <small id="ticketDepartmentRequired" class="text-danger d-inline-flex">*</small>
                                                        Department
                                                    </label>
                                                    <select value="9" name="select-department" id="select-department" class="form-select form-select-sm" required>
                                                    </select>                                                
                                                    <div class="invalid-feedback">This field is required</div>

                                            </div>
                                            <div class="col-md-6" id="requestTypeComponent">
                                                <div>
                                                    <label for="TaskTypeCode" class="form-label">
                                                        <small class="text-danger">*</small>
                                                        Request Type
                                                    </label>
                                                    <select name="TaskTypeCode" id="TaskTypeCode" class="form-select form-select-sm" required>
                                                    </select>
                                                    <div class="invalid-feedback">This field is required</div>
                                                </div>
                                            </div>

                                            <div class="col-md-12" id="subjectComponent">                                              
                                                    <label for="TicketSubject" class="form-label">
                                                        <small id="ticketSubjectRequired" class="text-danger extra-small">*</small>Subject
                                                    </label>
                                                    <input name="TicketSubject" id="TicketSubject"
                                                           type="text"
                                                           class="form-control form-control-sm"
                                                           placeholder="Subject issue . . "
                                                           required aria-describedby="subjectIssue">
                                                    <div class="invalid-feedback">This field is required</div>                                              
                                            </div>
                                        </div>
                                        <div class="row gy-2 mt-1">
                                            <div class="col-12">
                                                <div>
                                                    <label class="form-label">
                                                        <small class="extra-small text-danger">*</small>
                                                        Detailed description
                                                    </label>
                                                    <span id="summernoteInvalidFeedback" class="text-danger text-small d-none">This field is required</span>
                                                    <div name="TicketDescription" id="TicketDescription"
                                                              placeholder="Explain the issue in detail..." required>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row g-0 mt-0">
                                            <div class="col">                                               
                                                    <div class="card shadow-sm py-0">
                                                      <div class="card-body">                                             
                                                            <!-- Drop Zone -->
                                                        <div class="d-flex justify-content-between align-items-center mt--4">
                                                            <label class="form-label">Add attachments:</label>                                          
                                                        </div>                                                          
                                                            <div id="dropZone" class="drop-zone pt-2" style="max-height: 75px !important;">
                                                                    <i class="bi bi-cloud-upload fs-6"></i>
                                                                <p class="extra-small" style="font-size: 12px !important;">
                                                                    <strong>DRAG & DROP or PASTE Screenshots here or click to browse</strong>
                                                                    </p>
                                                                    <input type="file"
                                                                           id="TicketAttachments"
                                                                           name="TicketAttachments"
                                                                           hidden
                                                                           multiple
                                                                            accept=".png,.jpg,.jpeg,.pdf, .txt, .doc, .docx, .xls, .xlsx, .csv">
                                                                    </div>
                                                                <div class="d-flex justify-content-between align-items-center">
                                                                    <div class="form-text">
                                                                        Tip: Add attachments for faster ticket resolution.
                                                                    </div>
                                                                </div>
                                                            </div>       
                                                            <div class="col-md-12">
                                                                  <!-- Preview List -->
                                                            <div id="previewContainer" name="previewContainer" class="mt-2 px-4"></div>
                                                            </div>
                                                        </div>
                                                </div>
                                        </div>
                                  </div>
                            </div>
                        </div>
                    </form>
            </div>
            <!-- FOOTER -->
            <div class="modal-footer text-end">
                    <a id="cancelBtn" data-bs-dismiss="modal" class="btn btn-outline-secondary">
                        Cancel
                    </a>
                    @* <a onclick="resetEntries(event)" id="cancelBtn" class="btn btn-outline-secondary">
                        Cancel
                    </a> *@
                    <button 
                        type="button"
                        id="submitTicket" 
                        class="btn btn-danger px-2" 
                        aria-label="Fill all the required fields"
                        >
                        Submit Ticket
                    </button>
                </div>
               
           
        </div>
    </div>
</div>
