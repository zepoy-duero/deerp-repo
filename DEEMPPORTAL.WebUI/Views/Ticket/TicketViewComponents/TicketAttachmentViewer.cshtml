<!-- Full Image Modal -->
<div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
    <!-- Use modal-dialog-centered to place it nicely on screen -->
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <!-- p-0 strips the wrapper container borders and background if needed -->
        <div class="modal-content border-0 bg-transparent position-relative">

            <!-- Close button absolute-positioned over the top right corner of the image -->
            <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3 z-3" data-bs-dismiss="modal" aria-label="Close"></button>

            <!-- Body contains the edge-to-edge image -->
            <div class="modal-body p-0 overflow-hidden rounded">
                <img id="attachmentView" src="https://placeholder.com" class="w-100 h-100 object-fit-cover d-block" alt="Full Cover Modal Gallery">
            </div>

        </div>
    </div>
</div>