    <table id="ticketsTable"
           data-toggle="table"
           data-filter-control="true"
           data-filter-control-container="#filtersContainer"
           data-resizable="true"
           data-toolbar="#toolbar"
           data-toolbar-align="left"
           data-show-button-text="true"
           data-buttons-class="mx-2"
           data-show-columns="true"
           data-show-columns-toggle-all="true"
           data-buttons-align="right"
           data-show-fullscreen="true"
           data-buttons="buttons"
           data-height="650"
           data-classes="table table-bordered table-sm pg-primary">
            <thead class="table-light">
                <tr >
                    <th data-checkbox="true"
                    data-halign="center">
                    </th>

                    <th data-field="TicketId"
                        data-halign="center"
                        data-sortable="true"
                        data-formatter="IdFormatter"
                        data-width="50"
                        data-width-unit="px"
                    data-filter-control="input"
                    data-filter-control-placeholder="Ticket Id . . ."
                        class="text-nowrap"
                    >
                        Ticket ID
                    </th>
                    <th data-field="RequestedByName"
                    data-halign="center"
                    data-sortable="true"
                    data-filter-control="select"
                    data-filter-control-placeholder="Requested By"
                    class="text-nowrap p-0 m-0">
                        Requested By
                    </th>

                    <th data-field="TicketSubject"
                    data-halign="center"
                    data-sortable="true"
                    class="text-nowrap p-0 m-0">
                        Subject
                    </th>

                    <th data-field="AssignedToName"
                    data-halign="center"
                    data-sortable="true"
                    data-filter-control="select"
                    data-filter-control-placeholder="Assigned to"
                    class="text-nowrap p-0 m-0">
                        Assigned To
                    </th>
                <th data-field="DeptName"
                    data-halign="center"
                    data-sortable="true"
                    data-filter-control="select"
                    data-filter-control-placeholder="Department"
                    class="text-nowrap">
                    Department
                </th>
                    <th data-field="RequestedDate"
                    data-halign="center"
                    data-sortable="true"
                    data-formatter="dateFormatter"
                    data-filter-control="select"
                    data-filter-control-placeholder="2026"
                    class="text-nowrap p-0 m-0">
                        Date
                    </th>
                <th data-field="TaskTypeName"
                    data-halign="center"
                    data-sortable="true"
                    data-filter-control="select"
                    data-filter-control-placeholder="Type"
                    class="text-nowrap p-0 m-0">
                    Request Type
                </th>
                <th data-field="StatusName"
                    data-halign="center"
                    data-sortable="true"
                    data-formatter="statusFormatter"
                    data-filter-control="select"
                    data-filter-control-placeholder="Status"
                    class="text-nowrap p-0 m-0">
                        Status
                    </th>

                    <th data-field="TicketPriority"
                    data-halign="center"
                    data-sortable="true"
                    data-filter-control="select"
                    data-filter-control-placeholder="Priority"
                    class="text-nowrap p-0 m-0">
                        Priority
                    </th>
                </tr>
            </thead>
        </table>
</div>
<script> 
    window.statusFormatter = (value, row) => {
        if(value != null){
   return `<div class='btn ${statusColor(value)} btn-rounded  btn-sm w-100 text-nowrap'>${value}</div>`
        }
     
    }
    window.dateFormatter = (value, row) => {
        var d = moment(value).format("YYYY")
        return d;
    }
    window.IdFormatter = (value,row) =>{
                return `<div class='text-main fw-bold text-decoration-underline text-nowrap'>${value}</div>`
        }
  
    function statusColor(status) {
        switch (status) {
            case 'Not Scheduled': return 'text-dark';
                break;
           case null: return 'd-none';
                break;
            case 'In Progress': return 'text-danger';
                break;
            case 'Testing': return 'text-primary';
                break;
            case 'Maintenance': return 'text-warning dark';
                break;
            case 'Complete': return 'text-green';
                break;
        }
    }

</script>




