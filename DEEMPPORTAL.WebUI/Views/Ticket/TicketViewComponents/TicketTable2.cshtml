    <table id="table"
           data-toggle="table"
       data-search-selector="#customSearch"
           data-resizable="true"
           data-search="true"
           data-auto-refresh="true"
           data-search-align="left"
           data-toolbar="#toolbar"
           data-toolbar-align="left"
           data-show-button-text="true"
           data-buttons-class="mx-2"
           data-show-columns="true"
           data-show-columns-toggle-all="true"
            data-buttons-align="right"
           data-filter-control="true"
           data-show-fullscreen="true"
           data-buttons="buttons"
           data-height="650"
           data-classes="table table-bordered table-sm pg-primary">
            <thead class="table-light">
                <tr >
                    <th data-checkbox="true"
                    data-halign="center">
                    </th>

                    <th data-field="TicketId"
                        data-halign="center"
                        data-sortable="true"
                        data-formatter="IdFormatter"
                        data-width="50"
                        data-width-unit="px"
                        class="text-nowrap"
                    >
                        Ticket ID
                    </th>
                    <th data-field="RequestedByName"
                    data-halign="center"
                    data-sortable="true"
                    data-filter-control-container="#filterRequestedByName"
                    data-filter-control-placeholder="Requested by"
                    class="text-nowrap p-0 m-0">
                        Requested By
                    </th>

                    <th data-field="TicketSubject"
                    data-halign="center"
                    data-sortable="true"
                    class="text-nowrap p-0 m-0">
                        Subject
                    </th>

                    <th data-field="AssignedToName"
                    data-halign="center"
                    data-sortable="true"
                    
                    class="text-nowrap p-0 m-0">
                        Assigned To
                    </th>
                <th data-field="DeptName"
                    data-halign="center"
                    data-sortable="true"
                    class="text-nowrap">
                    Department
                </th>
                    <th data-field="RequestedDate"
                    data-halign="center"
                    data-sortable="true"
                    class="text-nowrap p-0 m-0">
                        Date
                    </th>
                <th data-field="TaskTypeName"
                    data-halign="center"
                    data-sortable="true"
                    data-filter-control-container="#filterType"
                    class="text-nowrap p-0 m-0">
                    Request Type
                </th>
                <th data-field="StatusName"
                    data-halign="center"
                    data-sortable="true"
                    data-formatter="statusFormatter"
                    data-filter-control-container="#filterStatus"
                    class="text-nowrap p-0 m-0">
                        Status
                    </th>

                    <th data-field="TicketPriority"
                    data-halign="center"
                    data-sortable="true"
                    data-filter-control-container="#filterPriority"
                    class="text-nowrap p-0 m-0">
                        Priority
                    </th>
                </tr>
            </thead>
        </table>
</div>
