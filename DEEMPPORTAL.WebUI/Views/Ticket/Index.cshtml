﻿@{
Layout = "_Layout";
ViewData["Title"] = "Ticket";
}

@{
    await Html.RenderPartialAsync("~/Views/Ticket/_CreateTicketModal.cshtml");
}
@{
    await Html.RenderPartialAsync("~/Views/Ticket/_UpdateTicketModal.cshtml");
}
@{
    await Html.RenderPartialAsync("~/Views/Ticket/UpdateTicketComponents/SendEmailEditorModal.cshtml");
}
<!-- Bootstrap Preview Modal -->
<div class="modal fade" id="filePreviewModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered  modal-fullscreen modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-main">
                <h5 class="text-white" id="preview-filename">File Preview</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                @*<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal">
                </button> *@
            </div>
            <!-- Dynamic viewport container -->
            <div class="modal-body p-0" style="height: 100vh;">
                <div id="file-preview-zone" class="w-100 h-100 d-flex align-items-center justify-content-center">
                    <!-- Dynamic content injected here -->
                </div>
            </div>
            @* <div class="moda-footer">
                <button class="btn btn-primary" data-bs-target="#editTicketModal" data-bs-toggle="modal">Back</button>
            </div> *@
        </div>
    </div>
</div>
<div class="container">   
        <div class="page-inner" id="pageInner" style="height: 100% !important; overflow:auto">
            <div class="flex-column align-items-center">
                        <div class="row d-flex justify-content-between align-items-center">
                            <!-- Title -->
                            <div class="col">
                                <h5 class="page-title mb-3 fs-5 fw-bolder text-main">
                                            Tickets - 
                                            <span class="bg-danger text-white p-2">
                                                <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                                                This Module Under Development</span>
                                </h5>
                            </div>
                            <div class="col text-end ms-auto">
                                <div id="TicketsTotal" class="container">
                                    <div id="" class="btn rounded-pill bg-main text-white">
                                        <div class="spinner-border spinner-border-sm" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                        <span class="blink align-middle ms-2">Loading...</span>
                                    </div>
                                </div>
                            </div>
                        </div>
            <div class="card mt-3">
                <div class="row d-flex justify-content-between align-items-center">                
                    <div class="col">
                       
                            <button disabled id="openCreateTicketModal" class="btn btn-sm ms-4 mt-4 btn-danger text-nowrap text-white" data-bs-toggle="modal" data-bs-target="#createTicketModal">
                                <i class="bi bi-plus"></i> New Ticket

                            </button>
                 
                      
                        @{
                            await Html.RenderPartialAsync("~/Views/Ticket/TicketTableComponents/_TicketTableFilters.cshtml");
                       
                        }
                        @{
                            await Html.RenderPartialAsync("~/Views/Ticket/TicketTableComponents/_TicketTable.cshtml");
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <!--BOOTSTRAP TABLE PLUGIN DEPENDECIES-->
    @* <script src="~/js/ticket/ticket-assignee.js" asp-append-version="true"></script> *@
    <script src="~/js/ticket/ticket-correspondence.js"></script>
    <script src="~/js/ticket/ticket-event-handlers.js" asp-append-version="true"></script>
    @* <script src="~/js/ticket/correspondence-attachment-preview.js"></script> *@
    <script src="~/js/ticket/ticket.js" asp-append-version="true"></script>
    @*  
    <script src="~/js/ticket/ticket-create.js" asp-append-version="true"></script>
    <script src="~/js/ticket/ticket-edit.js" asp-append-version="true"></script>
    *@
}