@using System.Security.Claims

<style>


  /*   .file-icon {
        transition: all 0.3s ease-in-out;
    }

        .file-icon:hover {
            transform: scale(5.05);
            box-shadow: 0 1rem 3rem rgba(0, 46, 90) !important;
            z-index: 10;
        } */
</style>



<div class="modal fade" id="editTicketModal" tabindex="-1" >
    <div class="modal-dialog modal-dialog-centered modal-fullscreen">
        <div class="modal-content">
            @{
                var userRole = User.HasClaim(c => c.Type == ClaimTypes.Role);
            }
            <!-- HEADER -->
            <div class="modal-header bg-main text-white">
                <h6 class="modal-title fw-bold" id="editTicketModalTitle"></h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body  position-relative" data-bs-spy="scroll">
                <div class="container-fluid">
                    <div class="row g-0">
                        <!-- SIDEBAR -->
                        <div class="col-2 ps-0 @(User.HasClaim("HasFullAccess", "true")
                                                                                              || User.HasClaim("DeptManagerAccess", "true")
                                                                                              ? "" : "d-none")">
                            <div class="card position-sticky top-0 w-100">
                                        <div class="card-header bg-accent rounded-top text-white fs-6">
                                            <i class="fa fa-ticket me-2"></i>
                                            Ticket Details
                                        </div>
                             
                                <div id="ticketNav" class="list-group list-group-flush justify-content-center">
                                    <a class="list-group-item list-group-item-action d-flex align-items-center" href="#ticketUserRequest">
                                        <i class="bi bi-person-circle me-2"></i>
                                        User Request
                                    </a>
                                    <a class="list-group-item list-group-item-action d-flex align-items-center" href="#ticketAssignedTo">
                                        <i class="bi bi-person-down me-2"></i>
                                        <span> Assigned To</span>
                                       
                                    </a>
                                    <a class="list-group-item list-group-item-action d-flex align-items-center" href="#ticketApproval">
                                        <i class="bi bi-hand-thumbs-up me-2"></i>
                                        Approvals
                                    </a>
                                    <a id="reviewSection" class="list-group-item list-group-item-action d-flex align-items-center" href="#ticketReview">

                                        <i class="bi bi-list-stars me-2"></i>
                                        Review
                                    </a>
                                </div>
                             </div>
                        </div>
                        <!-- CONTENT -->
                        <div class="@(User.HasClaim("HasFullAccess", "true")
                                    || User.HasClaim("DeptManagerAccess", "true")
                                                                ? "col-10 ps-0" : "col-12 ps-0")">
                            
                                <div class="container-fluid">
                                    <div data-bs-spy="scroll"
                                         data-bs-target="#ticketNav"
                                         data-bs-offset="50"
                                         tabindex="0">
                                         <form id="editTicketForm" class="form">
                                        

                                        @* 2. Render shared components that everyone sees *@
                                        @{
                                            await Html.RenderPartialAsync("~/Views/Ticket/UpdateTicketComponents/UserRequest.cshtml");
                                        }
                                        @{
                                            await Html.RenderPartialAsync("~/Views/Ticket/UpdateTicketComponents/Assignment.cshtml");
                                        }
                                        @* 3. Render management-only components conditionally *@
                                        <div class="@(User.HasClaim("HasFullAccess", "true")
                                                                 || User.HasClaim("DeptManagerAccess", "true")
                                                                 ? "" : "d-none")">
                                            @{
                                            await Html.RenderPartialAsync("~/Views/Ticket/UpdateTicketComponents/Approvals.cshtml");
                                            await Html.RenderPartialAsync("~/Views/Ticket/UpdateTicketComponents/Review.cshtml");
                                            }
                                        </div>
                                        

                                    </form>
                                    </div>
                                </div>
                            
                    </div>
                    </div>

                </div>
          
            </div>
            <!-- FOOTER -->
            <div class="modal-footer position-sticky mb-2 border-0">
                <button type="button" id="btnUpdateTicket" class="btn btn-danger rounded-1 float-start mb-0">                                 
                                    Update
                    <i class="bi bi-cloud-arrow-up ms-2"></i>
                 </button>
            </div> 
        </div>
    </div>
</div>
