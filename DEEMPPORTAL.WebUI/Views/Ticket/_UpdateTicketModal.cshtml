<style>
    .input-group{
        margin-left: 0 !important;
        padding-left: 0 !important;
    }
    /* .modal-content {
        height: 100vh;
        width: auto
    } */

    /* Sidebar */
    .modalNavSidebar {
        position: relative;
        height: 100vh;
        background: #f8f9fa;
        border-right-style: inset;
        border-right-width: 1px;
        border-right-color: black;
        padding: 15px 10px;
    }

    .nav-link {
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 14px;
        transition: 0.2s;
    }

        .nav-link:hover {
            background: #e9ecef;
        }

        .nav-link.active {
            background-color: #002e5a;
            color: #fff !important;
        }

    .list-group-item {
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 14px;
        transition: 0.2s;
    }

        .list-group-item:hover {
            background: #002e5a;
            color: #fff !important;
        }

        .list-group-item.active {
            background-color: #002e5a !important;
            color: #fff !important;
        }
    /* Section Cards */
    .section-card {
       min-height: 500px !important;
       overflow-y: auto;
       padding-bottom: 10px;
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
    }

    .section-title {
        font-weight: 600;
        font-size: 16px;
        margin-bottom: 8px;
        color: #002e5a;
      
        background-color: lightblue;
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
 
    }
    textarea .form-control {
        height: 120px;
    }
    /* .active{
        background-color: #002e5a;
        border-color: #002e5a;
        color: white;
    } */
    /* Attachments */
    .attachment-box {
        border: 2px dashed #ced4da;
        border-radius: 10px;
        padding: 5px;
        text-align: center;
        background: #fff;
        transition: 0.2s;
    }
        .attachment-box:hover {
            border-color: #0d6efd;
            background: #f8fbff;
        }
    .list-group-item.active {
        background-color: white;
        border-color: #002e5a;
        color: white;

    }
    @*DATE CALENDAR*@
   
    .calendar-card {
        width: 52px; /* 260 / 5 */
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
        font-family: 'Segoe UI', sans-serif;
    }

    .calendar-header {
        background: linear-gradient(180deg, #5f8df7, #3d63d2);
        color: white;
        text-align: center;
        padding: 6px 2px;
        font-weight: 600;
        font-size: 10px;
        position: relative;
    }

        /* Rings scaled down */
        .calendar-header::before {
            content: "";
            position: absolute;
            top: -4px;
            left: 4px;
            width: 4px;
            height: 6px;
            background: #e0e0e0;
            border-radius: 3px;
            box-shadow: 10px 0 #e0e0e0, 20px 0 #e0e0e0, 30px 0 #e0e0e0;
        }

    .calendar-body {
        background: #f1f1f1;
        text-align: center;
        padding: 6px 2px;
    }

    .calendar-day {
        font-size: 22px; /* 110 / 5 */
        font-weight: 800;
        color: #1f2a5a;
        line-height: 1;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.2);
    }

  /*   .file-icon {
        transition: all 0.3s ease-in-out;
    }

        .file-icon:hover {
            transform: scale(5.05);
            box-shadow: 0 1rem 3rem rgba(0, 46, 90) !important;
            z-index: 10;
        } */
</style>



<div class="modal fade" id="editTicketModal" tabindex="-1" >
    <div class="modal-dialog modal-dialog-centered modal-fullscreen">
        <div class="modal-content">

            <!-- HEADER -->
            <div class="modal-header bg-main text-white">
                <h6 class="modal-title fw-bold" id="editTicketModalTitle"></h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body  position-relative" data-bs-spy="scroll">
                <div class="container-fluid">
                    <div class="row g-0">
                        <!-- SIDEBAR -->
                        <div class="col-2 ps-0">
                            <div class="card position-sticky top-0 w-100">
                                        <div class="card-header bg-accent rounded-top text-white fs-6">
                                            <i class="fa fa-ticket me-2"></i>
                                            Ticket Details
                                        </div>
                             
                                <div id="ticketNav" class="list-group list-group-flush justify-content-center">
                                    <a class="list-group-item list-group-item-action d-flex align-items-center" href="#ticketUserRequest">
                                        <i class="bi bi-person-circle me-2"></i>
                                        User Request
                                    </a>
                                    <a class="list-group-item list-group-item-action d-flex align-items-center" href="#ticketAssignedTo">
                                        <i class="bi bi-person-down me-2"></i>
                                        <span> Assigned To</span>
                                       
                                    </a>
                                    <a class="list-group-item list-group-item-action d-flex align-items-center" href="#ticketApproval">
                                        <i class="bi bi-hand-thumbs-up me-2"></i>
                                        Approvals
                                    </a>
                                    <a id="reviewSection" class="list-group-item list-group-item-action d-flex align-items-center" href="#ticketReview">

                                        <i class="bi bi-list-stars me-2"></i>
                                        Review
                                    </a>
                                </div>
                             </div>
                        </div>
                        <!-- CONTENT -->
                        <div class="col-10 ps-0">
                            
                                <div class="container-fluid">
                                    <div data-bs-spy="scroll"
                                         data-bs-target="#ticketNav"
                                         data-bs-offset="50"
                                         tabindex="0">
                                         <form id="editTicketForm" class="form">
                                        @{
                                            await Html.RenderPartialAsync("~/Views/Ticket/UpdateTicketComponents/UserRequest.cshtml");
                                            await Html.RenderPartialAsync("~/Views/Ticket/UpdateTicketComponents/Assignment.cshtml");
                                            await Html.RenderPartialAsync("~/Views/Ticket/UpdateTicketComponents/Approvals.cshtml");
                                            await Html.RenderPartialAsync("~/Views/Ticket/UpdateTicketComponents/Review.cshtml");
                                        }
                                       
                                    </form>
                                    </div>
                                </div>
                            
                    </div>
                    </div>

                </div>
          
            </div>
            <!-- FOOTER -->
            <div class="modal-footer position-sticky mb-2 border-0">
                <button type="button" id="btnUpdateTicket" class="btn btn-danger rounded-1 float-start mb-0">                                 
                                    Update
                    <i class="bi bi-cloud-arrow-up ms-2"></i>
                 </button>
            </div> 
        </div>
    </div>
</div>
