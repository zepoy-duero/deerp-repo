<div class="row d-sm-flex">
    <div class="col-sm-12">
        <div class="card p-0">

            <div id="ticketHeader2" class="card-header fw-bold bg-main text-white rounded-top-1">
                <div class="d-flex justify-content-between align-items-center">

                    <div class="d-flex">
                        <div class="small px-2">
                            <span class="btn btn-sm btn-icon btn-round border border-2 text-white"><i class="fas fa-ticket"></i></span>
                            <span id="tblCaption" class="fw-normal mx-2">My Tickets</span>
                        </div>

                    </div>
                    <div class="d-flex">
                        @{
                            await Html.RenderPartialAsync("~/Views/Ticket/_TicketDashBoard.cshtml");
                        }


                    </div>

                </div>


            </div>

            <div id="cardbdy" class="card-body">

                <table id="tblTickets" class="table table-responsive table-sm table-striped table-hover align-middle  no-box-shadow w-100 px-5">
                    <thead class="table-head table-light fw-bold">
                        <tr>
                           
                            <th class="text-muted text-center">Ticket ID</th>
                            <th class="text-muted ">Requested By</th>
                            <th class="text-muted ">Description</th>
                            <th class="text-muted ">Date Submitted</th>
                            <th class="text-muted ">Status</th>


                        </tr>
                    </thead>
                    <tbody id="tblBody" class="table table-body">
                        <tr id="progressBard" class="container d-none">
                            <td class="progress">
                                <div class="progress">
                                    <div id="progressAnimate" 
                                        class="progress-bar" 
                                        role="progressbar" 
                                        style="width: 25%;" 
                                        aria-valuenow="0" 
                                        aria-valuemin="0" 
                                        aria-valuemax="100"></div>
                                </div>
                               
                            </td>
                        </tr>

                        @*                                           @{
                                                await Html.RenderPartialAsync("~/Views/Ticket/_TicketList.cshtml");
                                            } *@

                    </tbody>
                    
                    
                </table>

            </div>


        </div>
    </div>
</div>