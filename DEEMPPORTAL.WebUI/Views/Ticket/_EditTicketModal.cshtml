<!-- Edit Ticket Modal -->
<div class="modal modal-xl fade" id="editTicketModal" tabindex="-1" aria-labelledby="editTicketModalLabel" aria-hidden="true">
    <div class="modal-dialog" style="max-height: 80vh !important;">
        <div class="modal-content">
            <div class="modal-header small fw-bold bg-main-gradient text-white rounded-top">
                <span class="modal-title fs-6 mx-4" id="editTicketModalLabel">Update Ticket</span>
                <button type="button" class="btn-close rounded-1" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
          
                <div class="row">
                    <div class="col-2 position-sticky top-0 h-100 bd" style="border-right: solid 1px grey !important;">
                        <!-- navbar-nav w-100 ensures the menu stretches to the full column width -->
                        <nav id="navbar-example2" class="navbar navbar-light flex-column align-items-stretch w-100 p-0">
                            <div class="navbar-header">
                                <a class="navbar-brand mb-3 text-wrap fw-bold" href="#">MIS#0001</a>
                            </div>
                          
                            <hr />
                            <!-- nav-pills w-100 makes each <a> tag fill the sidebar width -->
                            <ul class="nav nav-pills flex-column w-100">
                              
                                <li class="nav-item nav-simple">
                                    <a class="btn nav-link active" href="#basicInfo">Details</a>
                                </li>
                                <li class="nav-item">
                                    <a class="btn nav-link" href="#ticketStatus">Status</a>
                                </li>
                                <li class="nav-item">
                                    <a class="btn nav-link" href="#ticketReview">Reviews</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                    <div class="col-10">

                        <div data-bs-spy="scroll" 
                        data-bs-target="#ticketInfo" 
                        data-bs-offset="0" 
                        class="scrollspy-example position-relative overflow-auto"
                             style="height: 500px;"
                             tabindex="0">
                            <div class="container">
                                <div class="card">
                                    <div class="card-header d-flex justify-content-between">
                                       
                                        <h4>
                                            Basic Info
                                        </h4>
                                       
                                       
                                    </div>
                                    <div class="card-body">
                                        <div class="row mb-3" id="basicInfo">
                                            <div class="card">
                                                <div class="card-header">
                                                    DE Ticket detatils
                                                </div>
                                                <div class="card-body">
                                                    <div class="d-flex flex-md-row-reverse align-items-end">
                                                        <div class="d-inline-flex">
                                                            <span class="text-muted">
                                                                Ticket ID:
                                                            </span>
                                                            <h6> MIS#1</h6>
                                                        </div>
                                                        <div class="d-inline-flex">
                                                            <span class="text-muted">
                                                                Requested by:
                                                            </span>
                                                            <h6>Jeffvil Duero</h6>
                                                        </div>
                                                        <div class="d-inline-flex">
                                                            <span class="text-muted">
                                                                Date requested:
                                                            </span>
                                                            <h6>Created at: February 26, 2026</h6>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="card-action">
                                                    <button class="btn btn-sm bg-danger"></button>
                                                    <button class="btn btn-sm bg-white"></button>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row mb-3" id="ticketStatus">
                                            <!-- SEARCHABLE EMPLOYEE SELECT -->
                                            <div class="col-md-6  position-relative">
                                                <label class="form-label">Requested By</label>

                                                <!-- Hidden field to store selected EmployeeId -->
                                                <input type="hidden" id="RequestedBy" />

                                                <!-- Search input -->
                                                <input type="text"
                                                       id="employeeSearch"
                                                       class="form-control"
                                                       placeholder="Search employee..."
                                                       autocomplete="off" />

                                                <!-- Dropdown results -->
                                                <div id="employeedropdown"
                                                     class="list-group position-absolute w-100 shadow-sm list-group-horizontal-sm"
                                                     style="z-index:1055; max-height:250px; overflow-y:auto; display:none;">
                                                </div>
                                            </div>

                                            <div class="col-md-6">
                                                <label class="form-label">Department</label>
                                                <select id="DEPT_CODE" class="form-select">
                                                    <option value="">-- Select Department --</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="row mb-3" id="ticketReview">
                                            <div class="col-md-4">
                                                <label class="form-label">Request Type</label>
                                                <select id="RequestType" class="form-select">
                                                    <option value="">-- Select Type --</option>
                                                    <option>Technical</option>
                                                    <option>System</option>
                                                    <option>Network</option>
                                                </select>
                                            </div>

                                            <div class="col-md-4">
                                                <label class="form-label">Priority</label>
                                                <select id="Priority" class="form-select">
                                                    <option>Low</option>
                                                    <option>Medium</option>
                                                    <option>High</option>
                                                    <option>Critical</option>
                                                </select>
                                            </div>

                                            <div class="col-md-4">
                                                <label class="form-label">Status</label>
                                                <select id="Status" class="form-select">
                                                    <option>Open</option>
                                                    <option>In Progress</option>
                                                    <option>Closed</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="container" id="Status">
                                <div class="card">
                                    <div class="card-header">
                                        <h4 id="Status">
                                            Status
                                        </h4>
                                    </div>
                                    <div class="card-body">
                                        <!-- ================= ASSIGNEE ================= -->
                                        <hr />
                                        <h6 class="text-primary mb-3">Assignment</h6>

                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <label class="form-label">Assigned To</label>
                                                <select id="AssignedTo" class="form-select">
                                                    <option value="">-- Select Employee --</option>
                                                </select>
                                            </div>

                                            <div class="col-md-6">
                                                <label class="form-label">Module Name</label>
                                                <input id="ModuleName" class="form-control" />
                                            </div>
                                        </div>

                                        <!-- ================= DURATION ================= -->
                                        <hr />
                                        <h6 class="text-primary mb-3">Duration</h6>

                                        <div class="row mb-4">
                                            <div class="col-md-6">
                                                <label class="form-label">Start Date</label>
                                                <input id="StartDate" type="date" class="form-control" />
                                            </div>

                                            <div class="col-md-6">
                                                <label class="form-label">End Date</label>
                                                <input id="EndDate" type="date" class="form-control" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="container" id="Review">
                                <div class="card">
                                    <div class="card-header">
                                         <h4 id="Review">
                                            Reviews
                                        </h4>
                                    </div>
                                    <div class="card-body">

                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>             
            </div>

        </div>
    </div>
</div>
@section Scripts{
    <script src="~/js/ticket/ticket.js"></script>
}
