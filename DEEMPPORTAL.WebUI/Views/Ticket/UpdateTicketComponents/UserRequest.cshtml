<style>
    .editDropZone {
        border: 2px dashed #6c757d;
        border-radius: 10px;
        padding: 4px;
        text-align: center;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

    .drop-editDropZone.dragover {
            background-color: #e9ecef;
        }
    .file-preview-item {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 10px;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .file-info {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .file-icon {
        width: 40px;
        height: 40px;
        object-fit: cover;
    }
</style>

@{
    await Html.RenderPartialAsync("~/Views/Ticket/UpdateTicketComponents/TicketCorrespondence.cshtml");

}
<!-- Image Preview Modal -->
<div class="modal fade"
     id="imagePreviewModal"
     tabindex="-1"
     aria-labelledby="imagePreviewModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="imagePreviewModalLabel">
                    Image Preview
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>
            <div class="modal-body text-center p-2"
                 style="background-color: #f5f5f5;">

                <img id="previewImage"
                     src=""
                     alt="Image Preview"
                     class="img-fluid"
                     style="
                        max-height: 75vh;
                        object-fit: contain;
                     ">
            </div>
            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>
<div id="ticketUserRequest" class="card section-card">
    <div class="card-header section-title text-main border-2">
       
        <div class="d-flex justify-content-between align-items-center">
            <div class="d-inline-flex">
                User 
            </div>
            <div class="d-inline-flex form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="toggleEditUserRequest">
                <label class="form-check-label" for="toggleEditUserRequest">Edit Mode</label>
            </div>
        </div>       
    </div>
    <div class="card-body">
        <div class="container-fluid">
            <div class="row g-3">
                <div class="col-9"></div>
                <!-- SUBJECT -->
                <div class="col-md-6">
                    <label class="form-label">Ticket Subject</label>                   
                        <input id="ticketSubject"  class="form-control-plaintext text-muted fw-bold " disabled />
                    <hr />
                </div>
                <!-- REQUESTED BY -->
                <div class="col-md-3">
                    <label class="form-label">Requested By</label>
                    <input id="editRequestedByCode" class="form-control d-none" />
                      <input id="editRequestedByName" class="form-control d-none" />
                        <!-- Custom dropdown -->
                        <div class="dropdown rounded-1">
                        <button disabled class="form-control-plaintext text-truncate text-start text-muted" type="button" id="displayRequestedByName" data-bs-toggle="dropdown">
                               

                            </button>
                            <div class="dropdown-menu w-100 p-2" >

                                <!-- Search input -->
                                <input type="text" id="userSearchInput" class="form-control" placeholder="Search...">
                                <!-- Options -->
                            <ul class="list-unstyled mb-0 p-2" id="userList" style="max-height: 200px !important; overflow-y: scroll;">
                                </ul>
                            </div>                     
                    </div>
                    <hr />
                </div>
                <!-- REQUESTED DATE -->
                <div class="col-md-3">
                    <label for="editRequestedDate" class="form-label">
                        Requested Date
                         </label>
                    <input id="displayRequestedDate" class="form-control-plaintext text-muted fw-bold" disabled />
                    <input id="editRequestedDate" name="editRequestedDate" type="date" class="form-control d-none" />
                        <hr />
                    @* <button type="button" class="btn btn-primary position-relative ">
                        Correspondence
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            99+
                            <span class="visually-hidden">unread messages</span>
                        </span>
                    </button> *@
                </div>
                <!-- DESCRIPTION -->
                <div class="col-md-6">
                    <label for="editTicketDescription" class="form-label">Description</label>
                    <textarea id="editTicketDescription" class="form-control text-muted" style="height: 200px !important" placeholder="Detailed description"></textarea>
                </div>
                <!-- ATTACHMENTS -->
                <div class="col-md-6">
                    <div class="d-flex justify-content-between">
                        <div class="d-inline-flex">
                            <label class="form-label">
                                Attachments
                            </label>
                        </div>
                       
                        <div class="d-inline-flex me-2">
                            <button id="editAttachBtn" class="btn btn-sm btn-outline-danger d-none">
                                <i class="bi bi-plus-lg me-1"></i>
                                ADD ATTACHMENT
                            </button>
                        </div>
                                                           
                    </div>                    
                    <hr />                 
                    <!-- Hidden file input for edit modal -->
                    <input id="editTicketAttachments" type="file" class="d-none" multiple accept=".png,.jpeg,.jpg,.gif,.pdf,.xls,.xlsx" />                 
                    <div id="attachmentsPreviewContainer" style="height: 200px !important;overflow-y: scroll !important;">
                        <div class="file-preview-item border rounded p-2 mb-2 bg-light d-inline-block w-100">
                            <div class="file-info d-flex align-items-center placeholder-glow">
                                <!-- Icon Placeholder -->
                                <div class="file-icon rounded me-2 placeholder" style="width: 40px; height: 40px;"></div>
                                <!-- Text Placeholders -->
                                <div class="w-100">
                                    <div class="placeholder col-8 bg-dark mb-1" style="height: 16px; display: block;"></div>
                                    <small class="placeholder col-4 d-block" style="height: 12px;"></small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
