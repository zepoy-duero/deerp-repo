<style>
   
    /* Styling the floating button */
    .floating-btn {
        position: fixed;
        bottom: 20px;
        right: 20px;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050; /* Sits above standard page content */
        cursor: grab;
        user-select: none; /* Prevents text highlighting while dragging */
        transition: box-shadow 0.2s ease;
    }

    .floating-btn:active {
        cursor: grabbing;
    }

    .editDropZone {
        border: 2px dashed #6c757d;
        border-radius: 10px;
        padding: 4px;
        text-align: center;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

    .drop-editDropZone.dragover {
            background-color: #e9ecef;
        }
    .file-preview-item {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 10px;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .file-info {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .file-icon {
        width: 40px;
        height: 40px;
        object-fit: cover;
    }
</style>


<!-- Image Preview Modal -->
<div class="modal fade"
     id="imagePreviewModal"
     tabindex="-1"
     aria-labelledby="imagePreviewModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="imagePreviewModalLabel">
                    Image Preview
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>
            <div class="modal-body text-center p-2"
                 style="background-color: #f5f5f5;">

                <img id="previewImage"
                     src=""
                     alt="Image Preview"
                     class="img-fluid"
                     style="
                        max-height: 75vh;
                        object-fit: contain;
                     ">
            </div>
            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>
<div id="ticketUserRequest" class="card section-card position-relative">
    <div class="card-header  section-title text-main border-2 d-flex justify-content-between align-items-center">
        <div class="d-inline-flex">
                User Request
           
            </div>
         <div class="d-inline-flex form-check form-switch ms-auto">
                <input class="form-check-input" type="checkbox" role="switch" id="toggleEditUserRequest">
                <label class="form-check-label" for="toggleEditUserRequest">Edit Mode</label>
        </div>    
  </div>
    <div class="card-body">
        <div class="container-fluid">
            
            <div class="row g-3">
         
                <!-- SUBJECT -->
                <div class="col-6">
                    <label class="form-label d-none">Ticket Subject</label>  
                    <label class="form-label small fw-bold">

                        Ticket Subject

                        <span class="text-danger">
                            *
                        </span>

                    </label>

                        <input id="ticketSubject"  class="form-control-plaintext text-muted" disabled />
                    <hr />
                </div>
               <div class="col-6">
                   <div class="row row-fluid">
                        <!-- REQUESTED BY -->
                        <div class="col-4">
                            <label class="form-label small fw-bold">Requested By</label>
                            <input id="editRequestedByCode" class="form-control d-none" />
                            <input id="editRequestedByName" class="form-control d-none" />
                            <!-- Custom dropdown -->
                         <div class="dropdown rounded-1">
                                <button disabled class="form-control-plaintext text-truncate text-start text-muted" type="button" id="displayRequestedByName" data-bs-toggle="dropdown">
                                </button>
                                <div class="dropdown-menu w-100 p-2">

                                    <!-- Search input -->
                                    <input type="text" id="userSearchInput" class="form-control" placeholder="Search...">
                                    <!-- Options -->
                                    <ul class="list-unstyled mb-0 p-2" id="userList" style="max-height: 200px !important; overflow-y: scroll;">
                                    </ul>
                                </div>
                            </div>
                            <hr />
                        </div>
                        <!-- REQUESTED DATE -->
                        <div class="col-4">
                            <label class="form-label small fw-bold">
                                Requested Date
                            </label>
                            <input id="displayRequestedDate" class="form-control-plaintext text-muted" disabled />
                            <input id="editRequestedDate" name="editRequestedDate" type="date" class="form-control d-none" />

                            <hr />
                        </div>
                        <div class="col-4 text-end">
                            @{
                                await Html.RenderPartialAsync("~/Views/Ticket/UpdateTicketComponents/TicketCorrespondence.cshtml");
                            }
                        </div>
                   </div>
               </div>
               
                <!-- DESCRIPTION -->
                <div class="col-md-6">
                    <label for="editTicketDescription" class="form-label text-small fw-bold">Description</label>
                    
                    <textarea id="editTicketDescription" class="form-control text-muted" style="height: 200px !important" placeholder="Detailed description"></textarea>
                    @* <label for="" class="form-label small fw-bold">Ticket Correspondence</label> *@
                    
                </div>
                <!-- ATTACHMENTS -->
                <div class="col-md-6">
                    <div class="d-flex justify-content-between align-items-center">
                        
                            <label class="form-label small fw-bold me-2">
                                Attachments
                            </label>
                       
                       
                    
                            <button id="addAttachmentBtn"
                                    type="button"
                                    class="btn btn-sm btn-link">

                                <i class="bi bi-plus text-small me-2"></i>
                                ADD

                            </button>
                      
                                                           
                    </div>                    
                    <hr />                 
                    <!-- Hidden file input for edit modal -->
                    <input id="editTicketAttachments" type="file" class="d-none" multiple accept=".png,.jpeg,.jpg,.gif,.pdf,.xls,.xlsx" />                 
                    <div id="attachmentsPreviewContainer" style="height: 200px !important;overflow-y: scroll !important;">
                        <div class="file-preview-item border rounded p-2 mb-2 bg-light d-inline-block w-100">
                            <div class="file-info d-flex align-items-center placeholder-glow">
                                <!-- Icon Placeholder -->
                                <div class="file-icon rounded me-2 placeholder" style="width: 40px; height: 40px;"></div>
                                <!-- Text Placeholders -->
                                <div class="w-100">
                                    <div class="placeholder col-8 bg-dark mb-1" style="height: 16px; display: block;"></div>
                                    <small class="placeholder col-4 d-block" style="height: 12px;"></small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
              
                
            </div>
        </div>
       
               
        
    </div>
   
   
</div>
