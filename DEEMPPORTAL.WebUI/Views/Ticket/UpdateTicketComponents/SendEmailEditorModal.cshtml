<div class="modal fade bg-grey" id="emailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-main text-white">
                <h6 class="modal-title">Sending an email notification</h6>
                <button id="closeEmailModal()" type="button" class="btn-close btn-close-white" data-bs-target="#emaiModal" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body px-4 py-4">
                <div class="container-fluid">
                    <div class="row g-3">
                        <div class="col-md-1">
                            <span class="mb-3">From: </span><br />
                            <span class="mb-3">To: </span><br />
                            <span class="mb-5">CC: </span><br />
                        </div>

                        <div class="col-md-4">
                            <strong class="text-decoration-underline mb-3">info@dahbashi.com</strong><br />
                            <strong class="text-decoration-underline mb-3">salem@dahbashi.com</strong><br />
                            <span class="text-decoration-underline mb-5">
                                <small id="staticCC" class="text-muted" onclick="selectCC()">Optional</small>
                                <select id="addCC" class="form-select form-select-sm d-none">
                                    <option></option>
                                </select>
                            </span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-1">
                            <span>Subject:</span>
                        </div>
                        <div class="col-md-5">
                            <strong class="text-decoration-underline">
                                Approval Request - MIS#001
                            </strong>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label">Message</label>
                            <textarea class="form-control text-left" rows="4">Please review and approve this request. Click the link below to confirm approval</textarea>

                        </div>

                    </div>

                    <div class="row g-3">
                        <!-- Confirmation Link (IMPORTANT FIELD) -->
                        <div class="col-md-12">
                            <label class="form-label">Approval Confirmation Link</label>
                            <div class="input-group">
                                <input type="text" id="approvalLink" class="form-control"
                                       value="https://employee.dahbashi.com/approve?ticketId=123">
                                <button class="btn btn-outline-secondary" type="button" onclick="copyLink()">
                                    Copy
                                </button>
                            </div>
                        </div>

                    </div>



                    <div class="modal-footer mb-0">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-primary">Send Email</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>