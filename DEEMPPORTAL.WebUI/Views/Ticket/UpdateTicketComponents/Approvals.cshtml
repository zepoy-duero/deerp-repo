<div id="ticketApproval" class="card  section-card">
    <div class="card-header section-title border-2">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                Approvals
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="toggleEditApprovals">
                <label class="form-check-label" for="toggleEditApprovals">Edit Mode</label>
            </div>
        </div>
    </div>
    <div class="card no-box-shadow border-0 mb-4">
       
        <div class="card-body p-4">
            <div class="container-fluid p-0">
                <!-- DEPARTMENT MANAGER SECTION -->
                <div class="row g-4 align-items-start">
                    <div class="col-md-4 col-lg-3">
                        <label id="displayDeptMgnrName" for="approveByManager" class="form-label fw-medium small">
                            Department Manager(Riyaz Ahmed)
                        </label>
                        <div class="input-group mb-3">
                          
                            <select id="approveByManager" class="form-select input-group-select bg-light fw-semibold" disabled>
                                <option selected value="0">⏳ Pending</option>
                                <option value="1">✅ Approved</option>
                            </select>
                        </div>

                        <div class="form-check form-switch mt-3">
                            <input class="form-check-input" type="checkbox" id="isManagementApproval" role="switch">
                            <label class="form-check-label fw-medium text-dark" for="isManagementApproval">
                                Requires Management Approval
                            </label>
                        </div>
                    </div>

                    <div class="col-md-5 col-lg-4">
                        <label class="form-label fw-medium" for="ManagerRemarksField">
                            Remarks
                        </label>
                        <textarea class="form-control fs-6" id="ManagerRemarksField" rows="3" placeholder="Add approval or rejection notes here..."></textarea>
                    </div>
                </div>

                <!-- MANAGEMENT APPROVAL SECTION (HIDDEN BY DEFAULT) -->
                <div id="managementApprovalRequired" class="border-top mt-4 pt-4 d-none">
                    <h6 class="text-uppercase tracking-wider text-muted fw-bold small mb-3">
                        <i class="bi bi-layers-half me-2"></i>Management Approval
                    </h6>

                    <div class="row g-3 mb-3">
                        <!-- Management Selector & Action -->
                        <div class="col-md-4 col-lg-3">
                            <label class="form-label fw-medium  small">Assigned Authority</label>
                            <div class="input-group mb-2 w-100">
                               
                                    <span class="input-group-text bg-white text-muted">
                                        <i class="bi bi-person-badge"></i>
                                    </span>
                                    <select class="form-select">
                                        <option>Saleem Ahmed</option>
                                    </select>
                          
                                <button type="button" class="btn btn-outline-primary ms-1" onclick="openSendEmailModal()">
                                    <i class="bi bi-send-fill me-1"></i> Notify
                                </button>
                            </div>

                            <label class="form-label fw-medium small">Status</label>
                            <div class="input-group mb-2 w-75">
                                <span class="input-group-text bg-white text-muted">
                                    <i class="bi bi-activity"></i>
                                </span>
                                <input type="text" id="approvalStatus" class="form-control text-center" value="Pending Action" readonly />
                                @* <button class="btn btn-outline-primary" type="button" title="Edit Status">
                                    <i class="bi bi-pencil-square"></i>
                                </button> *@
                            </div>

                            <label class="form-label fw-medium small">Date of Approval</label>
                            <div class="input-group w-75">
                                <span class="input-group-text bg-white text-muted">
                                    <i class="bi bi-calendar3"></i>
                                </span>
                                <input type="text" id="dateOfApproval" class="form-control text-center" value="15/09/2026" placeholder="DD/MM/YYYY" />
                            </div>
                        </div>

                        <!-- Status Indicator -->
                        <div class="col-md-5 col-lg-4">
                            <label class="form-label" for="ManagementRemarks">Remarks</label>
                            <textarea class="form-control fs-6" id="ManagementRemarks" rows="3" placeholder="Add approval or rejection notes here..."></textarea>
                        </div>

                      
                    </div>
                  
                </div>

            </div>
        </div>
    </div>

</div>