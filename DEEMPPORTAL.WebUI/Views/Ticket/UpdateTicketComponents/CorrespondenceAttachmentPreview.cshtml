<!-- Bootstrap Preview Modal -->
<div class="modal fade" id="filePreviewModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-main">
                <h5 class="text-white" id="preview-filename">File Preview</h5>
                @* <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button> *@
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal">
                
                </button>
            </div>
            <!-- Dynamic viewport container -->
            <div class="modal-body p-0" style="height: 100vh;">
                <div id="file-preview-zone" class="w-100 h-100 d-flex align-items-center justify-content-center">
                    <!-- Dynamic content injected here -->
                </div>
            </div>
            <div class="moda-footer">
                <button class="btn btn-primary" data-bs-target="#editTicketModal" data-bs-toggle="modal">Back</button>
            </div>
        </div>
    </div>
</div>