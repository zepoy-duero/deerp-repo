<button type="button"
            data-bs-toggle="offcanvas"
            data-bs-target="#ticketCorrespondenceOffcanvas"
            data-bs-tooltip="tooltip" title="Ticket Correspondence"
            id="showTicketCorrBtn"
            class="btn btn-sm btn-primary rounded-top"
            >
   User Correspondence <i class="bi bi-chat-left-text-fill ms-2"></i>
</button>

<div style="width: 650px !important; visibility: hidden;" class="offcanvas offcanvas-end" tabindex="-1" id="ticketCorrespondenceOffcanvas" aria-labelledby="offcanvasExampleLabel" aria-hidden="true">
    <div class="offcanvas-header bg-danger text-light">
        <h5 class="offcanvas-title small fw-bold" id="offcanvasExampleLabel">User Correspondence</h5>
        <button type="button" class="btn-close btn-close-white text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <div class="card-body bg-light bg-opacity-50 p-4">
            <div id="devCorrespondenceAlert d-none">
            </div>
            <div id="devCorrespondenceContainer" style="max-height: 75% !important; overflow-y: scroll">

          
                <!-- Customer Message -->
                <div class="d-flex msg-customer mb-4 align-items-start">
                    <div class="avatar bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; min-width: 40px;">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold small text-dark">John Doe <span class="text-muted font-monospace fw-normal">(Employee)</span></span>
                            <span class="text-muted small">10:15 AM</span>
                        </div>
                        <div class="corr-msg p-3 bg-white border shadow-sm small fw-normal">
                            Hi support team, I've been trying to log into my profile on the employee portal for the past two hours but keep getting a "500 Internal Server Error". I have cleared my browser cache and tried a different browser, but the issue persists. Could you please check this out?
                        </div>
                    </div>
                </div>

                <!-- Internal Note (Optional Component) -->
                <div class="d-flex justify-content-center mb-4 d-none">
                    <div class="bg-warning bg-opacity-25 border border-warning text-warning-dark p-2 rounded small px-4 text-center w-100" style="max-width: 90%;">
                        <i class="bi bi-sticky me-2"></i><strong>Internal Note:</strong> Checked server logs. DB connection pool peak reached. (Visible only to staff)
                    </div>
                </div>

                <!-- Agent Message -->
                <div class="d-flex msg-agent mb-4 align-items-start flex-row-reverse">
                    <div class="avatar bg-main text-white rounded-circle d-flex align-items-center justify-content-center ms-3" style="width: 40px; height: 40px; min-width: 40px;">
                        <i class="bi bi-headset"></i>
                    </div>
                    <div class="flex-grow-1 text-end">
                        <div class="d-flex justify-content-between align-items-center mb-1 flex-row-reverse">
                            <span class="fw-bold small text-dark">Sarah Jenkins <span class="text-primary font-monospace fw-normal">(MIS dev)</span></span>
                            <span class="text-muted small">10:42 AM</span>
                        </div>
                        <div class="p-3 bg-main text-white shadow-sm msg-bubble text-start ms-auto">
                            Hello John, thank you for reaching out. We apologize for the inconvenience. Our technical team is currently investigating a temporary database optimization issue affecting a subset of users. I will update you as soon as this is resolved.
                        </div>
                    </div>
                </div>

                <!-- Customer Message -->
                <div class="d-flex msg-customer mb-0 align-items-start">
                    <div class="avatar bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; min-width: 40px;">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold small text-dark">John Doe <span class="text-muted font-monospace fw-normal">(Employee)</span></span>
                            <span class="text-muted small">10:45 AM</span>
                        </div>
                        <div class="p-3 bg-white border shadow-sm msg-bubble text-secondary">
                            Thanks for the quick response, Sarah! I appreciate the update. I will await your confirmation before trying again.
                        </div>

                        <!-- Attachment Component Inserted Here -->
                        <div class="mt-2 d-flex align-items-center bg-white border rounded p-2 shadow-sm" style="max-width: 300px;">
                            <div class="bg-light text-secondary rounded p-2 me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="bi bi-file-earmark-text-fill fs-5"></i>
                            </div>
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="text-truncate small fw-bold text-dark">error_log_screenshot.png</div>
                                <div class="text-muted extra-small" style="font-size: 0.75rem;">2.4 MB</div>
                            </div>
                            <a href="#" class="btn btn-link btn-sm text-secondary p-1" title="Download">
                                <i class="bi bi-download"></i>
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer p-2 bottom-0 position-sticky">
            <textarea id="devCorrespondenceField" style="height: 150px !important;" type="text" class="form-control form-control-sm mb-1" placeholder="Correspondence here..."></textarea>
            <div class="d-flex justify-content-between align-items-center">
                <div class="me-2"></div>
                <button type="button"
                        id="clearDevCorrespondenceBtn"
                        class="btn btn-danger btn-sm ms-auto me-2">
                    <i class="bi bi-arrow-clockwise me-1"></i>
                    Clear
                </button>
                <button id="postDevCorrespondenceBtn" type="button" class="btn btn-main btn-sm"><i class="bi bi-send me-2"></i>Post</button>
            </div>
            
        </div>
    </div>
</div>
