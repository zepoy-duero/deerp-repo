                        <!-- Attachment Component Inserted Here -->
                        <div class="mt-2 d-flex align-items-center bg-white border rounded p-2 shadow-sm" style="max-width: 300px;">
                            <div class="bg-light text-secondary rounded p-2 me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="bi bi-file-earmark-text-fill fs-5"></i>
                            </div>
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="text-truncate small fw-bold text-dark">error_log_screenshot.png</div>
                                <div class="text-muted extra-small" style="font-size: 0.75rem;">2.4 MB</div>
                            </div>
                            <a href="#" class="btn btn-link btn-sm text-secondary p-1" title="Download">
                                <i class="bi bi-download"></i>
                            </a>
                        </div>

                    </div>
                </div>*@
                </div>
            </div>
            <div class="card-footer p-4 bottom-0 position-sticky bg-white border-top">
                <!-- Main wrapper containing both the textarea and the attached files -->

                <div class="flex-grow-1 mb-2">
                    <!-- Textarea input field -->
                    <textarea id="devCorrespondenceField" style="height: 150px !important;" type="text" class="form-control form-control-sm p-3 w-100 mb-2" placeholder="Correspondence here..."></textarea>
                    <!-- File input element (Hidden) -->
                    <input id="devCorrespondenceAttachmentInput" type="file" class="d-none" multiple accept=".png,.jpeg,.jpg,.gif,.pdf,.xls,.xlsx" />
                    <div class="d-flex flex-column" id="devCorrespondenceAttachmentSelectedFileContainer"></div>

                </div>



                <!-- Action Buttons Row -->
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <!-- Attachment button moved next to actions or bottom-left depending on your design logic -->
                        <button type="button" id="addDevCorrespondenceAttachmentBtn" class="btn btn-sm btn-link p-0 text-decoration-underline text-main fw-bold">
                            <i class="bi bi-paperclip me-1"></i>ADD ATTACHMENT
                        </button>
                    </div>
                    <div class="ms-auto">
                        <button type="button" id="clearDevCorrespondenceBtn" class="btn btn-danger btn-sm me-2">
                            <i class="bi bi-arrow-clockwise me-1"></i> Clear
                        </button>
                        <button id="postDevCorrespondenceBtn" type="button" class="btn btn-main btn-sm">
                            <i class="bi bi-send me-2"></i>Post
                        </button>
                    </div>
                </div>

            </div>
        </div>
        
    </div>
</div>
