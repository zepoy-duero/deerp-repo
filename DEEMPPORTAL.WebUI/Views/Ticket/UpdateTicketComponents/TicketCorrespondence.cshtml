<button type="button"
        data-bs-toggle="offcanvas"
        data-bs-target="#ticketCorrespondenceOffcanvas"
        data-bs-tooltip="tooltip" title="Ticket Correspondence"
        id="showTicketCorrBtn"
        class="btn btn-sm btn-primary rounded-top">
    User Correspondence <i class="bi bi-chat-left-text-fill ms-2"></i>
</button>

<div style="width: 650px !important; visibility: hidden;" class="offcanvas offcanvas-end" tabindex="-1" id="ticketCorrespondenceOffcanvas" aria-labelledby="offcanvasExampleLabel" aria-hidden="true">
    <div class="offcanvas-header bg-danger text-light">
        <h5 class="offcanvas-title small fw-bold" id="offcanvasExampleLabel">User Correspondence</h5>
        <button type="button" class="btn-close btn-close-white text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <div class="card h-100">
            <div class="card-body bg-light bg-opacity-50 p-4">
                <div id="devCorrespondenceAlert" class=" d-none">
                </div>
                <div id="devCorrespondenceContainer" style="max-height: 75% !important; overflow-y: scroll">

                    <div class="d-flex msg-customer mb-4 align-items-start placeholder-glow" aria-hidden="true">
                        <!-- Avatar Skeleton -->
                        <div class="avatar bg-secondary rounded-circle me-3 placeholder" style="width: 40px; height: 40px; min-width: 40px;"></div>

                        <div class="flex-grow-1">
                            <!-- Header Info Skeleton (Name and Time) -->
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="placeholder col-4 col-md-3"></span>
                                <span class="placeholder col-2 col-md-1"></span>
                            </div>

                            <!-- Message Box Skeleton -->
                            <div class="corr-msg p-3 bg-white border shadow-sm small d-flex flex-column gap-2">
                                <span class="placeholder col-11"></span>
                                <span class="placeholder col-12"></span>
                                <span class="placeholder col-8"></span>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex msg-customer mb-4 align-items-start placeholder-glow" aria-hidden="true">
                        <!-- Avatar Skeleton -->
                        <div class="avatar bg-secondary rounded-circle me-3 placeholder" style="width: 40px; height: 40px; min-width: 40px;"></div>

                        <div class="flex-grow-1">
                            <!-- Header Info Skeleton (Name and Time) -->
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="placeholder col-4 col-md-3"></span>
                                <span class="placeholder col-2 col-md-1"></span>
                            </div>

                            <!-- Message Box Skeleton -->
                            <div class="corr-msg p-3 bg-white border shadow-sm small d-flex flex-column gap-2">
                                <span class="placeholder col-11"></span>
                                <span class="placeholder col-12"></span>
                                <span class="placeholder col-8"></span>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex msg-customer mb-4 align-items-start placeholder-glow" aria-hidden="true">
                        <!-- Avatar Skeleton -->
                        <div class="avatar bg-secondary rounded-circle me-3 placeholder" style="width: 40px; height: 40px; min-width: 40px;"></div>

                        <div class="flex-grow-1">
                            <!-- Header Info Skeleton (Name and Time) -->
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="placeholder col-4 col-md-3"></span>
                                <span class="placeholder col-2 col-md-1"></span>
                            </div>

                            <!-- Message Box Skeleton -->
                            <div class="corr-msg p-3 bg-white border shadow-sm small d-flex flex-column gap-2">
                                <span class="placeholder col-11"></span>
                                <span class="placeholder col-12"></span>
                                <span class="placeholder col-8"></span>
                            </div>
                        </div>
                    </div>

