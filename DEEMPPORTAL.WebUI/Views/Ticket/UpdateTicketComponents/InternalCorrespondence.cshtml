
<div class="card shadow-sm h-100 w-100">
    <!-- Header -->
    <div id="correspondenceAlert d-none">
    </div>
    <!-- Correspondence List -->
    <div class="card-body bg-light bg-opacity-50 p-4">

        <div id="internalCorrespondenceContainer" class="list-group list-group-flush mb-2 px-2 "
             style="max-height: 300px !important; overflow-y: scroll">

            <!-- jQuery dynamically renders everything here -->

        </div>

    </div>
    <div class="card-footer p-4 bottom-0 position-sticky bg-white border-top">
        <!-- Main wrapper containing both the textarea and the attached files -->
        <div class="d-flex msg-customer mb-4 align-items-start">
            <div class="flex-grow-1">
                <!-- Textarea input field -->
                <textarea id="internalCorrespondenceField" style="height: 80px !important;" type="text" class="form-control form-control-sm p-3 w-100 mb-2" placeholder="Correspondence here..."></textarea>
                <!-- File input element (Hidden) -->
                <input id="internalCorrespondenceAttachmentInput" type="file" class="d-none" multiple accept=".png,.jpeg,.jpg,.gif,.pdf,.xls,.xlsx" />
                <div class="d-flex flex-row" id="internalCorrespondenceAttachmentSelectedFileContainer"></div>

            </div>
        </div>


        <!-- Action Buttons Row -->
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <!-- Attachment button moved next to actions or bottom-left depending on your design logic -->
                <button type="button" id="addInternalCorrespondenceAttachmentBtn" class="btn btn-sm btn-link p-0 text-decoration-underline text-main fw-bold">
                    <i class="bi bi-paperclip me-1"></i>ADD ATTACHMENT
                </button>
            </div>
            <div class="ms-auto">
                <button type="button" id="clearInternalCorrespondenceBtn" class="btn btn-danger btn-sm me-2">
                    <i class="bi bi-arrow-clockwise me-1"></i> Clear
                </button>
                <button id="postInternalCorrespondenceBtn" type="button" class="btn btn-main btn-sm">
                    <i class="bi bi-send me-2"></i>Post
                </button>
            </div>
        </div>

    </div>

</div>

