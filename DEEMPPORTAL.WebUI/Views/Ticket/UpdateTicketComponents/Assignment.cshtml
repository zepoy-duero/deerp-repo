<div id="ticketAssignedTo" class="card section-card">
    @* <div class="card-header section-title border-2">
        <div class="d-flex justify-content-between align-items-center">
            <div>
               Assignment
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="toggleEditAssignment">
                <label class="form-check-label" for="toggleEditAssignment">Edit Mode</label>
            </div>
            <div class="d-none">
                <button type="button" id="assignmentEditBtn" class="btn btn-sm btn-danger rounded-pill">
                    EDIT
                    <i class="bi bi-pencil-square ms-2"></i>
                </button>
                <span id="editingAssignment" class="d-none">
                    Edit M
                    <button title="Close edit mode" type="button" class="btn-close btn-sm" aria-label="Close"></button>
                </span>
            </div>
        </div>
    </div> *@
    <div class="card-header  section-title text-main border-2 d-flex justify-content-between align-items-center">
        <div class="d-inline-flex">
            Assignment

        </div>
        <div class="d-inline-flex form-check form-switch ms-auto">
            <input class="form-check-input" type="checkbox" role="switch" id="toggleEditAssignment">
            <label class="form-check-label" for="toggleEditAssignment">Edit Mode</label>
        </div>
    </div>
    <div class="card-body">
        <div class="container-fluid">
       
            <div class="row g-0 pe-0 mb-3">
                <!-- ASSIGNED TO -->
                <div class="col-md-3 @(User.HasClaim("HasFullAccess", "true")
                                         || User.HasClaim("DeptManagerAccess", "true")
                                         ? "" : "d-none")">
                    <label class="form-label small fw-bold">Assigned To</label>
                    <input id="assignedToCode" class="form-control d-none" />
                    <input id="assignedToName" class="form-control d-none" />
                    <!-- <input dropdown -->
                    <div class="dropdown rounded-1">
                        <button disabled class="form-control-plaintext text-truncate text-start text-muted" type="button" id="assigneeDropdownSelect" data-bs-toggle="dropdown">
                           Not yet assigned
                        </button>
                        <div class="dropdown-menu w-100 p-2" style="max-height: 200px !important; overflow-y: scroll;">
                            <!-- Search input -->
                            <input type="text" id="assigneeSearchInput" class="form-control mb-2" placeholder="Search...">
                            <!-- Options -->
                            <ul class="list-unstyled mb-0" id="assigneeList">
                            </ul>

                        </div>
                    </div>
                    <hr />
               
                </div>
                
                
                    <!-- MODULE -->
                <div class="col-md-4 px-0 @(User.HasClaim("HasFullAccess", "true")
                                         || User.HasClaim("DeptManagerAccess", "true")
                                         ? "" : "d-none")">
                    <label class="form-label small fw-bold">Module</label>

                        <!-- Hidden real select (for form submission) -->
                        <input id="moduleName" class="form-control d-none" />


                        <!-- Custom dropdown -->
                        <div class="dropdown rounded-1">
                            <button class="form-control-plaintext text-truncate text-start text-muted" type="button" disabled id="moduleDropdownSelect" data-bs-toggle="dropdown">
                                Select here . . .
                            </button>

                            <div class="dropdown-menu w-100 p-2" style="max-height: 200px !important; overflow-y: scroll;">

                                <!-- Search input -->
                                <input type="text" id="moduleSearchInput" class="form-control mb-2" placeholder="Search...">

                                <!-- Options -->
                                <ul class="list-unstyled mb-0" id="moduleList">
                                </ul>

                            </div>
                        </div>
                        <hr />
                    </div>
                
           
                <!-- PRIORITY-->
                <div class="col-md-3 ">
                    <label for="priorityCode" class="form-label small fw-bold">Priority</label>


                    <!-- Hidden real select (for form submission) -->
                    <select id="priorityCode" class="form-control-plaintext text-muted" disabled>
                    </select>
                    <!-- Custom dropdown -->
                    @* <div class="dropdown rounded-1">
                        <button class="form-control-plaintext text-truncate fw-bold text-start text-muted" type="button" disabled id="priorityDropdownSelect" data-bs-toggle="dropdown">
                            Select here . . .
                        </button>

                        <div class="dropdown-menu w-100 p-2" style="max-height: 200px !important; overflow-y: scroll;">

                          
                            <!-- Options -->
                            <ul class="list-unstyled mb-0" id="priorityList">
                            </ul>

                        </div>
                    </div> *@
                    <hr />
                </div>      
            </div>

            
            <div class="row g-0 mb-3 pe-0">
                <!-- TASK TYPE -->
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Type</label>
                    <input id="taskTypeCode" class="form-control d-none" />
                    <input id="taskTypeName" class="form-control d-none" />
                    <!-- Custom dropdown -->
                    <div class="dropdown rounded-1">
                        <button disabled class="form-control-plaintext text-truncate text-start text-muted" type="button" id="typeDropdownSelect" data-bs-toggle="dropdown">
                            
                        </button>

                        <div class="dropdown-menu w-100 p-2" style="max-height: 200px !important; overflow-y: scroll;">

                            <!-- Search input -->
                            <input type="text" id="typeSearchInput" class="form-control mb-2" placeholder="Search...">

                            <!-- Options -->
                            <ul class="list-unstyled mb-0" id="typeList">
                            </ul>

                        </div>
                    </div>
                    <hr />

                </div>
                <!-- DURATION -->
                <div class="col-md-3 px-0  
                    @(User.HasClaim("HasFullAccess", "true") 
                    || User.HasClaim("DeptManagerAccess", "true") 
                    ? "" : "d-none")">



                    <label class="form-label small fw-bold">Duration</label>
                        <div class="d-flex gap-2">
                            <input id="ticketDuration" type="number" class="form-control text-muted w-25" disabled>
                            <select id="ticketDurationUnit" class="form-control-plaintext text-muted w-75" disabled>
                            </select>
                        </div>
                        <hr/>
                    </div>
                    <!--START DATE-->
                <div class="col-md-2 pe-0 @(User.HasClaim("HasFullAccess", "true")
                                         || User.HasClaim("DeptManagerAccess", "true")
                                         ? "" : "d-none")">
                    <label class="form-label small fw-bold">Start</label>
                        <input id="startDate" type="date" class="form-control-plaintext text-muted" disabled />
                        <hr />
                    </div>
                    <!-- END DATE -->
                <div class="col-md-2 @(User.HasClaim("HasFullAccess", "true")
                                         || User.HasClaim("DeptManagerAccess", "true")
                                         ? "" : "d-none")">
                    <label class="form-label small fw-bold">End</label>
                        <input id="finishDate" type="date" class="form-control-plaintext text-muted" disabled />
                        <hr />
                    </div>
                
            </div>

            <!-- STATUS -->
            <div class="row">
                @* <div class="col-md-3">
                    <label class="form-label">Status</label>
                    <select id="selectStatus" class="form-select"></select>
                </div> *@
                <div class="col-md-3">
                    <label for="statusCode" class="form-label small fw-bold">Status</label>
                   
                    <select id="statusCode" class="form-select text-muted d-none">
                    </select>
                    <br />
                    @* <input type="button" id="statusName" class="" /> *@
                    <span id="statusName" class="badge rounded-pill fs-6 px-3 py-2">New</span>
                </div>
            </div>
        </div>
    </div>
</div>
