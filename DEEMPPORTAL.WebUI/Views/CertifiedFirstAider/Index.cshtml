@{
    Layout = "_Layout";
    ViewData["title"] = "Certified First Aider";
}
<style>
    @@keyframes blinker {
        50% {
            opacity: 0;
        }
    }

    .blink {
        align-content: center;
        align-items: center;
        animation: blinker 1s linear infinite;
    }

    .image-fade-edges {
        /* Use a radial gradient mask to fade all 4 outer borders */
        -webkit-mask-image: radial-gradient(circle, black 100%, transparent 100%);
        mask-image: radial-gradient(circle, black 60%, transparent 100%);
    }

    #empCard {
      
        transition: all 0.3s ease-in-out;
    }

        #empCard:hover {
            transform: scale(1.05);
            box-shadow: 0 1rem 3rem rgba(0, 46, 90) !important;
            z-index: 10;
        }

    .emp-name {
        font-size: medium
    }

    .emp-position {
        font-size: small;
        font-style: italic
    }

    .emp-contacts {
        font-size: small
    }

</style>
@{
    await Html.RenderPartialAsync("~/Views/CertifiedFirstAider/Components/ConfirmRemoveFirstAiderModal.cshtml");
}
<div class="container">

    <div class="page-inner">
        <div class="flex-column">
            <div class="row d-flex justify-content-between align-items-center mb-3">
                <!-- Title -->
                <div class="col">
                    <h5 class="page-title mb-3 fs-5 fw-bolder text-main">
                        Certified First Aider
                    </h5>
                </div>
                <div class="col text-end ms-auto">
                    <div id="EmployeeDirectoryTotal" class="container">
                        <div id="" class="btn rounded-pill bg-main text-white">

                            <div class="spinner-border spinner-border-sm" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>

                            <span class="blink align-middle ms-2">Loading...</span>
                        </div>
                    </div>
                </div>

            </div>
            <hr class="" />
            <!-- Filters -->
            <div class="card mt-2 mb-2 p-4">

                <div class="d-flex flex-row row-cols-12">
                    <div class="col">
                        <div class="row row-cols-3 g-0 mb-4 d-flex justify-content-between align-items-center">
                            <div class="col-auto bg-light">

                                <i class="bi bi-filter fs-4"></i>

                            </div>
                            <div class="col-auto text-start">

                                    <select id="select-organization" class="form-select select-organization text-truncate">
                                        <option>Dahbashi Group of Companies</option>
                                    </select>
                                    @* <div class="placeholder-glow">
                                    <select disabled class="form-select text-truncate placeholder">
                                        <option>Select Organization</option>
                                    </select>
                                    </div> *@
                               
                                
                            </div>
                            <div class="col-auto me-auto">
                                @if (User.IsInRole("Manager - HR") || User.IsInRole("Super Admin"))
                                {
                                    await Html.RenderPartialAsync("~/Views/CertifiedFirstAider/Components/AddFirstAiderModal.cshtml");
                                }


                            </div>
                            <div class="col-6">
                                <div class="row d-flex justify-content-between align-items-center">
                                    <img src="~/files/imgBanner.png" style="max-height: 100px !important" class="card-img rounded  image-fade-edges" alt="...">
                                </div>
                            </div>
                            @* <div class="col-auto">
                              
                                    @{
                                        await Html.RenderPartialAsync("~/Views/CertifiedFirstAider/Components/ImageBanner.cshtml");
                                    }
                             
                               
                            </div> *@
                           
                        </div>
                    </div>
                   


                </div>
                <div class="card-body px-4">

                    <!-- Employee Cards Container -->
                    <div class="row g-2" id="employeeContainer" style="overflow-y: scroll;max-height: 650px">
                        <div class="d-flex justify-content-center align-items-center">

                            <div class="spinner-grow top-50" style="width: 3rem; height: 3rem;" role="status">
                            </div>
                            <span class="visually-hidden">Updating...</span>
                        </div>

                    </div>
                </div>
            </div>

        </div>


    </div>
</div>
@section Scripts {

    <script src="~/js/support/certified-firstaider.js" asp-append-version="true"></script>

}
