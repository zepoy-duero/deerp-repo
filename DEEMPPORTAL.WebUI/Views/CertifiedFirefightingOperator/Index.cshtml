@{
    Layout = "_Layout";
    ViewData["title"] = "Certified Firefighting Operator";
}
<style>
    @@keyframes blinker {
        50% {
            opacity: 0;
        }
    }

    .blink {
        align-content: center;
        align-items: center;
        animation: blinker 1s linear infinite;
    }
</style>
<div class="container">
    <div class="page-inner">
        <div class="flex-column">
            <div class="row d-flex justify-content-between align-items-center">
                <!-- Title -->
                <div class="col">
                    <h5 class="page-title mb-3 fs-5 fw-bolder text-main">
                        Certified Firefighting Operator
                    </h5>
                </div>
                <div class="col text-end ms-auto">
                    <div id="EmployeeDirectoryTotal" class="container">
                        <div id="" class="btn rounded-pill bg-main text-white">

                            <div class="spinner-border spinner-border-sm" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>

                            <span class="blink align-middle ms-2">Loading...</span>
                        </div>
                    </div>
                </div>

            </div>
            <!-- Filters -->
            <div class="row g-4 mb-4">
                <div class="col-auto">
                    <label for="select-organization" class="form-label fw-semibold">Choose Organization</label>
                    <select id="select-organization" class="form-select select-organization">
                    </select>
                </div>
                <div class="col d-none">
                    <label for="select-location" class="form-label fw-semibold">Choose Location</label>
                    <select id="select-location" class="form-select select-location">
                    </select>
                </div>
                <div class="col d-none">
                    <label for="select-status" class="form-label fw-semibold">Choose Status</label>
                    <select id="select-status" class="form-select select-status">
                        <option selected>All</option>
                        <option>On Payroll</option>
                        <option>Consultant</option>
                    </select>
                </div>
                <div class="col d-none">
                    <label for="select-department" class="form-label fw-semibold">Choose Department</label>
                    <select id="select-department" class="form-select select-department">
                    </select>
                </div>
                <div class="col d-none">
                    <label for="search-input" class="form-label fw-semibold">Search . . .</label>
                    <input id="search-input" class="form-control" placeholder="Type to search">

                </div>
            </div>
        </div>

        <!-- Employee Cards Container -->
        <div class="row g-2" id="employeeContainer">
            <div class="d-flex justify-content-center align-items-center">
                <div class="spinner-grow top-50" style="width: 3rem; height: 3rem;" role="status"></div>
            </div>

        </div>
    </div>
</div>
@section Scripts {

    <script src="~/js/support/employee-directory.js" asp-append-version="true"></script>
}
<style>
    .emp-name {
        font-size: medium
    }

    .emp-position {
        font-size: small;
        font-style: italic
    }

    .emp-contacts {
        font-size: small
    }
</style>