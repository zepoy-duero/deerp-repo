@{
	ViewData["title"] = "Ask AI Assitant";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
    <style>
        /* Smooth fade-in animation for a premium feel */
        @@keyframes fadeIn {
            from { opacity: 0; transform: scale(0.95); }
            to { opacity: 1; transform: scale(1); }
        }
        .animate-fade-in {
            animation: fadeIn 1.2s ease-out forwards;
        }
        /* Soft text shadow to make it pop */
        .text-glow {
            text-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
    </style>
<div class="container">
	<div class="page-inner">
		<div class="flex-column">
			<h5 class="page-title mb-3 fs-5 fw-bolder text-main">
				Under Development
			</h5>
			<div class="page-category">
				<div class="bg-main bg-gradient d-flex align-items-center justify-content-center min-vh-100 m-0">
					<!-- Center Heading -->
					 <h1 class="display-1 fw-extrabold text-center text-transparent bg-clip-text bg-gradient bg-info-subtle text-white text-glow animate-fade-in lh-base pb-3">
                    Coming Soon
                </h1>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts
{}
	