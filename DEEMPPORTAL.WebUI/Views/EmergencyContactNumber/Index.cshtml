@{
    Layout = "_Layout";
    ViewData["title"] = "Emergency Contact Numbers";
}
<style>
    @@keyframes blinker {
        50% {
            opacity: 0;
        }
    }

    .blink {
        align-content: center;
        align-items: center;
        animation: blinker 1s linear infinite;
    }
</style>
<div class="container">
    <div class="page-inner">
        <div class="flex-column">
            <div class="row d-flex justify-content-between align-items-center">
                <!-- Title -->
                <div class="col">
                    <h5 class="page-title mb-3 fs-5 fw-bolder text-main">
                        Emergency Contact Numbers
                    </h5>
                </div>
                <hr />

            </div>
       

           
        </div>

        <!-- Employee Cards Container -->
        <div class="row g-2" id="emergencyContactNumberContainer">
           <div class="col">
               <table class="table striped table-bordered">
                     <thead class="table-primary">
                          <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Designation</th>
                            <th scope="col">Telephone Number</th>
                            <th scope="col">Mobile Number</th>
                          </tr>
                     </thead>
                     <tbody id="emergencyContactNumberTableBody">
                          <!-- Employee cards will be dynamically inserted here -->
                    </tbody>    
               </table>
           </div>

        </div>
    </div>
</div>
@section Scripts {

   <script>

       $(async function(){
                      const emergencyContactNumbers = [
          {
            "slNo": 1,
            "name": "Security",
            "designation": "-",
            "telephoneNumber": "+971 4 4592550",
            "mobileNumber": "+971 50 554 6369"
          },
          {
            "slNo": 2,
            "name": "Bhimkanta Adhikari",
            "designation": "Facility Maintenance Technician",
            "telephoneNumber": "+971 4 4592533",
            "mobileNumber": "+971 55 955 8620"
          },
          {
            "slNo": 3,
            "name": "Anirudh K A",
            "designation": "Product Support Engineer – EQT",
            "telephoneNumber": "+971 4 4592536",
            "mobileNumber": "+971 56 4616558"
          },
          {
            "slNo": 4,
            "name": "Rahul Murali",
            "designation": "Assistant Manager - EQT",
            "telephoneNumber": "+971 4 4592531",
            "mobileNumber": "+971 55 681 4854"
          },
          {
            "slNo": 5,
            "name": "Brian R Mascarenhas",
            "designation": "Supervisor – Human Resources",
            "telephoneNumber": "+971 4 4592521",
            "mobileNumber": "+971 56 653 3550"
          }
        ];

         const tableBody = document.getElementById('emergencyContactNumberTableBody');
         emergencyContactNumbers.forEach(contact => {
             const row = document.createElement('tr');
             row.innerHTML = `
                  <td class="text-left">${contact.name}</td>
                  <td class="text-left">${contact.designation}</td>
                  <td class="text-left">${contact.telephoneNumber}</td>
                  <td class="text-left">${contact.mobileNumber}</td>
             `;
             tableBody.appendChild(row);
         });
       })
           
   </script>
}
