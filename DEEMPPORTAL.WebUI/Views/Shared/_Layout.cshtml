<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@ViewData["Title"] | Enterprise Resource Planning</title>

    <link rel="icon" type="image/x-icon" href="~/favicon.ico">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">

    <!-- Material Symbols -->
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

    <!-- Bootstrap 5.1.0 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <!-- Loading Template-->

   
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/placeholder-loading@0.6.0/dist/css/placeholder-loading.min.css">
    <!-- Bootstrap Table -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/jquery-resizable-columns@0.2.3/dist/jquery.resizableColumns.min.css">
    <link rel="stylesheet"
          href="~/lib/bootstrap-table/bootstrap-table.min.css" />

    <!-- Bootstrap Table Resizable -->

    <!-- Toastr -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />

    <!-- Tom Select -->
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.4.1/dist/css/tom-select.css"
          rel="stylesheet" />

    <!-- Date Range Picker -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    @* <link rel="stylesheet"
          href="~/lib/fontawesome/css/all.min.css" /> *@

    <!-- Summernote -->
    <link href="~/lib/summernote-0.9.0-dist/summernote-bs5.min.css"
          rel="stylesheet" />

    <!-- Custom CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        ul.nav.nav-collapse {
            padding-top: 0;
            padding-bottom: 0;
        }
    </style>
</head>

<body>

    <div class="wrapper">

        <!-- Sidebar -->
        <div class="sidebar" data-background-color="blue">

            <div class="sidebar-logo">

                <!-- Logo Header -->
                <div class="logo-header bg-main">

                    <a href="#" class="logo">
                        <img src="~/img/DE-LOGO.png"
                             alt="navbar brand"
                             class="navbar-brand"
                             height="40" />
                    </a>

                    <div class="nav-toggle">
                        <button class="btn btn-toggle toggle-sidebar">
                            <i class="bi bi-list"></i>
                        </button>

                        <button class="btn btn-toggle sidenav-toggler">
                            <i class="bi bi-layout-sidebar-inset"></i>
                        </button>
                    </div>

                    <button class="topbar-toggler more">
                        <i class="bi bi-three-dots-vertical"></i>
                    </button>

                </div>
                <!-- End Logo Header -->

            </div>

            <div class="sidebar-wrapper scrollbar scrollbar-inner">

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="sidebar-content"></div>
                }

            </div>

        </div>
        <!-- End Sidebar -->
        <!-- Main Panel -->
        <div class="main-panel">

            <!-- Header -->
            <div class="main-header">

                <div class="main-header-logo">

                    <div class="logo-header" data-background-color="blue">

                        <a href="#" class="logo">
                            <img src="#"
                                 alt="navbar brand"
                                 class="navbar-brand"
                                 height="20" />
                        </a>

                        <div class="nav-toggle">

                            <button class="btn btn-toggle toggle-sidebar">
                                <i class="bi bi-list"></i>
                            </button>

                            <button class="btn btn-toggle sidenav-toggler">
                                <i class="bi bi-layout-sidebar-inset"></i>
                            </button>

                        </div>

                        <button class="topbar-toggler more">
                            <i class="bi bi-three-dots-vertical"></i>
                        </button>

                    </div>

                </div>

                <!-- Navbar -->
                <nav class="navbar navbar-header navbar-header-transparent navbar-expand-lg border-bottom bg-main">

                    <div class="container-fluid">

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            var un = User?.Identity?.Name?.ToUpper();
                            var pn = User?.Claims.FirstOrDefault(c => c.Type == "PERSONNEL_NAME")?.Value;
                            var fn = pn?.Split(" ")[0];

                            <ul class="navbar-nav topbar-nav ms-md-auto align-items-center">

                                @if (un == "DEERPSA")
                                {
                                    <li class="nav-item topbar-icon dropdown hidden-caret mx-0">

                                        <a class="nav-link dropdown-toggle btn-icon"
                                           data-bs-toggle="dropdown"
                                           href="#"
                                           aria-expanded="false">

                                            <i class="bi bi-gear-fill"></i>

                                        </a>

                                        <div class="dropdown-menu quick-actions quick-actions-danger">

                                            <div class="quick-actions-header bg-accent">
                                                <span class="title mb-1">Manage</span>
                                            </div>

                                            <div class="quick-actions-scroll scrollbar-outer">

                                                <div class="quick-actions-items">

                                                    <div class="row m-0">

                                                        <a class="col-6 col-md-4 p-0"
                                                           href="~/page?name=Menu">

                                                            <div class="quick-actions-item">

                                                                <div class="avatar-item bg-secondary2 rounded-circle">
                                                                    <i class="bi bi-list"></i>
                                                                </div>

                                                                <span class="text-main text-small mt-2">
                                                                    Menus
                                                                </span>

                                                            </div>

                                                        </a>

                                                        <a class="col-6 col-md-4 p-0"
                                                           href="~/page?name=Role">

                                                            <div class="quick-actions-item">

                                                                <div class="avatar-item bg-secondary2 rounded-circle">
                                                                    <i class="bi bi-tags-fill"></i>
                                                                </div>

                                                                <span class="text-main text-small mt-2">
                                                                    Roles
                                                                </span>

                                                            </div>

                                                        </a>

                                                        <a class="col-6 col-md-4 p-0"
                                                           href="~/page?name=User">

                                                            <div class="quick-actions-item">

                                                                <div class="avatar-item bg-secondary2 rounded-circle">
                                                                    <i class="bi bi-person-fill"></i>
                                                                </div>

                                                                <span class="text-main text-small mt-2">
                                                                    Users
                                                                </span>

                                                            </div>

                                                        </a>

                                                    </div>

                                                </div>

                                            </div>

                                        </div>

                                    </li>
                                }

                                <!-- User -->
                                <li class="nav-item topbar-user dropdown hidden-caret">

                                    <a class="dropdown-toggle profile-pic"
                                       data-bs-toggle="dropdown"
                                       href="#"
                                       aria-expanded="false">

                                        <div class="avatar-sm">

                                            <img src="https://ui-avatars.com/api/?name=@pn"
                                                 alt="Profile picture"
                                                 class="avatar-img rounded" />

                                        </div>

                                        <span class="profile-username text-white">
                                            <span class="op-7">Hi,</span>
                                            <span class="fw-bold">@fn</span>
                                        </span>

                                    </a>

                                    <ul class="dropdown-menu dropdown-user">

                                        <li>

                                            <div class="user-box">

                                                <div class="avatar-lg">

                                                    <img src="https://ui-avatars.com/api/?name=@pn"
                                                         alt="image profile"
                                                         class="avatar-img rounded" />

                                                </div>

                                                <div class="u-text">
                                                    <h4>@fn</h4>
                                                </div>

                                            </div>

                                        </li>

                                        <li>

                                            <div class="dropdown-divider"></div>

                                            <a class="dropdown-item"
                                               href="/account/change-password">

                                                Change Password

                                            </a>

                                            <div class="dropdown-divider"></div>

                                            <a class="dropdown-item"
                                               href="/auth/logout">

                                                Logout

                                            </a>

                                        </li>

                                    </ul>

                                </li>

                            </ul>
                        }

                    </div>

                </nav>
                <!-- End Navbar -->

            </div>

            <!-- Body -->
            @if (User?.Identity != null && User.Identity.IsAuthenticated)
            {
                @RenderBody()
            }
            else
            {
                <div class="container py-5">
                    <h1>Session Expired. Please re-login.</h1>
                </div>
            }

            <!-- Footer -->
            <footer class="footer py-1">

                <div class="d-flex flex-wrap justify-content-between align-items-center">

                    <div class="container d-flex justify-content-center">

                        <p class="py-3 mb-0 small text-center">
                            © @DateTime.Now.Year Dahbashi Engineering.
                            All rights reserved.
                            <br />
                            v2.1.0.2
                        </p>

                    </div>

                </div>

            </footer>

        </div>

    </div>

    <!-- jQuery -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    
    <!-- Bootstrap -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
   
    <!-- Bootstrap Table -->
    @* <script src="https://cdn.jsdelivr.net/npm/bootstrap-table@1.27.3/dist/bootstrap-table.min.js"></script> *@
 
    <!-- Bootstrap Table Extensions -->
   

   <!--RESIZABLE COLUMNS-->
    <script src="https://cdn.jsdelivr.net/npm/jquery-resizable-columns@0.2.3/dist/jquery.resizableColumns.min.js"></script>
    <script src="~/lib/bootstrap-table/bootstrap-table.min.js"></script>
    <script src="~/lib/bootstrap-table/extensions/resizable/bootstrap-table-resizable.min.js"></script>
    <!--TABLE FILTER CONROL-->
    <script src="~/lib/bootstrap-table/extensions/filter-control/bootstrap-table-filter-control.min.js"></script>
    <script src="~/lib/bootstrap-table/extensions/auto-refresh/bootstrap-table-auto-refresh.min.js"></script>
    <!-- Toastr -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>

    <!-- Tom Select -->
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.4.1/dist/js/tom-select.complete.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <!-- Scrollbar -->
    <script src="~/lib/jquery-scrollbar/jquery.scrollbar.min.js"></script>

    <!-- Chart JS -->
    <script src="~/lib/chart.js/chart.min.js"
            asp-append-version="true"></script>

    <!-- Moment -->
    <script src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>

    <!-- Date Range Picker -->
    <script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>

    <!-- Summernote -->
    <script src="~/lib/summernote-0.9.0-dist/summernote-bs5.min.js"></script>

    <!-- Custom Scripts -->
    <script src="~/js/appstart.js"
            asp-append-version="true"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <!-- Page Scripts -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>