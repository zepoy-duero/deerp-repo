@{
	Layout = "_Layout";
	ViewData["Title"] = "Hr Support";
}
<style>
	.hr-support-card {
		transition: all 0.3s ease-in-out;
	}

	.hr-support-card:hover {
			transform: scale(1.05);
			box-shadow: 0 1rem 3rem rgba(0, 46, 90) !important;
			z-index: 10;
		}
</style>
<!-- Main content here -->
<div class="container">
	<div class="page-inner">
		<div class="flex-column">
			<h5 class="page-title page-title mb-3 fs-5 fw-bolder text-main">Human Resource Support</h5>
		</div>
		<div class="page-category">
			<div class="card card-profile">
				<div class="card-header bg-main-gradient rounded-top-2">
					<div class="row g-4">
						<div class="col-sm-12 col-md-6 col-lg-4 my-5">
							<div class="card border-0 hr-support-card">
								<div class="card-body text-center py-5">
									<i class="bi bi-envelope mb-3 text-primary" style="font-size: 5rem;"></i>
									<h4 class="fs-4 fw-bolder text-main mb-5">Email Us</h4>
									<p class="mb-1 text-main">info@dahbashi.com</p>
									<p class="mb-1  text-main">manusharma@dahbashi.com</p>
									<p class="mb-1  text-main">brian@dahbashi.com</p>
									<p class="mb-1  text-main">antonette@dahbashi.com</p>
								</div>
							</div>
						</div>
						<div class="col-sm-12 col-md-6 col-lg-4 my-5">
							<div class="card border-0 hr-support-card">
								<div class="card-body text-center py-5">
									<i class="bi bi-telephone-fill mb-3 text-danger" aria-hidden="true" style="font-size: 5rem;"></i>
									<h4 class="fs-4 fw-bolder text-main mb-5">Call Us</h4>
									<div class="">
										<p class="mb-1 text-main ">Reception: +971-4-4592500</p>
									</div>
									<div class="">
										<p class="mb-1 text-main ">Mr. Manu Sharma: +971-4-4592549</p>
									</div>
									<div class="">
										<p class="mb-1 text-main ">Mr. Brian: +971-4-4592521</p>
									</div>
									<p class="mb-1">&nbsp;</p>
								</div>
							</div>
						</div>
						<div class="col-sm-12 col-md-6 col-lg-4 my-5">
							<div class="card border-0 hr-support-card">
								<div class="card-body text-center py-5">
									<i class="bi bi-globe-americas mb-3 text-info" aria-hidden="true" style="font-size: 5rem;"></i>
									<h4 class="fs-4 fw-bolder text-main mb-5">Our Website</h4>
									<a href="https://www.dahbashi.com"><p class="mb-1">www.dahbashi.com</p></a>
									<p class="mb-1">&nbsp;</p>
									<p class="mb-1">&nbsp;</p>
									<p class="mb-1">&nbsp;</p>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="card-body" style="height:430px"></div>
			</div>
		</div>
	</div>
</div>
<!-- End of main content -->
@section Scripts {
	<script src="~/js/support/hr-support.js" asp-append-version="true"></script>
}